@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.IdentityModel.JsonWebTokens
@using NaraChat.Application.Services.Auth
@using NaraChat.Application.Services.ChatServices.Channels
@using NaraChat.Application.Services.LocalStorage
@using NaraChat.Contract.Models.BaseResponse
@using NaraChat.Contract.Models.Chat.Channels
@using NaraChatFrontEnd.Models.BaseModels
@using System.Security.Claims
@using NaraChatFrontEnd.Pages.ChatPages
@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents

@inherits LayoutComponentBase
@inject IDialogService DialogService
@inject NavigationManager nm
@inject AuthenticationStateProvider stateprovider
@inject IAuthService auth
@inject IUserChatService userservice
@inject IJSRuntime js
@inject ILocalStorageService localStorage
@inject VersionCheckService VersionChecker
@inject NavigationManager Nav
@inject IChannelService channelservice
@inject ISnackbar snackbar
@implements IDisposable


<MudRTLProvider RightToLeft="true">
    <CascadingValue Name="Theme" Value="ThemeChanging">
        <MudThemeProvider IsDarkMode="@IsDarkMode" Theme="_myTheme" />
        <MudPopoverProvider  />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar >

                <AuthorizeView>
                    <Authorized>
                        <div>


                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar @onclick="SettingsShow" Size="Size.Medium" Class="elevated-avatar">
                                    @if (!string.IsNullOrEmpty(myAvatar))
                                    {
                                        <MudImage Src="@($"data:image/png;base64,{myAvatar}")"
                                        Class="rounded-circle avatar-img" />
                                    }
                                    else
                                    {
                                        <MudImage Src="lib/assets/Images/avatar.jpg"
                                        Class="rounded-circle avatar-img" />
                                    }
                                </MudAvatar>

                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                    <b>@CurrentUser?.Name  </b>  
                                </MudText>
                                @if (newVersionAvailable)
                                {
                                    <div class="update-alert">
                                        نسخه جدیدی از برنامه در دسترس است.
                                        <button class="btn btn-primary" @onclick="UpdateApp">بارگذاری نسخه جدید</button>
                                    </div>
                                }

                            </MudStack>


                        </div>

                    </Authorized>
                    <NotAuthorized>
                        <h1>نارا مسنجر</h1>
                    </NotAuthorized>
                    <Authorizing>

                    </Authorizing>
                </AuthorizeView>


                <MudSpacer />
                <MudIconButton @onclick="Logout" title="خروج"  Icon="@Icons.Material.Filled.ExitToApp" Color=" Color.Error" />
                <MudIconButton @onclick="DarkModel" title="@(IsDarkMode?"تم لایت":"تم دارک")" Icon="@(IsDarkMode? @Icons.Material.Filled.LightMode:@Icons.Material.Filled.DarkMode)" Color="@(IsDarkMode?Color.Warning:Color.Default)" />

                <MudMenu Disabled="@(CurrentUser==null)" Icon="@Icons.Material.Filled.MoreVert" 
                AriaLabel="Open user menu"> 
                    <MudIconButton @onclick="RouteToDownload"  title="اپ اندروید ناراگرام"  Icon="@Icons.Material.Filled.Android" Color=" Color.Tertiary" /> 
                    <MudIconButton @onclick="CreateChannel"  title="ایجاد کانال"  Icon="@Icons.Material.Filled.AddComment" Color=" Color.Info" /> 



                </MudMenu>


            </MudAppBar>



            <MudMainContent>
                @Body
            </MudMainContent>

        </MudLayout>
    </CascadingValue>
</MudRTLProvider>
<style>
    .elevated-avatar {
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    border: 2px solid white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    }

    .elevated-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.3);
    }

    .avatar-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    }
</style>
@code {
    public void RouteToDownload()
    {
        Nav.NavigateTo("https://sanaapi.irannara.com/source/naragram.apk");
    }
    private async Task UpdateApp()
    {


        var keys = await js.InvokeAsync<string[]>("caches.keys");

        foreach (var key in keys)
        {
            await js.InvokeVoidAsync("caches.delete", key);
        }


        await VersionChecker.StoreCurrentVersionAsync();


        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
    [CascadingParameter]
    public ThemeChanging ThemeChanging { get; set; } = new ThemeChanging("background-color:#eff2fd", " color:rgb(255 64 129);", " box-shadow: 0 16px 45px #ecc7ee");
    bool _drawerOpen = true;
    public UserDto? CurrentUser { get; set; }
    public string? myAvatar { get; set; } = null;
    private bool newVersionAvailable = false;
    protected async override Task OnInitializedAsync()
    {
        newVersionAvailable = await VersionChecker.IsNewVersionAvailableAsync();
        CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();
        var cachedAvatar = await js.InvokeAsync<string>("localStorage.getItem", "userAvatar");

        if (string.IsNullOrEmpty(cachedAvatar))
        {
            CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();

            if (CurrentUser != null)
            {

                myAvatar = await userservice.GetAvatar(CurrentUser.Id);


                await js.InvokeVoidAsync("localStorage.setItem", "userAvatar", myAvatar);
                await js.InvokeVoidAsync("localStorage.setItem", "userAvatarTime", DateTime.UtcNow.ToString("o")); 
            }
        }
        else
        {

            myAvatar = cachedAvatar;
        }
        string? darkMode = await localStorage.GetItemAsync(nameof(IsDarkMode));
        if (darkMode != null)
        {
            IsDarkMode = darkMode == "True" ? true : false;
            DarkModel();
        }

    }


    bool IsDarkMode = false;
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    void DarkModel()
    {
        localStorage.SetItemAsync(nameof(IsDarkMode),IsDarkMode.ToString());
        IsDarkMode = !IsDarkMode;
        if(!IsDarkMode){
            ThemeChanging = new ThemeChanging("", " color:rgb(255 64 129);", " box-shadow: 0 16px 45px #ecc7ee;");
            ThemeChanging.backGroundChatStyle = "height: 100%; overflow-y: auto;background-image:url(lib/assets/Images/light.png);    background-size: cover;background-repeat:no-repeat;background-position: center; background-attachment: scroll;";
            ThemeChanging.myColorChat = "rgb(183 230 239 / 61%)";
            ThemeChanging.OtherColorChat = "rgb(233 236 239 / 86%)";
            ThemeChanging.SeenColor = Color.Secondary;
            ThemeChanging.ClockColor = "#270aff";
            ThemeChanging.MyColorReply = "#c4beff";
            ThemeChanging.OtherColorReply = "#f6effd";
            StateHasChanged();
        }
        else{
            ThemeChanging = new ThemeChanging("", " color:#776be7;", " box-shadow: 0 16px 45px #776be77d");
            ThemeChanging.backGroundChatStyle = "height: 100%; overflow-y: auto;background-image:url(lib/assets/Images/pxfuel.jpg);    background-size: cover;background-repeat:no-repeat;background-position: center; background-attachment: scroll;";
            ThemeChanging.OtherColorChat = "#495057e0";
            ThemeChanging.myColorChat = "rgb(28 62 95 / 86%)";
            ThemeChanging.SeenColor = Color.Info;
            ThemeChanging.ClockColor = "#00fdff";
            ThemeChanging.MyColorReply = "#112539";
            ThemeChanging.OtherColorReply = "#373740";
            StateHasChanged();
        }

    }

    private async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatar");
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatarTime");
        var parameters = new DialogParameters<DialogTemplate>
    {
        { x => x.ContentText, "کاربر گرامی آیا شما مطمئن هستید که می‌خواهید خارج شوید؟" },
        { x => x.ButtonText, "بله" },
        { x => x.Color, Color.Error }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large ,};

        var dialog = await DialogService.ShowAsync<DialogTemplate>("خروج", parameters, options);
        var res= await dialog.Result;
        if (!res.Canceled)
        {
            await PerformLogoutAsync();
        }
    }

    public async Task PerformLogoutAsync(){
        try
        {


            await auth.LogoutAsync();
            nm.NavigateTo("/");
        }
        catch (Exception ex)
        {
            nm.NavigateTo("/");
        }
    }
    public void SettingsShow(){

        ThemeChanging.IsShowSetting = !ThemeChanging.IsShowSetting;
        StateHasChanged();
    }
}

@code{
    public async Task CreateChannel()
    {
        var dialog = await DialogService.ShowAsync<CreateChannelDialogComponent>("ایجاد چنل جدید");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateChannelCommand command)
        {

            var response=  await channelservice.CreateChannel(command);
            if (response.issuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                nm.Refresh(true);
                snackbar.Add("ساخت کانال با موفقیت انجام شد.", Severity.Success);

            }
            else
            {
                   snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

                snackbar.Add(response.message, Severity.Error);
            }
        }
    }
    public async Task getPermission()
    {
         var token = await js.InvokeAsync<string>("requestPermission");
    }
