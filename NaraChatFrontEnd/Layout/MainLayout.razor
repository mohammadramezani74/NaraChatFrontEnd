        ThemeChanging.MyColorReply    = "#172554";                     // Blue 950
        ThemeChanging.OtherColorReply = "#0F172A";
        ThemeChanging.ReplyAccent     = "#64B5F6";
    }
}
 
 
// ---- در OnAfterRenderAsync، بلوک خواندن از localStorage ----

 

    private async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatar");
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatarTime");
        var parameters = new DialogParameters<DialogTemplate>
    {
        { x => x.ContentText, "کاربر گرامی آیا شما مطمئن هستید که می‌خواهید خارج شوید؟" },
        { x => x.ButtonText, "بله" },
        { x => x.Color, Color.Error }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large ,};

        var dialog = await DialogService.ShowAsync<DialogTemplate>("خروج", parameters, options);
        var res= await dialog.Result;
        if (!res.Canceled)
        {
            await PerformLogoutAsync();
        }
    }

    public async Task PerformLogoutAsync(){
        try
        {


            await auth.LogoutAsync();
            nm.NavigateTo("/");
        }
        catch (Exception ex)
        {
            nm.NavigateTo("/");
        }
    }
    public void SettingsShow(){

        ThemeChanging.IsShowSetting = !ThemeChanging.IsShowSetting;
        StateHasChanged();
    }
}

@code{
    public async Task CreateChannel()
    {
        var dialog = await DialogService.ShowAsync<CreateChannelDialogComponent>("ایجاد چنل جدید");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateChannelCommand command)
        {

            var response=  await channelservice.CreateChannel(command);
            if (response.issuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                nm.Refresh(true);
                snackbar.Add("ساخت کانال با موفقیت انجام شد.", Severity.Success);

            }
            else
            {
                   snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

                snackbar.Add(response.message, Severity.Error);
            }
        }
    }
        public async Task CreateGroup()
    {
        var dialog = await DialogService.ShowAsync<CreateGroupDialogComponent>("ایجاد گروه جدید");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateGroupCommand command)
        {

            var response=  await ConversationService.CreateGroupConversation(command.Others,
            command.Title,
            command.UserName,command.Description);
            if (response.IsSuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                nm.Refresh(true);
                snackbar.Add("ساخت گروه با موفقیت انجام شد.", Severity.Success);

            }
            else
            {
                   snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

                snackbar.Add("ساخت گروه با خطا مواجه شد", Severity.Error);
            }
        }
    }
