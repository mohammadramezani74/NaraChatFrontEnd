<MudRTLProvider RightToLeft="true">
    <CascadingValue Name="Theme" Value="ThemeChanging">
        <MudThemeProvider IsDarkMode="@IsDarkMode" Theme="_myTheme" />
        <MudPopoverProvider  />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar >

                <AuthorizeView>
                    <Authorized>
                        <div>


                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar @onclick="SettingsShow" Size="Size.Medium" Class="elevated-avatar">
                                    @if (!string.IsNullOrEmpty(myAvatar))
                                    {
                                        <MudImage Src="@($"data:image/png;base64,{myAvatar}")"
                                        Class="rounded-circle avatar-img" />
                                    }
                                    else
                                    {
                                        <MudImage Src="lib/assets/Images/avatar.jpg"
                                        Class="rounded-circle avatar-img" />
                                    }
                                </MudAvatar>

                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                    <b>@CurrentUser?.Name  </b>  
                                </MudText>
                                @if (newVersionAvailable)
                                {
                                    <div class="update-alert">
                                        نسخه جدیدی از برنامه در دسترس است.
                                        <button class="btn btn-primary" @onclick="UpdateApp">بارگذاری نسخه جدید</button>
                                    </div>
                                }

                            </MudStack>


                        </div>

                    </Authorized>
                    <NotAuthorized>
                        <h1>نارا مسنجر</h1>
                    </NotAuthorized>
                    <Authorizing>

                    </Authorizing>
                </AuthorizeView>


                <MudSpacer />
                <MudIconButton @onclick="Logout" title="خروج"  Icon="@Icons.Material.Filled.ExitToApp" Color=" Color.Error" />
                <MudIconButton @onclick="DarkModel" title="@(IsDarkMode?"تم لایت":"تم دارک")" Icon="@(IsDarkMode? @Icons.Material.Filled.LightMode:@Icons.Material.Filled.DarkMode)" Color="@(IsDarkMode?Color.Warning:Color.Default)" />

                <MudMenu Disabled="@(CurrentUser==null)" Icon="@Icons.Material.Filled.MoreVert" 
                AriaLabel="Open user menu"> 
                    @* <MudIconButton @onclick="RouteToDownload"  title="اپ اندروید ناراگرام"  Icon="@Icons.Material.Filled.Android" Color=" Color.Tertiary" />  *@
                     <MudIconButton @onclick="CreateChannel"  title="ایجاد کانال"  Icon="@Icons.Material.Filled.AddComment" Color=" Color.Info" />  
                    <MudIconButton @onclick="CreateGroup"  title="ایجاد گروه"  Icon="@Icons.Material.Filled.Group" Color=" Color.Secondary" /> 



                </MudMenu>


            </MudAppBar>



            <MudMainContent>
                @Body
            </MudMainContent>

        </MudLayout>
    </CascadingValue>
</MudRTLProvider>
<style>
    .elevated-avatar {
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    border: 2px solid white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    }

    .elevated-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.3);
    }

    .avatar-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    }
</style>
@code {
    public void RouteToDownload()
    {
        Nav.NavigateTo("https://sanaapi.irannara.com/source/naragram.apk");
    }
    private async Task UpdateApp()
    {


        var keys = await js.InvokeAsync<string[]>("caches.keys");

        foreach (var key in keys)
        {
            await js.InvokeVoidAsync("caches.delete", key);
        }


        await VersionChecker.StoreCurrentVersionAsync();


        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
    [CascadingParameter]
    public ThemeChanging ThemeChanging { get; set; } = new ThemeChanging("background-color:#eff2fd", " color:rgb(255 64 129);", " box-shadow: 0 16px 45px #ecc7ee");
    bool _drawerOpen = true;
    public UserDto? CurrentUser { get; set; }
    public string? myAvatar { get; set; } = null;
    private bool newVersionAvailable = false;
    protected async override Task OnInitializedAsync()
    {
        newVersionAvailable = await VersionChecker.IsNewVersionAvailableAsync();
        CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();
        var cachedAvatar = await js.InvokeAsync<string>("localStorage.getItem", "userAvatar");

        if (string.IsNullOrEmpty(cachedAvatar))
        {
            CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();

            if (CurrentUser != null)
            {

                myAvatar = await userservice.GetAvatar(CurrentUser.Id);


                await js.InvokeVoidAsync("localStorage.setItem", "userAvatar", myAvatar);
                await js.InvokeVoidAsync("localStorage.setItem", "userAvatarTime", DateTime.UtcNow.ToString("o")); 
            }
        }
        else
        {

            myAvatar = cachedAvatar;
        }
        string? darkMode = await localStorage.GetItemAsync(nameof(IsDarkMode));
        if (darkMode != null)
        {
            IsDarkMode = darkMode == "True" ? true : false;
            DarkModel();
        }

    }


    bool IsDarkMode = false;
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
  void DarkModel()
{
    IsDarkMode = !IsDarkMode;
    localStorage.SetItemAsync(nameof(IsDarkMode), IsDarkMode.ToString());
    ApplyTheme();
    StateHasChanged();
}
 
void ApplyTheme()
{
    if (!IsDarkMode)
    {
        ThemeChanging = new ThemeChanging("", " color:#1D6FD0;", " box-shadow: 0 16px 45px #cbd5e1;");
 
ThemeChanging.backGroundChatStyle =
    "height: 100%; overflow-y: auto; background-color: #EEF4FA; " +
    "background-image: url(lib/assets/Images/light.svg); " +
    "background-repeat: repeat; background-size: 96px 96px;";
 
        // اپاسیتی بالا نگه داشته شده چون حباب روی تصویر می‌نشیند
        ThemeChanging.myColorChat    = "rgba(219, 234, 254, 0.94)";   // Blue 100
        ThemeChanging.OtherColorChat = "rgba(255, 255, 255, 0.94)";
        ThemeChanging.MyTextColor    = "#0F172A";
