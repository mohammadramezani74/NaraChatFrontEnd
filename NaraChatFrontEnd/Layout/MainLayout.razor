@code {

private async Task ShowAbout()
{
    await DialogService.ShowAsync<AboutDialog>(string.Empty,
        new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        });
}
    public void RouteToDownload()
    {
        Nav.NavigateTo("https://sanaapi.irannara.com/source/naragram.apk");
    }
    private async Task UpdateApp()
    {


        var keys = await js.InvokeAsync<string[]>("caches.keys");

        foreach (var key in keys)
        {
            await js.InvokeVoidAsync("caches.delete", key);
        }


        await VersionChecker.StoreCurrentVersionAsync();


        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
    [CascadingParameter]
    public ThemeChanging ThemeChanging { get; set; } = new ThemeChanging("background-color:#eff2fd", " color:rgb(255 64 129);", " box-shadow: 0 16px 45px #ecc7ee");
    bool _drawerOpen = true;
    public UserDto? CurrentUser { get; set; }
    public string? myAvatar { get; set; } = null;
    private bool newVersionAvailable = false;
    private bool _isBotAdmin;
    protected async override Task OnInitializedAsync()
    {
        newVersionAvailable = await VersionChecker.IsNewVersionAvailableAsync();
        // فقط وقتی وارد شده، وگرنه 401 باعث رفرش پشت‌سرهمِ صفحه‌ی ورود می‌شود (JwtAuthorizationMessageHandler).
        stateprovider.AuthenticationStateChanged += OnAuthStateChanged;
        await RefreshBotAdminAsync(await stateprovider.GetAuthenticationStateAsync());
        CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();
  myAvatar = $"api/v1/chatfiles/{CurrentUser.Id}/{false}/getAvatar";
        var cachedAvatar = await js.InvokeAsync<string>("localStorage.getItem", "userAvatar");

        if (string.IsNullOrEmpty(cachedAvatar)||cachedAvatar!=myAvatar)
        {
            CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();

            if (CurrentUser != null)
            {

                 myAvatar = $"api/v1/chatfiles/{CurrentUser.Id}/{false}/getAvatar";


                await js.InvokeVoidAsync("localStorage.setItem", "userAvatar", myAvatar);
                await js.InvokeVoidAsync("localStorage.setItem", "userAvatarTime", DateTime.UtcNow.ToString("o")); 
            }
        }
        else
        {

            myAvatar = cachedAvatar;
        }
        // the stored value is the theme to show; it used to be flipped on every start (DarkModel toggles)
        string? darkMode = await localStorage.GetItemAsync(nameof(IsDarkMode));
        IsDarkMode = darkMode == "True";
        ApplyTheme();
        await SyncThemeClassAsync();

    }


    bool IsDarkMode = false;
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
  void DarkModel()
{
    IsDarkMode = !IsDarkMode;
    localStorage.SetItemAsync(nameof(IsDarkMode), IsDarkMode.ToString());
    ApplyTheme();
    _ = SyncThemeClassAsync();
    StateHasChanged();
}

// کلاس nara-dark روی <html>: پس‌زمینه‌ی کهکشانی، گوشه‌ی گرد حباب‌ها و تاریخ‌ها در app.css
async Task SyncThemeClassAsync()
{
    try { await js.InvokeVoidAsync("naraSetDarkTheme", IsDarkMode); } catch { /* هنوز site.js بالا نیامده */ }
}
 
void ApplyTheme()
{
    if (!IsDarkMode)
    {
        ThemeChanging = new ThemeChanging("", " color:#1D6FD0;", " box-shadow: 0 16px 45px #cbd5e1;");
 
// تم روشن «برفی»: عکس پس‌زمینه را app.css می‌گذارد (html:not(.nara-dark) #mainchat)،
// افقی برای دسکتاپ و عمودی برای موبایل. نسخه‌ی قبلی (الگوی light.svg) در تاریخچه‌ی گیت هست.
ThemeChanging.backGroundChatStyle =
    "height: 100%; overflow-y: auto; background-color: #EEF1F5;";
 
        // زمینه تقریباً سفید است، پس حباب‌ها کم‌شفاف‌اند و سایه‌ی خیلی کم دارند (app.css)
        ThemeChanging.myColorChat    = "rgba(219, 234, 254, 0.90)";    // Blue 100
        ThemeChanging.OtherColorChat = "rgba(255, 255, 255, 0.90)";
        ThemeChanging.MyTextColor    = "#0F172A";
        ThemeChanging.OtherTextColor = "#0F172A";
 
        ThemeChanging.SeenColor    = Color.Primary;
        ThemeChanging.ClockColor   = "#64748B";                        // Slate 500
        ThemeChanging.MyClockColor = "#64748B";
 
        ThemeChanging.MyColorReply    = "rgba(29, 111, 208, 0.10)";
        ThemeChanging.OtherColorReply = "rgba(29, 111, 208, 0.08)";
        ThemeChanging.ReplyAccent     = "#1D6FD0";
    }
    else
    {
        ThemeChanging = new ThemeChanging("", " color:#B39DFF;", " box-shadow: 0 16px 45px #05040A");
 
        // ThemeChanging.backGroundChatStyle =
        //     "height: 100%; overflow-y: auto; background-image:url(lib/assets/Images/pxfuel.jpg); background-size: cover; background-repeat:no-repeat; background-position: center; background-attachment: scroll;";
 // تم تیره‌ی «کهکشانی»: عکس پس‌زمینه را app.css می‌گذارد (html.nara-dark #mainchat)،
 // افقی برای دسکتاپ و عمودی برای موبایل. نسخه‌ی قبلی (الگوی chat-bg-dark.svg و حباب آبی)
 // در تاریخچه‌ی گیت هست.
 ThemeChanging.backGroundChatStyle =
    "height: 100%; overflow-y: auto; background-color: #0B0D1A;";
        // حباب‌های شیشه‌ای: نیمه‌شفاف، پشتشان در app.css تار می‌شود (backdrop-filter)
        ThemeChanging.myColorChat    = "rgba(150, 120, 220, 0.30)";    // بنفش شیشه‌ای
        ThemeChanging.OtherColorChat = "rgba(16, 16, 26, 0.55)";       // تیره‌ی شیشه‌ای
        ThemeChanging.MyTextColor    = "#F6F1FF";
        ThemeChanging.OtherTextColor = "#ECE8F2";
 
        ThemeChanging.SeenColor    = Color.Primary;
        ThemeChanging.ClockColor   = "#B0AABB";                        // روی حباب تیره
        ThemeChanging.MyClockColor = "#D5C8F2";                        // روی حباب بنفش
 
        ThemeChanging.MyColorReply    = "rgba(255, 255, 255, 0.10)";
        ThemeChanging.OtherColorReply = "rgba(255, 255, 255, 0.08)";
        ThemeChanging.ReplyAccent     = "#B388FF";
    }
}
 
 
// ---- در OnAfterRenderAsync، بلوک خواندن از localStorage ----

 

    private async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatar");
        await js.InvokeVoidAsync("localStorage.removeItem", "userAvatarTime");
        var parameters = new DialogParameters<DialogTemplate>
    {
        { x => x.ContentText, "کاربر گرامی آیا شما مطمئن هستید که می‌خواهید خارج شوید؟" },
        { x => x.ButtonText, "بله" },
        { x => x.Color, Color.Error }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large ,};

        var dialog = await DialogService.ShowAsync<DialogTemplate>("خروج", parameters, options);
        var res= await dialog.Result;
        if (!res.Canceled)
        {
            await PerformLogoutAsync();
        }
    }

    public async Task PerformLogoutAsync(){
        try
        {


            await auth.LogoutAsync();
            nm.NavigateTo("/");
        }
        catch (Exception ex)
        {
            nm.NavigateTo("/");
        }
    }
    public void SettingsShow(){

        ThemeChanging.IsShowSetting = !ThemeChanging.IsShowSetting;
        StateHasChanged();
    }
}

@code{
    public async Task CreateChannel()
    {
        var dialog = await DialogService.ShowAsync<CreateChannelDialogComponent>("ایجاد چنل جدید");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateChannelCommand command)
        {

            var response=  await channelservice.CreateChannel(command);
            if (response.issuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                nm.Refresh(true);
                snackbar.Add("ساخت کانال با موفقیت انجام شد.", Severity.Success);

            }
            else
            {
                   snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

                snackbar.Add(response.message, Severity.Error);
            }
        }
    }
        public async Task CreateGroup()
    {
        var dialog = await DialogService.ShowAsync<CreateGroupDialogComponent>("ایجاد گروه جدید");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateGroupCommand command)
        {

            var response=  await ConversationService.CreateGroupConversation(command.Others,
            command.Title,
            command.UserName,command.Description);
            if (response.IsSuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                nm.Refresh(true);
                snackbar.Add("ساخت گروه با موفقیت انجام شد.", Severity.Success);

            }
            else
            {
                   snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

                snackbar.Add(string.IsNullOrWhiteSpace(response.Message) ? "ساخت گروه با خطا مواجه شد" : response.Message, Severity.Error);
            }
        }
    }
