        public void Dispose()
        {
            stateprovider.AuthenticationStateChanged -= OnAuthStateChanged;
            _appInfoTimer?.Dispose();
        }

        // اعلان بالای برنامه و اجازه‌ی ساخت گروه/کانال (از تنظیمات پنل ادمین).
        private NaraChat.Contract.Models.Admin.AppInfoDto _appInfo = new();
        private System.Threading.Timer? _appInfoTimer;

        private async Task RefreshBotAdminAsync(AuthenticationState state)
        {
            var signedIn = state.User.Identity?.IsAuthenticated == true;
            _isBotAdmin = signedIn && await BotService.IsAdminAsync();
            _appInfo = signedIn ? await AppInfo.GetAsync(force: true) : new();

            // اعلان تازه بدون رفرش صفحه هم دیده شود (هر ۳ دقیقه).
            _appInfoTimer ??= new System.Threading.Timer(async _ =>
            {
                try
                {
                    var st = await stateprovider.GetAuthenticationStateAsync();
                    if (st.User.Identity?.IsAuthenticated != true)
                        return;
                    _appInfo = await AppInfo.GetAsync(force: true);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception)
                {
                    // اعلان مهم نیست که برنامه را بهم بزند.
                }
            }, null, TimeSpan.FromMinutes(3), TimeSpan.FromMinutes(3));
        }

        private async void OnAuthStateChanged(Task<AuthenticationState> task)
        {
            try
            {
                await RefreshBotAdminAsync(await task);
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                // نمایش دکمه‌ی پنل نباید صفحه را بهم بزند.
            }
        }


