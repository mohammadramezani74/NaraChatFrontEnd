        hubConnection.On<Guid>(nameof(IChatHubClient.DeletedMessageReceived), async (messageId) =>
     {

         DeletedMessageId = messageId;
         StateHasChanged();
     });
        // آخرین پیام گفتگو عوض شده — حذف پیام یا پاک کردن تاریخچه. برخلاف
        // DeletedMessageReceived این رویداد به حذف‌کننده هم می‌رسد، پس لیست
        // کناری هر دو طرف بدون رفرش به‌روز می‌شود.
        hubConnection.On<LastMessageChangedDto>(nameof(IChatHubClient.LastMessageChanged), async (changed) =>
     {
         var row = Users.FirstOrDefault(x => x.Id == changed.ScopeId)
                   ?? Users.FirstOrDefault(x => x.ConversationId == changed.ScopeId);

         if (row is null) return;

         row.LastReceivedMessage = (changed.Text ?? string.Empty).TruncateMessage();
         row.LastReceivedMessageId = changed.MessageId;

         // اگر پیامی نمانده، تاریخ هم پاک می‌شود تا گفتگو در ترتیب لیست
         // بالا نماند. خود ردیف حذف نمی‌شود؛ گفتگو هنوز وجود دارد.
         row.LastMessageDate = changed.SentAt;
         row.LastReceivedMessageSendDate = changed.SentAt.HasValue
             ? changed.SentAt.Value.FormatPersianDate().ToPersianNumber()
             : string.Empty;

         await InvokeAsync(StateHasChanged);
     });
        hubConnection.On<TypingReactionDto>(nameof(IChatHubClient.ReceivedReactions), async (messageType) =>
     {

         reaction = messageType;
         StateHasChanged();
     });
        hubConnection.On<UserDto>(nameof(IChatHubClient.ReceiveNewChannel), async (user) =>
     {

         if (!Users.Any(x => x.Id == user.Id))
         {
             Users.Add(user);
             StateHasChanged();
         }

     });


        return hubConnection;
    }

    private async Task OnUserSelected(UserDto user)
    {
        var userAvatar = Users.Where(c => c.Id == user.Id).Select(x => x.avatar).FirstOrDefault();
        _selectedUser = user;
        _selectedUser.avatar = userAvatar;
        ThemeChanging.IsShowSetting = true;
        StateHasChanged();
    }
    private async Task OnOtherUserSelected(UserDto user)
    {
        if(user.IsChannel)
        {
            LoadScroll = true;
            SelectedChannel = user;
            SelectedGroup = null;
            _selectedUser = null;
            OtherUser = null;
            var count = await channelService.GetChannelMembers(SelectedChannel.Id);
            ChannelCount = count.Count;
        }
        else if(user.IsGroup)
        {
            LoadScroll = true;
            SelectedGroup = user;
            SelectedChannel = null;
            _selectedUser = null;
            OtherUser = null;
            // var count = await channelService.GetChannelMembers(SelectedChannel.Id);
            ChannelCount = 2;
        }
        else
        {
            SelectedChannel = null;
            SelectedGroup = null;
            var userAvatar = Users.Where(c => c.Id == user.Id).Select(x => x.avatar).FirstOrDefault();
            OtherUser = user;
            OtherUser.avatar = userAvatar;
            var targetUser=  Users.Where(u => u.Id == user.Id).FirstOrDefault();
            if (targetUser!=null){
                OtherUser.LastSeen = targetUser.LastSeen;
            } }
        @if(IsMobile){
            gotoDetailByMobile = true;
            ThemeChanging.IsShowSetting = false;
        }
        LoadScroll = true;
        StateHasChanged();
    }
