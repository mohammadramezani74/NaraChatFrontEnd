@page "/chat"
@page "/chat/{id:guid}"
@page "/@{username}"
@using NaraChat.Application.Services.ChatServices.Channels
@using NaraChat.Contract.Models.Chat
@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents
@inject ISnackbar snackbar
@inject IUserChatService userService
@inject IJSRuntime js
@inject IConversationService ConversationService
@inject IChannelService channelService
@inject NavigationManager nm
@inject AuthenticationStateProvider stateprovider
@inject IDialogService dialogService
@inject NaraChat.Application.Services.ContactTasks.ContactTaskStore TaskStore
@inject NaraChat.Application.Services.Bots.BotStore BotStore
@using NaraChat.Contract.Models.ContactTasks
@using NaraChatFrontEnd.Pages.ChatPages.Components.ContactTasks
@implements IAsyncDisposable


 @inject AuthenticationStateProvider AuthenticationStateProvider

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0" Style="@(ThemeChanging.boxShadow+"; height: 90vh;" )">
    <MudCard Class="br-0 h-100">
        <MudCardContent Class="bg-light d-flex pa-0" Style="height: 100%; min-height: 0;">
            <MudGrid Style="flex:1; margin:0; height: 100%;" Spacing="0">

                @if (IsMobile)
                {
                    if (!gotoDetailByMobile && !ThemeChanging.IsShowSetting)
                    {

                        <MudItem xs="12" Class="h-100 d-flex flex-column" Style="padding:0; height: 100%;">
                            <UserList Users="Users"
                            MissedMessageCount="missedMassage"
                            ReeadMissedMessage="EmptyReadMessage"
                            Loading="LoadingUsers"
                            newIncomingMessage="_newIncomingMessageForUsers"
                            NullIncommengMessage="()=>_newIncomingMessageForUsers=null"
                            OnUserSelected="OnUserSelected"
                            OnOtherUserSelected="OnOtherUserSelected" />

                        </MudItem>
                    }
                    else if (gotoDetailByMobile )
                    {

                        <MudItem xs="12" Class="h-100 d-flex px-0">
                            <ChatDetail @key="ThemeChanging.IsShowSetting"
                            OtherUser="OtherUser"
                                        PinChangedScopeId="PinChangedScopeId"
                                        OnChatDeleted="HandleChatDeleted"
                            ClearedHistoryId="ClearedHistoryId"
                            OnHistoryCleared="NullClearedHistory"
                            NewIncomingMessage="_newIncomingMessage"
                            changeUserLastMessage="ChangeMyMessageOnUser"
                            IncommingMessageRecieved="NullIncomingMessage"
                            OnCancel="HandleChatDetailsCancel"
                            OnMessageSeen="SendMessageSeenIdsToHub"
                            MessagedSeened="MessagesId"
                            ReduceMessageSeenedCount="ReduceSeenedMessage"
                            NewIncomingEditedMessage="_newIncomingEditedMessage"
                            DeletedMessageId="DeletedMessageId"
                            OnSendMessageSession="SendConnectionMessage"
                            IsMobile="IsMobile"
                            BackToUsersList="HandleBackToUserListMobile"
                            SendReaction="ReactionToUser"
                            reactionType="reaction"
                            MyAvatar="@myAvatar"
                            NullReaction="NullReaction"
                            MessageReactioncallBack="SendReaction"
                            EmojiReaction="Reaction"
                            NullEmojiReactioncallBack="NullReact"
                            MissedUserMessage="missedTargetUserMassages"
                            ClearMissedMessageUser="ClearMissedTargetUserMessages"
                            LoadScroll="LoadScroll"
                            UpdateTimeList="UpdateTimeList"
                            FalseScroll="FalsingScrol"
                            trueScroll="trueingScrol"
                            GoToSettingInMobile="GoToSettingInMobile"
                            OnToggleTasks="ToggleTasksSide"
                            OnShowInfo="ShowInfoSide"
                            SelectedChannel="SelectedChannel"
                            SelectedGroup="SelectedGroup"
                            channelcount="ChannelCount"
                            joinchannelevent="JoinToChannel" />
                        </MudItem>
                    }
                    else if (ThemeChanging.IsShowSetting && !gotoDetailByMobile)
                    {

                        <MudItem xs="12" Class="h-100 d-flex flex-column" Style="padding:0; position:relative; overflow:hidden;">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                            Color="Color.Default"
                            Class="ma-2"
                            Style="position:absolute; right:0; z-index:1000;"
                            OnClick="ToggleUserInfo" />
                            <UserInfo MyAvatar="@myAvatar"
                            ChosenUser="_selectedUser"
                            OnPictureChanged="OnChanedPicture"
                            OnClearChosenUser="OnClearUserSelected"
                            OnBlockedUser="BlockedUser" 
                            AllUsers="Users.ToList()"
                            SelectedChannel="SelectedChannel" 
                            SelectedGroup="SelectedGroup"/>
                        </MudItem>
                    }
                }
                else
                {

                    <MudItem xs="12" sm="3" Class="h-100 d-flex flex-column" Style="padding:0; height: 100%;">
                        <UserList Users="Users"
                        MissedMessageCount="missedMassage"
                        ReeadMissedMessage="EmptyReadMessage"
                        Loading="LoadingUsers"
                        newIncomingMessage="_newIncomingMessageForUsers"
                        NullIncommengMessage="()=>_newIncomingMessageForUsers=null"
                        OnUserSelected="OnUserSelected"
                        OnOtherUserSelected="OnOtherUserSelected"
                        />
                    </MudItem>

                    <MudItem xs="12" sm="@( ThemeChanging.IsShowSetting ? 6 : 9)" Class="h-100 d-flex px-0">
                        <ChatDetail @key="ThemeChanging.IsShowSetting"
                        OtherUser="OtherUser"
                                    PinChangedScopeId="PinChangedScopeId"
                                    OnChatDeleted="HandleChatDeleted"
                        ClearedHistoryId="ClearedHistoryId"
                        OnHistoryCleared="NullClearedHistory"
                        NewIncomingMessage="_newIncomingMessage"
                        changeUserLastMessage="ChangeMyMessageOnUser"
                        IncommingMessageRecieved="NullIncomingMessage"
                        OnCancel="HandleChatDetailsCancel"
                        OnMessageSeen="SendMessageSeenIdsToHub"
                        MessagedSeened="MessagesId"
                        ReduceMessageSeenedCount="ReduceSeenedMessage"
                        NewIncomingEditedMessage="_newIncomingEditedMessage"
                        DeletedMessageId="DeletedMessageId"
                        OnSendMessageSession="SendConnectionMessage"
                        IsMobile="IsMobile"
                        BackToUsersList="HandleBackToUserListMobile"
                        SendReaction="ReactionToUser"
                        reactionType="reaction"
                        MyAvatar="@myAvatar"
                        NullReaction="NullReaction"
                        MessageReactioncallBack="SendReaction"
                        EmojiReaction="Reaction"
                        NullEmojiReactioncallBack="NullReact"
                        MissedUserMessage="missedTargetUserMassages"
                        ClearMissedMessageUser="ClearMissedTargetUserMessages"
                        LoadScroll="LoadScroll"
                        FalseScroll="FalsingScrol"
                        trueScroll="trueingScrol"
                        GoToSettingInMobile="GoToSettingInMobile" 
                        OnToggleTasks="ToggleTasksSide"
                        OnShowInfo="ShowInfoSide"
                        SelectedChannel="SelectedChannel"
                        SelectedGroup="SelectedGroup"
                        channelcount="ChannelCount"
                        joinchannelevent="JoinToChannel"
                        UpdateTimeList="UpdateTimeList" />
                    </MudItem>

                    @if (ThemeChanging.IsShowSetting)
                    {
                        <MudItem xs="12" sm="3" Class="h-100 d-flex flex-column" Style="padding:0; position:relative; overflow:hidden;">
                            @* یک ستون، دو تب: مشخصات مخاطب و کارهای شما با او (فقط چت خصوصی).
                               UserInfo عمداً بیرون از هر if است تا با عوض شدن تب یا رفتن
                               به کانال/گروه همان نمونه بماند؛ Dispose آن ستون را می‌بندد. *@
                            @if (CanShowTasksTab)
                            {
                                <div class="side-bar">
                                    <div class="side-tabs" role="tablist" aria-label="ستون کناری">
                                        <button type="button" role="tab"
                                                class="side-tab @(TaskStore.SideTab == ContactSideTab.Info ? "is-active" : "")"
                                                aria-selected="@(TaskStore.SideTab == ContactSideTab.Info ? "true" : "false")"
                                                @onclick="() => SelectSideTab(ContactSideTab.Info)">
                                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.75"></circle><path d="M4.75 20a7.25 7.25 0 0 1 14.5 0"></path></svg>
                                            مشخصات
                                        </button>
                                        <button type="button" role="tab"
                                                class="side-tab @(TaskStore.SideTab == ContactSideTab.Tasks ? "is-active" : "")"
                                                aria-selected="@(TaskStore.SideTab == ContactSideTab.Tasks ? "true" : "false")"
                                                @onclick="() => SelectSideTab(ContactSideTab.Tasks)">
                                            <TasksIcon Size="17" />
                                            کارها
                                            @if (TaskStore.OpenCount(OtherUser!.Id) is > 0 and var openCount)
                                            {
                                                <span class="side-tab-badge @(TaskStore.OverdueCount(OtherUser.Id) > 0 ? "is-overdue" : "")">@(openCount > 99 ? "۹۹+" : TaskDates.Fa(openCount))</span>
                                            }
                                        </button>
                                    </div>
                                    <button type="button" class="side-close" aria-label="بستن ستون" @onclick="ToggleUserInfo">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size: 20px;" />
                                    </button>
                                </div>

                                <div class="side-body @(TaskStore.SideTab == ContactSideTab.Tasks ? "" : "is-hidden")" role="tabpanel">
                                    <ContactTasksPanel ContactId="OtherUser!.Id"
                                                       ContactName="@OtherUser.Name"
                                                       Open="true"
                                                       Embedded="true"
                                                       OnClose="ToggleUserInfo"
                                                       OnOpenMessage="id => TaskStore.RequestJump(id)" />
                                </div>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                Color="Color.Default"
                                Class="ma-2"
                                Style="position:absolute; right:0; z-index:1000;"
                                OnClick="ToggleUserInfo" />
                            }

                            <div class="side-body @(CanShowTasksTab && TaskStore.SideTab == ContactSideTab.Tasks ? "is-hidden" : "")" role="tabpanel">
                                <UserInfo MyAvatar="@myAvatar"
                                ChosenUser="_selectedUser"
                                OnPictureChanged="OnChanedPicture"
                                OnClearChosenUser="OnClearUserSelected"
                                OnBlockedUser="BlockedUser"
                                SelectedChannel="SelectedChannel"
                                SelectedGroup="SelectedGroup"
                                AllUsers="Users.ToList()" />
                            </div>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public async Task GoToSettingInMobile(UserDto dto)
    {
        if(IsMobile){
            gotoDetailByMobile=false;
            ThemeChanging.IsShowSetting=true;
            _selectedUser = dto;
            StateHasChanged();
        }

    }
    public void BlockedUser(UserDto dto)
    {
        var user=Users.Where(x => x.Id == dto.Id).FirstOrDefault();
        user.IsBlocked = dto.IsBlocked;
        StateHasChanged();
    }
    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeChanging { get; set; }
    [Parameter]
    public Guid id { get; set; }
    [Parameter]
    public string? username { get; set; }
    private string? _pendingUsername;
    public string? myAvatar { get; set; }
    protected override void OnParametersSet()
    {
        if(id !=Guid.Empty){
            OtherUser = Users.Where(x=>x.Id==id).FirstOrDefault() ;
            StateHasChanged();
        }
        if(!string.IsNullOrWhiteSpace(username))
            _pendingUsername = username.TrimStart('@');
    }
    public void FalsingScrol()
    {
        LoadScroll = false;
        StateHasChanged();
    }
    public void trueingScrol()
    {
        LoadScroll = true;
        StateHasChanged();
    }

    private void ToggleUserInfo()
    {
        ThemeChanging.IsShowSetting = !ThemeChanging.IsShowSetting;
        StateHasChanged();
    }
    private void NullReaction(){
        reaction = null;
    }
    private void NullReact()
    {
        Reaction = null;
    }

}




@code {
    private DotNetObjectReference<Chat> _objRef;
    private UserDto Logineduser;

    public List<Guid> MessagesId { get; set; } = new ();
    private UserDto? OtherUser=null;
    private UserDto? _selectedUser = null;
    private IList<UserDto> Users { get; set; } = new List<UserDto>();
    private HubConnection? _hubConnection;
    private bool LoadingUsers = false;
    private ChatMessageDto? _newIncomingMessage = null;
    private ChatMessageDto? _newIncomingMessageForUsers = null;
    private ChatMessageDto? LastReceivedMessage = null;
    private EditedMessageDto? _newIncomingEditedMessage = null;
    public Guid? DeletedMessageId { get; set; } = null;
    private Timer _idleTimer;
    private DateTime _lastActivityTime = DateTime.Now;
    private const int IdleTimeoutMinutes = 5;
    private bool IsMobile { get; set; } = false;
    private bool gotoDetailByMobile { get; set; } = false;
    public TypingReactionDto? reaction { get; set; } = null;
    private MessageReaction? Reaction = null;
    private List<ChatMessageDto> missedMassage = new List<ChatMessageDto>();
    private List<ChatMessageDto> missedTargetUserMassages = new List<ChatMessageDto>();
    public bool LoadScroll { get; set; } = false;
    public UserDto? SelectedChannel = null;
    public UserDto? SelectedGroup = null;
    public Guid? ClearedHistoryId { get; set; }
    public int ChannelCount { get; set; }
    public Guid? PinChangedScopeId { get; set; }

    public async Task HandleBackToUserListMobile(){
        gotoDetailByMobile = false;
        ThemeChanging.IsShowSetting = false;
        StateHasChanged();
    }


    public async Task JoinToChannel(string usrename)
    {
        await HandleChannelLink(usrename);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {

             _ = RequestNotificationTokenAsync();


            Logineduser = await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).GetUserInfoAsync();

            if (!await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).IsAuthenticated())
            {
                Console.WriteLine("کاربر احراز هویت نشده");
                nm.NavigateTo("/");
                return;
            }

            _hubConnection = await ConfigureHubConnection();

            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();

            if (_hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.SendAsync("SetUserOnline", Logineduser);

            var cachedIsmobile = await js.InvokeAsync<string>("localStorage.getItem", "IsMobile");
            if (cachedIsmobile != null)
            {
                if (cachedIsmobile.ToLower() == "true")
                    IsMobile = true;
                else
                    IsMobile = false;
            }
            _ = LoadDeferredDataAsync();

            // شمارش کارهای باز برای ستون چت‌ها، و انتقال یک‌باره‌ی چک‌لیست
            // قدیمیِ مرورگر به سرور. هیچ‌کدام نباید باز شدن صفحه را معطل کنند.
            _ = InitContactTasksAsync();


        }
        catch (Exception ex)
        {
            Console.WriteLine("کاربر احراز هویت نشده");
            Console.WriteLine($"هاب ارور داره: {ex.Message}");
        }
    }
    private async Task RequestNotificationTokenAsync()
    {
        try
        {
            var token = await js.InvokeAsync<string>("requestPermission");
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            if (!string.IsNullOrEmpty(token))
            {
                await userService.StoreToken(token);
                snackbar.Add($" فعال سازی ناتیفیکیشن با موفقیت انجام شد ", Severity.Success);
                
          }
            else
            {
                snackbar.Add($" فعال سازی ناتیفیکیشن موفقیت آمیز نبود لطقا یک بار دیگر صفحه را رفرش کنید ", Severity.Warning);
            }




        }
        catch (Exception ex)
        {
            Console.WriteLine("توکن نوتیفیکیشن خطا داد: " + ex.Message);
        }
    }
    private async Task LoadDeferredDataAsync()
    {
        try
        {
            LoadingUsers = true;

            var usersList = await userService.GetUsersAsync();
            if (usersList is not null)
                Users = usersList.ToList();

            var cachedAvatar = await js.InvokeAsync<string>("localStorage.getItem", "userAvatar");

            if (string.IsNullOrEmpty(cachedAvatar))
            {
                myAvatar = $"api/v1/chatfiles/{Logineduser.Id}/{false}/getAvatar";
                await js.InvokeVoidAsync("localStorage.setItem", "userAvatar", myAvatar);
                await js.InvokeVoidAsync("localStorage.setItem", "userAvatarTime", DateTime.UtcNow.ToString("o"));

            }
            else
            {
                myAvatar = $"api/v1/chatfiles/{Logineduser.Id}/{false}/getAvatar";
            }


            var cachedIsmobile =  await js.InvokeAsync<string>("localStorage.getItem", "IsMobile");
            if (cachedIsmobile != null)
            {
                if (cachedIsmobile.ToLower() == "true")
                    IsMobile = true;
                else
                    IsMobile = false;
            }
            else{
                var size = await js.InvokeAsync<WindowSizeDto>("getWindowSize");
                if (size.Width <= 500)
                {
                    await js.InvokeVoidAsync("localStorage.setItem", "IsMobile", true);
                    IsMobile = true;
                }
                else
                {
                    await js.InvokeVoidAsync("localStorage.setItem", "IsMobile", false);
                    IsMobile = false;
                }
            }
            if(!string.IsNullOrEmpty(_pendingUsername))
            {
                await HandleChannelLink(_pendingUsername);
                _pendingUsername = null;
            }
            LoadingUsers = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine("LoadDeferredDataAsync خطا داد: " + ex.Message);
        }
    }


    private async Task SendConnectionMessage()
    {
        if(_hubConnection is not null){
            if (_hubConnection.State == HubConnectionState.Disconnected)
            {
                await _hubConnection.StartAsync();
                await _hubConnection.SendAsync("SetUserOnline", Logineduser);
            }
            await _hubConnection.SendAsync("SetUserOnline", Logineduser);
        }
    }
    private async Task OnReconnected(string? arg)
    {
        Console.WriteLine("Reconnecting User Again");
        Console.WriteLine("ریکانکت دوباره");
        var messageId = LastReceivedMessage?.Id.ToString() ?? "خالی";
        Console.WriteLine($"آخرین پیام من : {messageId}");

        if (_hubConnection.State == HubConnectionState.Disconnected)
        {
            await _hubConnection.StartAsync();
        }
        if (_hubConnection.State == HubConnectionState.Connected)
        {
            _hubConnection.SendAsync("SetUserOnline", Logineduser);
        }
        if (LastReceivedMessage != null)
        {
            await _hubConnection.InvokeAsync<List<ChatMessageDto>>(
             "GetMissedMessages", LastReceivedMessage
             );
        }
        else
        {
            LastReceivedMessage = new ChatMessageDto { UserId = Logineduser.Id };
            Console.WriteLine($"رفتش توی اینورینت دومی با آیدی {LastReceivedMessage.Id}");
            await _hubConnection.InvokeAsync<List<ChatMessageDto>>(
            "GetMissedMessages", LastReceivedMessage
            );
        }

    }
    private async Task<HubConnection> ConfigureHubConnection()
    {
        var token = await ((CustomAuthenticationStateProvider)stateprovider).GetTokenAsync();

        var hubConnection = new HubConnectionBuilder()
       .WithUrl(nm.ToAbsoluteUri(SiteSettings.HubConnectuinUrl), Options => {
           Options.AccessTokenProvider = () => Task.FromResult(token);
       })
       .WithAutomaticReconnect()
       .Build();
        hubConnection.KeepAliveInterval = TimeSpan.FromSeconds(20);
        hubConnection.ServerTimeout = TimeSpan.FromSeconds(150); 
        hubConnection.HandshakeTimeout = TimeSpan.FromSeconds(30);
        hubConnection.Reconnecting += error =>
    {
        Console.WriteLine($"Connection lost. Attempting to reconnect... Error: {error.Message}");
        return Task.CompletedTask;
    };

        hubConnection.Reconnected +=  OnReconnected;

        hubConnection.Closed += error =>
        {
            Console.WriteLine($"Connection closed. Error: {error?.Message}");
            return Task.CompletedTask;
        };
  


  

    // کارهای شخصی از دستگاه یا تب دیگری عوض شد.
    hubConnection.On<Guid>(nameof(IChatHubClient.ContactTasksChanged), (contactId) =>
    {
        TaskStore.NotifyRemote(contactId);
    });
    // ربات یکی از پیام‌هایش را عوض کرد (رفتن به زیرمنو، برداشتن دکمه‌ها).
    hubConnection.On<ChatMessageDto>(nameof(IChatHubClient.BotMessageUpdated), (message) =>
    {
        BotStore.PublishMessageUpdate(message);
    });
    // کیبورد ربات برای این کاربر عوض شد.
    hubConnection.On<NaraChat.Contract.Models.Bots.BotStateDto>(nameof(IChatHubClient.BotStateChanged), (state) =>
    {
        BotStore.SetState(state);
    });
    // زمان یادآوری یک کار رسید.
    hubConnection.On<TaskReminderDto>(nameof(IChatHubClient.TaskReminder), (reminder) =>
    {
        _ = InvokeAsync(() => HandleTaskReminderAsync(reminder));
    });
    hubConnection.On<Guid>(nameof(IChatHubClient.ChatHistoryCleared), (id) =>
{
    ClearedHistoryId = id;
    StateHasChanged();
    });
    hubConnection.On<Guid, Guid, bool>(nameof(IChatHubClient.MessagePinChanged),
        (scopeId, messageId, pinned) =>
    {
        PinChangedScopeId = scopeId;
        StateHasChanged();
    });
        hubConnection.On<Guid>(nameof(IChatHubClient.OnlineUserList), (channelId) =>
       {
           var selectedChannel = Users.Where(x => x.Id == channelId).FirstOrDefault();
           if (selectedChannel != null)
           {
               Users.Remove(selectedChannel);
               StateHasChanged();
           }


       });
        hubConnection.On<Guid>(nameof(IChatHubClient.GetDeletedChannel), async (deletedId) =>
      {
         
          await HandleChatDeleted(deletedId);
      
      });
        hubConnection.On<BlockDto>(nameof(IChatHubClient.BlockUser), (blockedUser) =>
     {
         var user = Users.Where(u => u.Id == blockedUser.UserId).FirstOrDefault();
         if(user!=null)
         {
             user.OtherUserBlocked = blockedUser.IsBlocked;
         }
         StateHasChanged();
     });
        hubConnection.On<ChatMessageDto>(
       nameof(IChatHubClient.MessagedReceived),
       (messageDto) =>
       {
           try
           {
               // ردیف لیست کناری با کلید خودش پیدا می‌شود، نه با فرستنده:
               //   خصوصی → کاربر مقابل (که از دید ما همان فرستنده است)
               //   گروه و کانال → خود گفتگو
               // قبلاً همیشه UserId استفاده می‌شد و برای پیام گروهی به ردیف چت
               // خصوصیِ فرستنده می‌خورد؛ برای همین آخرین پیام روی کاربر اشتباه
               // می‌نشست.
               var isPrivate = messageDto.ConversationType == ConversationType.Private;
               var rowId = isPrivate ? messageDto.UserId : messageDto.ScopeId;

               var row = Users.FirstOrDefault(x => x.Id == rowId);

               if (row == null)
               {
                   LoadScroll = true;
                   StateHasChanged();
                   return;
               }

               // این سه همیشه انحصاری‌اند: OnOtherUserSelected دو تای دیگر را
               // null می‌کند. با همان rowId مقایسه می‌شود تا هر دو طرف یک
               // معیار داشته باشند.
               var openRowId = (SelectedChannel ?? SelectedGroup ?? OtherUser)?.Id;
               var isForOpenChat = openRowId is not null && openRowId == rowId;

               if (isForOpenChat)
               {
                   _newIncomingMessage = messageDto;

                   if (row.messageUnreadedCount > 0)
                       row.messageUnreadedCount--;
               }

               // متن و زمان آخرین پیام همیشه به‌روز می‌شود، چه گفتگو باز باشد
               // چه نباشد. LastMessageDate کلید مرتب‌سازی لیست است و قبلاً در
               // مسیر دریافت اصلاً ست نمی‌شد، برای همین ترتیب لیست تکان نمی‌خورد.
               row.LastReceivedMessage = (messageDto.Content ?? string.Empty).TruncateMessage();
               row.LastReceivedMessageId = messageDto.Id;
               row.IsLastReceivedMessageForMe = false;
               row.LastMessageDate = messageDto.SendAt;
               row.LastReceivedMessageSendDate = messageDto.SendAt.FormatPersianDate().ToPersianNumber();

               if (!Users.Any(x => x.Id == row.Id))
               {
                   Users.Insert(0, row);
               }

               LoadScroll = true;

               InvokeAsync(StateHasChanged);
           }
           catch (Exception ex)
           {
               Console.WriteLine(ex);
           }
       });
       //  hubConnection.On<ChatMessageDto>(nameof(IChatHubClient.MessagedReceived), (MessageDto) =>
       // {

       //     var fromusers = Users.FirstOrDefault(x => x.Id == MessageDto.UserId);
       //     var isGroup = SelectedGroup != null ? SelectedGroup.IsGroup : false;
       //     if (isGroup)
       //     {
