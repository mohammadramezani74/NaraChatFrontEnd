    // ------------------------------------------------------- یادآوری کارها

    private async Task HandleTaskReminderAsync(TaskReminderDto reminder)
    {
        // صدا و اعلان سیستم‌عامل (اگر اجازه داده شده). tag همان tag اعلان Firebase
        // است تا اگر هر دو رسیدند فقط یکی دیده شود.
        try
        {
            await js.InvokeVoidAsync("naraTaskAlarm", new
            {
                title = $"یادآوری · {reminder.ContactName}",
                body = reminder.Text,
                tag = $"task-{reminder.TaskId}",
            });
        }
        catch (Exception) { /* site.js قدیمی در کش */ }

        TaskStore.RaiseReminder(reminder);

        snackbar.Add($"⏰ یادآوری: {reminder.Text} — {reminder.ContactName}", Severity.Info, config =>
        {
            config.RequireInteraction = true;
            config.ShowCloseIcon = true;
            config.Action = "باز کردن";
            config.ActionColor = Color.Primary;
            config.OnClick = _ => InvokeAsync(() => OpenContactTasksAsync(reminder.ContactId));
        });
    }

    /// <summary>چت مخاطب را باز می‌کند و کارهایش را نشان می‌دهد.</summary>
    private async Task OpenContactTasksAsync(Guid contactId)
    {
        var user = Users.FirstOrDefault(u => u.Id == contactId && !u.IsChannel && !u.IsGroup);
        if (user is null)
            return;

        if (OtherUser?.Id != contactId)
        {
            user.IsSelected = true;
            await OnUserSelected(user);
            await OnOtherUserSelected(user);
        }

        TaskStore.RequestOpen();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        TaskStore.Changed -= OnTaskStoreChanged;
        TaskStore.OpenRequested -= OnTasksOpenRequested;
        await _hubConnection!.SendAsync("SetUserOffline", Logineduser);
        Console.WriteLine($"{Logineduser.Name} is offlined");
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
        _objRef?.Dispose();
    }
    public async Task SendReaction(MessageReaction reaction)
    {
        if (_hubConnection.State == HubConnectionState.Disconnected)
        {
            await _hubConnection.StartAsync();
            await _hubConnection.SendAsync("SetUserOnline", Logineduser);
        }
        await _hubConnection!.SendAsync("ReceiveReaction", reaction);
    }
