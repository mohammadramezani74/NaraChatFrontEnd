    public async Task UpdateTimeList((Guid UserId,DateTime now, string Message) data)
    {
        var target = Users.Where(x => x.Id == data.UserId).FirstOrDefault();
        if(target is not null)
        {
            target.LastMessageDate = data.now;
            target.LastReceivedMessageSendDate = CreateDateTime(data.now);
            if(data.Message.Length>15)
                target.LastReceivedMessage = data.Message.Substring(0,15)+"...";
            else
            {
                target.LastReceivedMessage = data.Message;
            }

            StateHasChanged();
        }
    }
    private static string CreateDateTime(DateTime? lastMessageSentAt)
    {
        return lastMessageSentAt?.FormatPersianDate().ToPersianNumber() ?? "";
    }
