    public async Task HandleChatDeleted(Guid deletedId)
    {
        var item = Users.FirstOrDefault(x => x.Id == deletedId);
        if (item is not null) Users.Remove(item);

        if (SelectedGroup?.Id == deletedId || SelectedChannel?.Id == deletedId)
        {
            SelectedGroup = null;
            SelectedChannel = null;
            OtherUser = null;
        }

        await InvokeAsync(StateHasChanged);
    }
