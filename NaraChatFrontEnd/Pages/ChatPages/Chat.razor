    private async Task HandleChannelLink(string userName)
    {
        userName = userName.TrimStart('@');
        var channel = Users.FirstOrDefault(u => u.UserName?.Equals(userName, StringComparison.OrdinalIgnoreCase) == true);
        if (channel == null)
        {
            var search = await channelService.GetPublicChannels();

            channel = search.FirstOrDefault(u => u.UserName?.Equals(userName, StringComparison.OrdinalIgnoreCase) == true && u.IsChannel);
            if (channel == null)
            {
                snackbar.Add("کانال یافت نشد ", Severity.Error);
                return;
            }

            var parameters = new DialogParameters<DialogTemplate>
            {
                { x => x.ContentText, $"آیا می‌خواهید در کانال {channel.Name} عضو شوید؟" },
                { x => x.ButtonText, "بله" },
                { x => x.Color, Color.Primary }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
            var dialog = await dialogService.ShowAsync<DialogTemplate>("عضویت کانال", parameters, options);
            var result = await dialog.Result;
            if (result.Canceled)
                return;

            await channelService.JoinToPublicChannel(channel.Id);
            Users.Add(channel);
        }

        await OnOtherUserSelected(channel);
    }
