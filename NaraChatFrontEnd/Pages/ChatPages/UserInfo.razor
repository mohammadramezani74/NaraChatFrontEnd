@using System.Text.RegularExpressions
@using NaraChat.Application.Services.ChatServices.Channels
@using NaraChat.Contract.Models.Chat.Channels
@using NaraChatFrontEnd.Pages.ChatPages.Components
@using System.Text
@inject IUserChatService userService
@inject IChannelService _channelService
@inject AuthenticationStateProvider stateprovider
@inject IDialogService dialogService
@inject ISnackbar snackbar
@inject IConversationService ConversationService
@inject IJSRuntime js
@implements IAsyncDisposable

<MudPaper Elevation="0" Class="profile-panel h-100 d-flex flex-column">

    @* ==================== CHANNEL ==================== *@
    @if (SelectedChannel != null)
    {
        <div class="profile-scroll">

            <!-- تصویر و هویت -->
            <div class="hero">
                <div class="hero-media" @onclick="OpenChannelPictureDialog" title="نمایش تصویر">
                    <MudImage Src="@($"{SiteSettings.ApiUrl}{SelectedChannel.avatar}")"
                              ObjectFit="ObjectFit.Cover"
                              Class="hero-img" />
                    <span class="hero-scrim"></span>
                </div>

                <span class="hero-badge is-channel">
                    <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="badge-icon" /> کانال
                </span>

                <div class="hero-camera">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadChannelFiles" Disabled="@(IsSelectedFile)">
                        <ActivatorContent>
                            <MudIconButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Title="تغییر تصویر کانال"
                                           Icon="@Icons.Material.Filled.PhotoCamera" />
                        </ActivatorContent>
                    </MudFileUpload>
                </div>
            </div>

            <div class="identity">
                <h2 class="identity-name">@SelectedChannel.Name</h2>

                <button type="button" class="username-chip" @onclick="CopyUserName" title="کپی شناسه">
                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Class="chip-icon" />
                    <span>@($"@{SelectedChannel.UserName}")</span>
                </button>
            </div>

            <!-- بیوگرافی -->
            <section class="section-card">
                <div class="section-head">
                    <span class="section-title">درباره کانال</span>
                    @if (SelectedChannel.channel?.CurrentUserAdmin == true && !ClickOnBioEdited)
                    {
                        <MudIconButton OnClick="()=>ClickOnBioEdited=true"
                                       Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Title="ویرایش بیوگرافی"
                                       Class="ghost-btn" />
                    }
                </div>

                @if (SelectedChannel.channel?.CurrentUserAdmin == true && ClickOnBioEdited)
                {
                    <div class="inline-edit">
                        <MudTextField @bind-Value="bio"
                                      Placeholder="متن معرفی کانال"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      AutoGrow
                                      MaxLines="4"
                                      Class="edit-field" />
                        <MudIconButton OnClick="ChangeBio" Size="Size.Small" Icon="@Icons.Material.Filled.Check" Title="ذخیره" Color="Color.Success" />
                        <MudIconButton OnClick="()=>ClickOnBioEdited=false" Size="Size.Small" Icon="@Icons.Material.Filled.Close" Title="انصراف" Color="Color.Error" />
                    </div>
                }
                else
                {
                    <p class="body-text @(string.IsNullOrWhiteSpace(SelectedChannel.Bio) ? "is-placeholder" : "")">
                        @(string.IsNullOrWhiteSpace(SelectedChannel.Bio) ? "توضیحی ثبت نشده است" : SelectedChannel.Bio)
                    </p>
                }
            </section>

            <!-- اعضا و فایل‌ها -->
            <section class="section-card p-0">
                <MudTabs @bind-ActivePanelIndex="_channelManagementActiveTab"
                         Class="detail-tabs"
                         Rounded="false"
                         ApplyEffectsToContainer="true">

                    <MudTabPanel Text="اعضا">
                        <div class="tab-body">
                            <div class="section-head">
                                <span class="section-title">
                                    اعضای کانال
                                    <span class="count-pill">@ChannelMembers.Count.ToPersianNumber2()</span>
                                </span>
                                @if (CanManageMembers)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.PersonAdd"
                                               Color="Color.Primary"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Disabled="@(!HasAvailableUsersForChannel())"
                                               OnClick="OpenAddMemberDialog">
                                        افزودن عضو
                                    </MudButton>
                                }
                            </div>

                            <div class="scroll-list">
                                @if (ChannelMembers.Any())
                                {
                                    @foreach (var member in ChannelMembers)
                                    {
                                        <div class="member-row">
                                            <span class="member-initial @(member.IsCreator ? "is-creator" : member.IsAdmin ? "is-admin" : "")">
                                                @(string.IsNullOrWhiteSpace(member.Name) ? "؟" : member.Name.Trim().Substring(0, 1))
                                            </span>

                                            <div class="member-main">
                                                <span class="member-name">@member.Name</span>
                                                <span class="role-chip @(member.IsCreator ? "role-creator" : member.IsAdmin ? "role-admin" : "role-member")">
                                                    @(member.IsCreator ? "سازنده" : member.IsAdmin ? "ادمین" : "عضو")
                                                </span>
                                            </div>

                                            <div class="member-actions">
                                                @if (SelectedChannel.channel.CreatorId == member.Id)
                                                {
                                                }
                                                else if (SelectedChannel.channel.CreatorId == CurrentUser.Id && member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveModerator"
                                                                   Color="Color.Warning"
                                                                   Size="Size.Small"
                                                                   Title="حذف دسترسی ادمین"
                                                                   OnClick="()=>RemoveAdmin(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از کانال"
                                                                   OnClick="()=>RemoveMember(member)" />
                                                }
                                                else if (SelectedChannel.channel.CreatorId == CurrentUser.Id && !member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   Title="ارتقا به ادمین"
                                                                   OnClick="()=>PromoteToAdminAsync(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از کانال"
                                                                   OnClick="()=>RemoveMember(member)" />
                                                }
                                                else if (isAdmin() && !member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   Title="ارتقا به ادمین"
                                                                   OnClick="()=>PromoteToAdminAsync(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از کانال"
                                                                   OnClick="()=>RemoveMember(member)" />
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="mini-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.Group" />
                                        <span>هنوز عضوی اضافه نشده است</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="فایل‌ها" OnClick="InitializeChannelAssets">
                        <div class="tab-body">
                            <div class="section-head">
                                <span class="section-title">فایل‌های ارسالی</span>
                                @if (ChannelFileItems.Any())
                                {
                                    <MudTextField T="string"
                                                  Value="_fileSearch"
                                                  ValueChanged="OnFileSearchChanged"
                                                  Placeholder="جستجوی فایل"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                                  Immediate="true"
                                                  Class="mini-search" />
                                }
                            </div>

                            <div class="scroll-list">
                                @if (FilteredChannelFileItems.Any())
                                {
                                    @foreach (var file in FilteredChannelFileItems)
                                    {
                                        <div class="file-row">
                                            <span class="file-icon">
                                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" />
                                            </span>
                                            <div class="file-main">
                                                <span class="file-name">@file.FileName</span>
                                                <span class="file-ext">@(System.IO.Path.GetExtension(file.FileName)?.TrimStart('.').ToUpperInvariant())</span>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => DownloadFile(file)"
                                                           Title="دانلود" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="mini-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.FolderOff" />
                                        <span>فایلی برای نمایش نیست</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>

                </MudTabs>
            </section>

        </div>
    }

    @* ==================== GROUP ==================== *@
    else if (SelectedGroup != null)
    {
        <div class="profile-scroll">

            <div class="hero">
                <div class="hero-media" @onclick="OpenGroupPictureDialog" title="نمایش تصویر">
                    <MudImage Src="@($"{SiteSettings.ApiUrl}{SelectedGroup.avatar}")"
                              ObjectFit="ObjectFit.Cover"
                              Class="hero-img" />
                    <span class="hero-scrim"></span>
                </div>

                <span class="hero-badge is-group">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Class="badge-icon" /> گروه
                </span>

                @if (HasAccessToChangePicture())
                {
                    <div class="hero-camera">
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadGroupFiles" Disabled="@(IsSelectedFile)">
                            <ActivatorContent>
                                <MudIconButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Title="تغییر تصویر گروه"
                                               Icon="@Icons.Material.Filled.PhotoCamera" />
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>
                }
            </div>

            <div class="identity">
                <h2 class="identity-name">@SelectedGroup.Name</h2>

                <button type="button" class="username-chip" @onclick="CopyUserName" title="کپی شناسه">
                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Class="chip-icon" />
                    <span>@($"@{SelectedGroup.UserName}")</span>
                </button>
            </div>

            <section class="section-card">
                <div class="section-head">
                    <span class="section-title">درباره گروه</span>
                    @if (SelectedGroup.channel?.CurrentUserAdmin == true && !ClickOnBioEdited)
                    {
                        <MudIconButton OnClick="()=>ClickOnBioEdited=true"
                                       Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Title="ویرایش بیوگرافی"
                                       Class="ghost-btn" />
                    }
                </div>

                @if (SelectedGroup.channel?.CurrentUserAdmin == true && ClickOnBioEdited)
                {
                    <div class="inline-edit">
                        <MudTextField @bind-Value="bio"
                                      Placeholder="متن معرفی گروه"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      AutoGrow
                                      MaxLines="4"
                                      Class="edit-field" />
                        <MudIconButton OnClick="ChangeGroupBio" Size="Size.Small" Icon="@Icons.Material.Filled.Check" Title="ذخیره" Color="Color.Success" />
                        <MudIconButton OnClick="()=>ClickOnBioEdited=false" Size="Size.Small" Icon="@Icons.Material.Filled.Close" Title="انصراف" Color="Color.Error" />
                    </div>
                }
                else
                {
                    <p class="body-text @(string.IsNullOrWhiteSpace(SelectedGroup.Bio) ? "is-placeholder" : "")">
                        @(string.IsNullOrWhiteSpace(SelectedGroup.Bio) ? "توضیحی ثبت نشده است" : SelectedGroup.Bio)
                    </p>
                }
            </section>

            <section class="section-card p-0">
                <MudTabs @bind-ActivePanelIndex="_channelManagementActiveTab"
                         Class="detail-tabs"
                         Rounded="false"
                         ApplyEffectsToContainer="true">

                    <MudTabPanel Text="اعضا">
                        <div class="tab-body">
                            <div class="section-head">
                                <span class="section-title">
                                    اعضای گروه
                                    <span class="count-pill">@((GroupMembers?.Count ?? 0).ToPersianNumber2())</span>
                                </span>
                                @if (CanManageGroupMembers)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.PersonAdd"
                                               Color="Color.Primary"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Disabled="@(!HasAvailableUsersForChannel())"
                                               OnClick="OpenAddMemberGroupDialog">
                                        افزودن عضو
                                    </MudButton>
                                }
                            </div>

                            <div class="scroll-list">
                                @if (GroupMembers != null && GroupMembers.Any())
                                {
                                    @foreach (var member in GroupMembers)
                                    {
                                        <div class="member-row">
                                            <span class="member-initial @(member.IsCreator ? "is-creator" : member.IsAdmin ? "is-admin" : "")">
                                                @(string.IsNullOrWhiteSpace(member.Name) ? "؟" : member.Name.Trim().Substring(0, 1))
                                            </span>

                                            <div class="member-main">
                                                <span class="member-name">@member.Name</span>
                                                <span class="role-chip @(member.IsCreator ? "role-creator" : member.IsAdmin ? "role-admin" : "role-member")">
                                                    @(member.IsCreator ? "سازنده" : member.IsAdmin ? "ادمین" : "عضو")
                                                </span>
                                            </div>

                                            <div class="member-actions">
                                                @if (SelectedGroup.channel.CreatorId == member.Id)
                                                {
                                                }
                                                else if (SelectedGroup.channel.CreatorId == CurrentUser.Id && member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveModerator"
                                                                   Color="Color.Warning"
                                                                   Size="Size.Small"
                                                                   Title="حذف دسترسی ادمین"
                                                                   OnClick="()=>RemoveGroupAdmin(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از گروه"
                                                                   OnClick="()=>RemoveGroupMember(member)" />
                                                }
                                                else if (SelectedGroup.channel.CreatorId == CurrentUser.Id && !member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   Title="ارتقا به ادمین"
                                                                   OnClick="()=>PromoteToAdminGroupAsync(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از گروه"
                                                                   OnClick="()=>RemoveGroupMember(member)" />
                                                }
                                                else if (isAdminGroup() && !member.IsAdmin)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   Title="ارتقا به ادمین"
                                                                   OnClick="()=>PromoteToAdminGroupAsync(member)" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Title="حذف از گروه"
                                                                   OnClick="()=>RemoveGroupMember(member)" />
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="mini-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.Group" />
                                        <span>هنوز عضوی اضافه نشده است</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="فایل‌ها" OnClick="InitializeGroupAssets">
                        <div class="tab-body">
                            <div class="section-head">
                                <span class="section-title">فایل‌های ارسالی</span>
                                @if (ChannelFileItems.Any())
                                {
                                    <MudTextField T="string"
                                                  Value="_fileSearch"
                                                  ValueChanged="OnFileSearchChanged"
                                                  Placeholder="جستجوی فایل"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                                  Immediate="true"
                                                  Class="mini-search" />
                                }
                            </div>

                            <div class="scroll-list">
                                @if (FilteredChannelFileItems.Any())
                                {
                                    @foreach (var file in FilteredChannelFileItems)
                                    {
                                        <div class="file-row">
                                            <span class="file-icon">
                                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" />
                                            </span>
                                            <div class="file-main">
                                                <span class="file-name">@file.FileName</span>
                                                <span class="file-ext">@(System.IO.Path.GetExtension(file.FileName)?.TrimStart('.').ToUpperInvariant())</span>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => DownloadGroupFile(file)"
                                                           Title="دانلود" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="mini-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.FolderOff" />
                                        <span>فایلی برای نمایش نیست</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>

                </MudTabs>
            </section>

        </div>
    }

    @* ==================== USER ==================== *@
    else
    {
        <div class="profile-scroll">

            <div class="hero">
                <div class="hero-media">
                    @if (TargetUserInfoResponse.Avatar != null)
                    {
                        <MudImage Src="@($"{SiteSettings.ApiUrl}{TargetUserInfoResponse.Avatar}")"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="hero-img"
                                  @onclick="OpenPictureDialog" />
                    }
                    else if (MyAvatar != null && ChosenUser == null)
                    {
                        <MudImage Src="@($"{SiteSettings.ApiUrl}{MyAvatar}")"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="hero-img"
                                  @onclick="OpenPictureDialog" />
                    }
                    else
                    {
                        <MudImage Src="lib/assets/Images/avatar.jpg"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="hero-img is-static" />
                    }
                    <span class="hero-scrim"></span>
                </div>

                @if (IsOnline)
                {
                    <span class="hero-badge @(IsBlocked ? "is-blocked" : "is-online")">
                        <span class="badge-dot"></span> @(IsBlocked ? "مسدود شده" : "آنلاین")
                    </span>
                }
                else if (CurrentUser != null)
                {
                    @if (CurrentUser.Id == TargetUserInfoResponse.Id)
                    {
                        <span class="hero-badge is-online">
                            <span class="badge-dot"></span> آنلاین
                        </span>
                    }
                    else
                    {
                        <span class="hero-badge @(IsBlocked ? "is-blocked" : "is-offline")">
                            <span class="badge-dot"></span> @(IsBlocked ? "مسدود شده" : "آفلاین")
                        </span>
                    }
                }

                @if (CurrentUser != null)
                {
                    <div class="hero-camera">
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Disabled="@(IsSelectedFile)">
                            <ActivatorContent>
                                <MudIconButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Title="تغییر تصویر پروفایل"
                                               Icon="@Icons.Material.Filled.PhotoCamera" />
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>
                }
            </div>

            <div class="identity">
                <h2 class="identity-name">@TargetUserInfoResponse.Name</h2>
            </div>

            @if (CurrentUser != null)
            {
                <section class="section-card">
                    <div class="section-head">
                        <span class="section-title">بیوگرافی</span>
                        @if (CurrentUser.Id == TargetUserInfoResponse.Id && !ClickOnBioEdited)
                        {
                            <MudIconButton OnClick="()=>ClickOnBioEdited=true"
                                           Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Edit"
                                           Title="ویرایش بیوگرافی"
                                           Class="ghost-btn" />
                        }
                    </div>

                    @if (CurrentUser.Id == TargetUserInfoResponse.Id && ClickOnBioEdited)
                    {
                        <div class="inline-edit">
                            <MudTextField @bind-Value="bio"
                                          Placeholder="چند خط درباره خودت بنویس"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          AutoGrow
                                          MaxLines="4"
                                          Class="edit-field" />
                            <MudIconButton OnClick="SubmitBio" Size="Size.Small" Icon="@Icons.Material.Filled.Check" Title="ذخیره" Color="Color.Success" />
                            <MudIconButton OnClick="()=>ClickOnBioEdited=false" Size="Size.Small" Icon="@Icons.Material.Filled.Close" Title="انصراف" Color="Color.Error" />
                        </div>
                    }
                    else
                    {
                        <p class="body-text @(string.IsNullOrWhiteSpace(TargetUserInfoResponse.bio) ? "is-placeholder" : "")">
                            @(string.IsNullOrWhiteSpace(TargetUserInfoResponse.bio) ? "بیوگرافی ثبت نشده است" : TargetUserInfoResponse.bio)
                        </p>
                    }
                </section>

                <section class="section-card">
                    <div class="section-head">
                        <span class="section-title">اطلاعات تماس</span>
                    </div>

                    <!-- ایمیل -->
                    @if (CurrentUser.Id == TargetUserInfoResponse.Id && ChangeEmailToInput)
                    {
                        <div class="inline-edit">
                            <MudTextField @bind-Value="ChangeEmail"
                                          Placeholder="ایمیل جدید"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="edit-field" />
                            <MudIconButton OnClick="SubmitEmail" Size="Size.Small" Icon="@Icons.Material.Filled.Check" Title="ثبت ایمیل" Color="Color.Success" />
                            <MudIconButton OnClick="()=>ChangeEmailToInput=false" Size="Size.Small" Icon="@Icons.Material.Filled.Close" Title="انصراف" Color="Color.Error" />
                        </div>
                    }
                    else
                    {
                        <div class="info-row">
                            <span class="info-icon"><MudIcon Icon="@Icons.Material.Filled.Email" /></span>
                            <div class="info-body">
                                <span class="info-label">ایمیل</span>
                                <span class="info-value @(string.IsNullOrEmpty(TargetUserInfoResponse.Email) ? "is-placeholder" : "")">
                                    @(string.IsNullOrEmpty(TargetUserInfoResponse.Email) ? "ثبت نشده" : TargetUserInfoResponse.Email)
                                </span>
                            </div>
                            @if (CurrentUser.Id == TargetUserInfoResponse.Id)
                            {
                                <MudIconButton @onclick="()=>ChangeEmailToInput=true"
                                               Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Edit"
                                               Title="ویرایش ایمیل"
                                               Class="ghost-btn" />
                            }
                        </div>
                    }

                    <!-- شهر -->
                    @if (CurrentUser.Id == TargetUserInfoResponse.Id && ChangeCityToInput)
                    {
                        <div class="inline-edit">
                            <MudTextField @bind-Value="ChangeCity"
                                          Placeholder="شهر جدید"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="edit-field" />
                            <MudIconButton OnClick="SubmitCity" Size="Size.Small" Icon="@Icons.Material.Filled.Check" Title="ثبت شهر" Color="Color.Success" />
