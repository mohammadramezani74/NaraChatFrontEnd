@code {

    private List<UserChannelDto> AllChannelUsers = new();

    [Parameter] public List<UserDto> AllUsers { get; set; } = new();

    private async Task OpenManageAdminsDialog()
    {
        foreach (var item in AllUsers)
        {
            AllChannelUsers.Add(new UserChannelDto
            {Id=item.Id,
                IsAdmin=false,
                Name=item.Name

            });
        }
        var parameters = new DialogParameters
        {
            ["AllUsers"] = AllChannelUsers,
            ["CurrentAdmins"] = SelectedChannel.channel.admins,

        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = dialogService.Show<ManageAdminsDialog>("مدیریت ادمین‌ها", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var selected = (UserChannelDto)result.Data;

            await _channelService.PromoteToAdminOrDemoteUser(new ChangeUserChannelPolicyCommand
                (SelectedChannel.Id, selected.Id, true));

            SelectedChannel.channel.admins.Add(selected);
        }
    }

    private void EditAdmin(UserChannelDto admin)
    {
        // منطق ویرایش ادمین (مثلا تغییر نقش)
    }

    private async Task RemoveAdmin(UserChannelDto admin)
    {
        var result = await _channelService.PromoteToAdminOrDemoteUser(
        new ChangeUserChannelPolicyCommand(SelectedChannel.Id,admin.Id,false));
        SelectedChannel.channel.admins.Remove(admin);
        StateHasChanged();
    }
        private async Task CopyUserName()
    {
        if (SelectedChannel?.UserName == null) return;
        await js.InvokeVoidAsync("copyToClipboard", $"@{SelectedChannel.UserName}");
        snackbar.Add("کپی شد", Severity.Success);
    }
}
@code {
    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeChanging { get; set; }
    [Parameter]
    public UserDto? ChosenUser { get; set; }

    public bool IsBlocked { get; set; } = false;
    public TargetUserInfoResponse TargetUserInfoResponse { get; set; } = new();
    public PrivateConversationDto? Conversation { get; set; } = new();
    public UserDto CurrentUser { get; set; }
    private IBrowserFile? fileInfo;
    private bool IsSelectedFile = false;
    public bool IsOnline { get; set; }
    public bool ClickOnBioEdited { get; set; }
    public string? bio { get; set; } = string.Empty;
    public bool MouseOnEmail { get; set; }
    public bool MouseOnphone { get; set; }
    public bool MouseOnLocation { get; set; }
    public Color BadgeColor{ get; set; }
    public string BadgeTitle { get; set; }
    [Parameter]
    public string? MyAvatar { get; set; }
    [Parameter]
    public EventCallback<UserDto> OnPictureChanged { get; set; }
    [Parameter]
    public EventCallback<UserDto> OnClearChosenUser { get; set; }
    [Parameter]
    public EventCallback<UserDto> OnBlockedUser { get; set; }
    [Parameter]
    public UserDto? SelectedChannel { get; set; }
    private Guid? lastUserId;

    protected override async Task OnParametersSetAsync()
    {
        if (ChosenUser is not null && ChosenUser.Id != lastUserId)
        {
            IsOnline = ChosenUser.IsOnline;
            TargetUserInfoResponse = await userService.GetUserInfo(ChosenUser.Id);
            TargetUserInfoResponse.Avatar = ChosenUser?.avatar;
            lastUserId = ChosenUser.Id;

            TargetUserInfoResponse.Avatar=await userService.GetAvatar(ChosenUser.Id);
            Conversation = await ConversationService.ReadyOrCreateConversationBy(ChosenUser.Id);
            StateHasChanged();
            IsBlocked = ChosenUser.IsBlocked;
            await OnBlockedUser.InvokeAsync(ChosenUser);


        }
    }


    protected async override Task OnInitializedAsync()
    {
        CurrentUser = await ((CustomAuthenticationStateProvider)stateprovider).GetUserInfoAsync();

        if (ThemeChanging.IsShowSetting && ChosenUser==null)
        {
            TargetUserInfoResponse = await userService.GetUserInfo(CurrentUser.Id);
            ChosenUser = null;
            MyAvatar = await userService.GetAvatar(CurrentUser.Id);
            StateHasChanged();

        }



    }
    public async Task UploadFiles(IBrowserFile file)
    {
        IsSelectedFile = true;
        var extensiond = Path.GetExtension(file.Name);
        var contentType = file.ContentType;
        var result = await userService.UploadNewProfileImage(new StreamContent(file.OpenReadStream(50000000000)), contentType, extensiond);
        if(result.success){
            SuccessMessage();
            TargetUserInfoResponse.Avatar = result.Message;
            CurrentUser.avatar = result.Message;
            await OnPictureChanged.InvokeAsync(CurrentUser);
            StateHasChanged();
            await js.InvokeVoidAsync("localStorage.removeItem", "userAvatar");
            await js.InvokeVoidAsync("localStorage.removeItem", "userAvatarTime");

        }
        else{
            snackbar.Add(result.Message, Severity.Error);
        }
        IsSelectedFile = false;
    }
    public async Task SubmitBio(){
        var result = await userService.SubmitBio(bio);
        if(result.success){
            SuccessMessage();
            TargetUserInfoResponse.bio = result.Message;
            ClickOnBioEdited = false;
        }
    }
        public async Task ChangeBio(){
        var result = await _channelService.ChangeDescription(new ChangeBioChannelCommand(SelectedChannel.Id,bio));
        if(result.issuccess){
            SuccessMessage();
         
            ClickOnBioEdited = false;
        }
    }
    public async Task BlockedUser()
    {
        IsBlocked= !IsBlocked;
        ChosenUser.IsBlocked = IsBlocked;
        if (Conversation != null)
        {
            await ConversationService.BlockedConversation(IsBlocked, Conversation.id);
            await OnBlockedUser.InvokeAsync(ChosenUser);
            StateHasChanged();
        }
  
    }
    public async ValueTask DisposeAsync(){
        ChosenUser = null;
        await OnClearChosenUser.InvokeAsync(ChosenUser);
        IsOnline = true;
        GC.Collect();
        StateHasChanged();
    }
    private void SuccessMessage(){
        snackbar.Clear();
        snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        snackbar.Add("عملیات با موفقیت انجام شد", Severity.Success);
    }
    private void ErrorMessage(string message)
    {
        snackbar.Clear();
        snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        snackbar.Add(message, Severity.Error);
    }
    public async Task OpenPictureDialog()
    {

        if (TargetUserInfoResponse.Avatar != null)
        {
            var parameters = new DialogParameters
{
    { "ImageData", TargetUserInfoResponse.Avatar }
};

            await dialogService.ShowAsync<ImageDialogComponent>("نمایش تصویر", parameters);
        }
    }

}
@code{
    bool ChangeEmailToInput = false;
    public string ChangeEmail { get; set; } = string.Empty;
    bool ChangePhoneToInput = false;
    public string Changephone { get; set; } = string.Empty;
    bool ChangeCityToInput = false;
    public string ChangeCity { get; set; } = string.Empty;
    public async Task SubmitEmail()
    {
        if (string.IsNullOrWhiteSpace(ChangeEmail))
        {
            ErrorMessage("لطفا ایمیل را وارد کنید!");
            return;
        }

        string emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(ChangeEmail, emailPattern))
        {
            ErrorMessage("فرمت ایمیل نامعتبر است!");
            return;
        }
        var result = await userService.SubmitEmail(ChangeEmail);
        if (result.success)
        {
            SuccessMessage();
            TargetUserInfoResponse.Email = result.Message;
            ChangeEmailToInput = false;
        }
    }
    public async Task SubmitPhone()
    {
        if (string.IsNullOrWhiteSpace(Changephone))
        {
            ErrorMessage("لطفا ایمیل را وارد کنید!");
            return;
        }

        string pattern = @"^09(1[2-9]|3[0-9]|2[1-3]|0[1-2])\d{7}$";
        if (!Regex.IsMatch(Changephone, pattern))
        {
            ErrorMessage("فرمت شماره همراه نامعتبر است!");
            return;
        }
        var result = await userService.SubmitPhone(Changephone);
        if (result.success)
        {
            SuccessMessage();
            TargetUserInfoResponse.phoneNumber = result.Message;
            ChangePhoneToInput = false;
        }
    }
    public async Task SubmitCity()
    {
        if (string.IsNullOrWhiteSpace(ChangeCity))
        {
            ErrorMessage("لطفا شهر خود را وارد کنید!");
            return;
        }

 
        var result = await userService.SubmitCity(ChangeCity);
        if (result.success)
        {
            SuccessMessage();
            TargetUserInfoResponse.Address = result.Message;
            ChangeCityToInput = false;
        }
    }
}
