    private List<UserChannelDto> MapUsersToChannelUsers(IEnumerable<UserDto> users)
      => users?.Select(u => new UserChannelDto { Id = u.Id, Name = u.Name }).ToList() ?? new();

    private void SyncChannelData()
    {
        var channelId = SelectedChannel?.Id;
        var channelChanged = channelId != _lastChannelId;
        var manualMembers = channelChanged
            ? new List<ChannelMemberViewModel>()
            : ChannelMembers.Where(m => m.IsManual).ToList();

        if (channelChanged)
        {
            ChannelMediaItems.Clear();
            ChannelFileItems.Clear();
            _channelAssetsInitialized = false;
        }

        if (SelectedChannel?.channel != null)
        {
            var updatedMembers = new List<ChannelMemberViewModel>
            {
                new ChannelMemberViewModel
                {
                    Id = SelectedChannel.channel.CreatorId,
                    Name = SelectedChannel.channel.Creator,
                    IsAdmin = true,
                    IsCreator = true
                }
            };

            if (SelectedChannel.channel.admins != null)
            {
                foreach (var admin in SelectedChannel.channel.admins)
                {
                    if (updatedMembers.Any(m => m.Id == admin.Id))
                    {
                        continue;
                    }

                    updatedMembers.Add(new ChannelMemberViewModel
                        {
                            Id = admin.Id,
                            Name = admin.Name,
                            IsAdmin = true
                        });
                }
            }

            foreach (var manual in manualMembers)
            {
                if (!updatedMembers.Any(m => m.Id == manual.Id))
                {
                    updatedMembers.Add(manual);
                }
            }

            ChannelMembers = updatedMembers;
        }
        else
        {
            ChannelMembers = manualMembers;
        }

        if (!_channelAssetsInitialized)
        {
            InitializeChannelAssets();
            _channelAssetsInitialized = true;
        }

        _lastChannelId = channelId;
    }
    private async Task InitializeChannelAssets()
    {
        var files = await _channelService.getChannelFiles(SelectedChannel.Id);

        ChannelFileItems = files;

    }
    private async Task InitializeGroupAssets()
    {
        var files = await ConversationService.getGroupFiles(SelectedGroup.Id);

        ChannelFileItems = files;

    }

    private string BuildDataUrl(string fileName, string content)
    {
        var extension = Path.GetExtension(fileName)?.ToLowerInvariant();
        var mimeType = extension switch
        {
            ".txt" => "text/plain",
            ".json" => "application/json",
            ".csv" => "text/csv",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));
        return $"data:{mimeType};base64,{base64}";
    }

