@code {
    private bool Label_Switch3{ get; set; }
    private List<UserChannelDto> AllChannelUsers = new();
    private int _channelManagementActiveTab;
    private List<ChannelMemberViewModel> ChannelMembers { get; set; } = new();
    private List<ChannelMediaItem> ChannelMediaItems { get; set; } = new();
    private List<ChannelFileItem> ChannelFileItems { get; set; } = new();
    private Guid? _lastChannelId;
    private bool _channelAssetsInitialized;

    [Parameter] public List<UserDto> AllUsers { get; set; } = new();
    public bool isAdmin() => SelectedChannel.channel.admins.Any(x => x.Id == CurrentUser.Id);

    private async Task OpenManageAdminsDialog()
    {
        AllChannelUsers = MapUsersToChannelUsers(AllUsers);
        var parameters = new DialogParameters
        {
            ["AllUsers"] = AllChannelUsers,
            ["CurrentAdmins"] = SelectedChannel.channel.admins,

        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = dialogService.Show<ManageAdminsDialog>("مدیریت ادمین‌ها", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var selected = (UserChannelDto)result.Data;

            await _channelService.PromoteToAdminOrDemoteUser(new ChangeUserChannelPolicyCommand
                (SelectedChannel.Id, selected.Id, true));

            SelectedChannel.channel.admins.Add(selected);
            SyncChannelData();
        }
    }
    public async Task PromoteToAdminAsync(ChannelMemberViewModel member)
    {
        await _channelService.PromoteToAdminOrDemoteUser(new ChangeUserChannelPolicyCommand
            (SelectedChannel.Id, member.Id, true));
        var membertarget = ChannelMembers.Where(x => x.Id == member.Id).First();
        membertarget.IsAdmin=true;
        StateHasChanged();
    }

    private void EditAdmin(UserChannelDto admin)
    {
        // منطق ویرایش ادمین (مثلا تغییر نقش)
    }
    private async Task OpenAddMemberDialog()
    {
        var availableUsers = MapUsersToChannelUsers(AllUsers.Where(u => !ChannelMembers.Any(m => m.Id == u.Id)));

        if (!availableUsers.Any())
        {
            snackbar.Add("کاربر جدیدی برای اضافه کردن وجود ندارد.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AvailableUsers"] = availableUsers,
            ["DialogLabel"] = "افزودن عضو به کانال"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = dialogService.Show<AddChannelMemberDialog>("افزودن عضو", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UserChannelDto selectedUser)
        {
            await AddMemberToChannelAsync(selectedUser);
            var userdto=new ChannelMemberViewModel
            {
              Id=selectedUser.Id,
              Name=selectedUser.Name,
              IsAdmin=false,


            };
            ChannelMembers.Add(userdto);
        }
    }
    private bool CanManageMembers =>
        SelectedChannel?.channel?.CreatorId == CurrentUser?.Id ||
        SelectedChannel?.channel?.CurrentUserAdmin == true;

    private bool HasAvailableUsersForChannel()
    {
        if (AllUsers is null || !AllUsers.Any())
        {
            return false;
        }

        return AllUsers.Any(u => !ChannelMembers.Any(m => m.Id == u.Id));
    }

    private async Task AddMemberToChannelAsync(UserChannelDto user)
    {
        if (ChannelMembers.Any(m => m.Id == user.Id))
        {
            snackbar.Add("این کاربر پیش‌تر عضو کانال شده است.", Severity.Warning);
            return;
        }
        var newmember = new AddNewMemberCommand(SelectedChannel.Id, user.Id);
        var success = await _channelService.AddNewMemberByAdmin(newmember);

        if (!success.status)
        {
            snackbar.Add("در افزودن عضو مشکلی رخ داد.", Severity.Error);
            return;
        }

        ChannelMembers.Add(new ChannelMemberViewModel
        {
            Id = user.Id,
            Name = user.Name,
            IsManual = true
        });

        snackbar.Add($"کاربر {user.Name} به کانال اضافه شد.", Severity.Success);
        SyncChannelData();
        StateHasChanged();
    }
    private async Task<bool> FakeAddMemberService(UserChannelDto user)
    {
        await Task.Delay(400);
        return true;
    }
    private List<UserChannelDto> MapUsersToChannelUsers(IEnumerable<UserDto> users)
      => users?.Select(u => new UserChannelDto { Id = u.Id, Name = u.Name }).ToList() ?? new();

    private void SyncChannelData()
    {
        var channelId = SelectedChannel?.Id;
        var channelChanged = channelId != _lastChannelId;
        var manualMembers = channelChanged
            ? new List<ChannelMemberViewModel>()
            : ChannelMembers.Where(m => m.IsManual).ToList();

        if (channelChanged)
        {
            ChannelMediaItems.Clear();
            ChannelFileItems.Clear();
            _channelAssetsInitialized = false;
        }

        if (SelectedChannel?.channel != null)
        {
            var updatedMembers = new List<ChannelMemberViewModel>
            {
                new ChannelMemberViewModel
                {
                    Id = SelectedChannel.channel.CreatorId,
                    Name = SelectedChannel.channel.Creator,
                    IsAdmin = true,
                    IsCreator = true
                }
            };

            if (SelectedChannel.channel.admins != null)
            {
                foreach (var admin in SelectedChannel.channel.admins)
                {
                    if (updatedMembers.Any(m => m.Id == admin.Id))
                    {
                        continue;
                    }

                    updatedMembers.Add(new ChannelMemberViewModel
                    {
                        Id = admin.Id,
                        Name = admin.Name,
                        IsAdmin = true
                    });
                }
            }

            foreach (var manual in manualMembers)
            {
                if (!updatedMembers.Any(m => m.Id == manual.Id))
                {
                    updatedMembers.Add(manual);
                }
            }

            ChannelMembers = updatedMembers;
        }
        else
        {
            ChannelMembers = manualMembers;
        }

        if (!_channelAssetsInitialized)
        {
            InitializeChannelAssets();
            _channelAssetsInitialized = true;
        }

        _lastChannelId = channelId;
    }
    private async Task InitializeChannelAssets()
    {
        var files =await _channelService.getChannelFiles(SelectedChannel.Id);

        ChannelFileItems = files;

    }

    private string BuildDataUrl(string fileName, string content)
    {
        var extension = Path.GetExtension(fileName)?.ToLowerInvariant();
        var mimeType = extension switch
        {
            ".txt" => "text/plain",
            ".json" => "application/json",
            ".csv" => "text/csv",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));
        return $"data:{mimeType};base64,{base64}";
    }

    private async Task DownloadFile(ChannelFileItem file)
    {
        var filestring = await _channelService.downloadChannelFile(file.Id);
        if (string.IsNullOrEmpty(filestring))
        {
            snackbar.Add("فایل مورد نظر یافت نشد");
            return;
        }

        await js.InvokeVoidAsync("triggerDownload", filestring, file.FileName,"application/octet-stream");
    }

    private async Task RemoveAdmin(ChannelMemberViewModel admin)
    {
        var result = await _channelService.PromoteToAdminOrDemoteUser(
        new ChangeUserChannelPolicyCommand(SelectedChannel.Id,admin.Id,false));
        var olderadmin=ChannelMembers.Where(x => x.Id == admin.Id).First();
        olderadmin.IsAdmin = false;
        StateHasChanged();
    }
    private async Task RemoveMember(ChannelMemberViewModel model)
    {
        var result = await _channelService.RemoveMemberFromChannel(model.Id, SelectedChannel.Id);
        if (result.status)
        {
            ChannelMembers.Remove(model);
            snackbar.Add("عضو مورد نظر با موفقیت حذف گردید", Severity.Success);
        }
        else
        {
                snackbar.Add("حذف کاربر مورد نظر با خطا مواجه شد", Severity.Error);
        }

    }
    private async Task CopyUserName()
    {
        if (SelectedChannel?.UserName == null) return;
        await js.InvokeVoidAsync("copyToClipboard", $"@{SelectedChannel.UserName}");
        snackbar.Add("کپی شد", Severity.Success);
    }
