@inject IUserChatService userService
@inject IConversationService conversationService;
@inject ISnackbar snackbar

<MudPaper Class="people-panel h-100 w-100 d-flex flex-column" Elevation="0">

    <!-- هدر ثابت: سوییچ تب‌ها + جستجو -->
    <div class="people-header">

        <div class="segmented" role="tablist">
            <button type="button"
                    role="tab"
                    class="seg-btn @(_activeTab==PeopleTab.Contacts ? "is-active" : "")"
                    @onclick="@(()=>SetTab(PeopleTab.Contacts))">
                مخاطبین
            </button>
            <button type="button"
                    role="tab"
                    class="seg-btn @(_activeTab==PeopleTab.Chats ? "is-active" : "")"
                    @onclick="@(()=>SetTab(PeopleTab.Chats))">
                چت‌های من
            </button>
        </div>

        @if (_activeTab == PeopleTab.Contacts)
        {
            <MudTextField @bind-Value="Search"
                          Placeholder="جستجوی مخاطب"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Class="search-field w-100"
                          @oninput="OnSearchInput" />
        }
        else
        {
            <MudTextField @bind-Value="ChatsSearch"
                          Placeholder="جستجو در چت‌ها"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Class="search-field w-100"
                          @oninput="OnChatsSearchInput" />
        }
    </div>

    <!-- لیست -->
    <div class="people-list flex-grow-1">
        @if (Loading)
        {
            @for (int i = 0; i < 8; i++)
            {
                <div class="chat-row is-skeleton">
                    <div class="row-avatar">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="44px" Height="44px" Animation="Animation.Wave" />
                    </div>
                    <div class="row-body">
                        <MudSkeleton Width="45%" Height="12px" Animation="Animation.Wave" />
                        <MudSkeleton Width="70%" Height="10px" Animation="Animation.Wave" />
                    </div>
                </div>
            }
        }
        else
        {
            <Virtualize Items="@GetActiveItems()" Context="user" OverscanCount="4" ItemSize="72">
                <ItemContent>
                    <div @key="@(user.Id+user.Name)"
                         class="chat-row @(user.IsSelected ? "is-selected" : "") @(user.messageUnreadedCount > 0 ? "is-unread" : "")"
                         style="@(user.IsSelected ? $"background-color:{chooseColor()};" : "")"
                         title="برای سنجاق‌کردن دوبار کلیک کنید"
                         @onclick="()=>HandleUserClick(user)"
                         @ondblclick="()=>PinUser(user)">

                        <div class="row-avatar">
                            <MudAvatar Size="Size.Medium"
                                       Class="@(user.IsChannel ? "channel-shadow" : user.IsGroup ? "group-shadow" : "")">
                                @if (user.IsGroup)
                                {
                                    <MudImage Src="@(user.avatar != null
                                                   ? $"{SiteSettings.ApiUrl}{user.avatar}"
                                                   : "lib/assets/Images/group2.svg")"
                                              Class="rounded-circle"
                                              Style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <MudImage Src="@(user.avatar != null
                                                   ? $"{SiteSettings.ApiUrl}{user.avatar}"
                                                   : $"lib/assets/Images/{GetImageName(user.IsChannel)}")"
                                              Class="rounded-circle"
                                              Style="width:100%; height:100%; object-fit:cover;" />
                                }
                            </MudAvatar>

                            @if (user.IsOnline)
                            {
                                <span class="presence-dot"></span>
                            }
                        </div>

                        <div class="row-body">

                            <div class="row-line">
                                <div class="row-name">
                                    <span class="name-text">@((MarkupString)RenderNameHighlighted(user.Name))</span>

                                    @if (user.IsChannel)
                                    {
                                        <MudImage Src="lib/assets/Images/logogo.svg" Alt="کانال" Class="type-badge" />
                                    }
                                    else if (user.IsGroup)
                                    {
                                        <MudImage Src="lib/assets/Images/group.svg" Alt="گروه" Class="type-badge" />
                                    }

                                    @if (user.IsPin)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Class="pin-icon" />
                                    }
                                </div>

                                <span class="row-time">@user.LastReceivedMessageSendDate</span>
                            </div>

                            <div class="row-line">
                                <p class="row-message" style="@GetLastMessageStyle(user)">
                                    @((MarkupString)RenderMessageHighlighted(user.LastReceivedMessage))
                                </p>

                                @if (user.messageUnreadedCount > 0)
                                {
                                    <span class="unread-pill">@GetUnreadCap(user.messageUnreadedCount)</span>
                                }
                            </div>

                        </div>
                    </div>
                </ItemContent>

                <Placeholder>
                    @for (int i = 0; i < 8; i++)
                    {
                        <div class="chat-row is-skeleton">
                            <div class="row-avatar">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="44px" Height="44px" Animation="Animation.Wave" />
                            </div>
                            <div class="row-body">
                                <MudSkeleton Width="45%" Height="12px" Animation="Animation.Wave" />
                                <MudSkeleton Width="70%" Height="10px" Animation="Animation.Wave" />
                            </div>
                        </div>
                    }
                </Placeholder>

                <EmptyContent>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <MudIcon Icon="@(_activeTab == PeopleTab.Chats ? Icons.Material.Outlined.ChatBubbleOutline : Icons.Material.Outlined.PersonSearch)"
                                     Size="Size.Large" />
                        </div>
                        <span class="empty-title">
                            @(_activeTab == PeopleTab.Chats ? "هنوز گفتگویی ندارید" : "مخاطبی پیدا نشد")
                        </span>
                        <span class="empty-text">
                            @(_activeTab == PeopleTab.Chats
                                ? "از تب مخاطبین یک نفر را انتخاب کنید و گفتگو را شروع کنید"
                                : "نام دیگری را جستجو کنید")
                        </span>
                    </div>
                </EmptyContent>
            </Virtualize>
        }
    </div>
</MudPaper>

<style>
    /* ---------- پنل ---------- */
    .people-panel {
        background: var(--mud-palette-surface);
        overflow: hidden;
    }

    /* ---------- هدر ثابت ---------- */
    .people-header {
        position: sticky;
        top: 0;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px 12px 10px;
        background: var(--mud-palette-surface);
        border-bottom: 1px solid var(--mud-palette-divider);
        flex-shrink: 0;
    }

    /* سوییچ تب‌ها */
    .segmented {
        display: flex;
        gap: 2px;
        padding: 3px;
        border-radius: 999px;
        background: var(--mud-palette-background-gray);
        border: 1px solid var(--mud-palette-divider);
    }

    .seg-btn {
        flex: 1 1 0;
        border: 0;
        outline: 0;
        cursor: pointer;
        padding: 7px 10px;
        border-radius: 999px;
        background: transparent;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        transition: background .18s ease, color .18s ease;
    }

        .seg-btn:hover {
            color: var(--mud-palette-text-primary);
        }

        .seg-btn.is-active {
            background: var(--mud-palette-surface);
            color: var(--mud-palette-primary);
            box-shadow: 0 1px 4px rgba(0,0,0,.12);
        }

        .seg-btn:focus-visible {
            box-shadow: 0 0 0 2px var(--mud-palette-primary);
        }

    /* جستجو */
    .search-field .mud-input.mud-input-outlined {
        border-radius: 999px;
        background: var(--mud-palette-background-gray);
    }

    .search-field .mud-input-outlined-border {
        border-radius: 999px !important;
        border-color: var(--mud-palette-divider);
    }

    .search-field .mud-input-slot {
        font-size: 13px;
    }

    /* ---------- لیست ---------- */
    .people-list {
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
    }

        .people-list::-webkit-scrollbar {
            width: 6px;
        }

        .people-list::-webkit-scrollbar-thumb {
            background: var(--mud-palette-divider);
            border-radius: 999px;
        }

    /* ---------- سطر گفتگو ---------- */
    .chat-row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 72px;
        padding: 0 12px;
        cursor: pointer;
        user-select: none;
        transition: background-color .15s ease;
    }

        .chat-row::after { /* خط جداکننده، هم‌تراز با متن */
            content: "";
            position: absolute;
            bottom: 0;
            inset-inline-start: 66px;
            inset-inline-end: 12px;
            height: 1px;
            background: var(--mud-palette-divider);
        }

        .chat-row:last-child::after {
            display: none;
        }

        .chat-row:hover {
            background-color: var(--mud-palette-action-default-hover);
        }

        .chat-row.is-selected::before { /* نوار رنگی سطر فعال */
            content: "";
            position: absolute;
            inset-block: 0;
            inset-inline-start: 0;
            width: 3px;
            background: var(--mud-palette-primary);
        }

        .chat-row.is-skeleton {
            cursor: default;
        }

    /* آواتار */
    .row-avatar {
        position: relative;
        flex-shrink: 0;
        line-height: 0;
    }

    .presence-dot {
        position: absolute;
        bottom: 1px;
        inset-inline-end: 1px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: #22c55e;
        border: 2px solid var(--mud-palette-surface);
    }

    /* حلقه‌ی تفکیک کانال و گروه (به‌جای هاله‌ی پررنگ قبلی) */
    .channel-shadow {
        box-shadow: 0 0 0 2px var(--mud-palette-surface), 0 0 0 4px #594ae2;
    }

    .group-shadow {
        box-shadow: 0 0 0 2px var(--mud-palette-surface), 0 0 0 4px #38bd95;
    }

    /* بدنه‌ی سطر */
    .row-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .row-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
    }

    .row-name {
        display: flex;
        align-items: center;
        gap: 4px;
        min-width: 0;
    }

    .name-text {
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.5;
        color: var(--mud-palette-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .is-unread .name-text {
        font-weight: 700;
    }

    .type-badge {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        opacity: .85;
    }

    .pin-icon {
        font-size: 14px !important;
        flex-shrink: 0;
        color: var(--mud-palette-text-secondary);
    }

    .row-time {
        flex-shrink: 0;
        font-size: 10px;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
    }

    .row-message {
        margin: 0;
        min-width: 0;
        flex: 1 1 auto;
        font-size: 11.5px;
        line-height: 1.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .is-unread .row-message {
        font-weight: 600;
    }

    .unread-pill {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--mud-palette-error);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
    }

    /* هایلایت نتیجه‌ی جستجو */
    mark {
        background-color: var(--mud-palette-primary);
        color: #fff;
        padding: 0 2px;
        border-radius: 3px;
    }

    /* ---------- حالت خالی ---------- */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 48px 24px;
        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        margin-bottom: 6px;
        border-radius: 50%;
        background: var(--mud-palette-background-gray);
        color: var(--mud-palette-text-secondary);
    }

    .empty-title {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--mud-palette-text-primary);
    }

    .empty-text {
        font-size: 11.5px;
        line-height: 1.9;
        max-width: 240px;
        color: var(--mud-palette-text-secondary);
    }

    /* ---------- ریسپانسیو و دسترسی‌پذیری ---------- */
    @@media (max-width: 600px) {
        .people-header {
            padding: 10px 10px 8px;
        }

        .chat-row {
            padding: 0 10px;
        }

            .chat-row::after {
                inset-inline-start: 62px;
                inset-inline-end: 10px;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .chat-row, .seg-btn {
            transition: none;
        }
    }
</style>

@code {
    // تب‌ها (فقط منطق)
    private enum PeopleTab { Contacts, Chats }

    // تب پیش‌فرض: چت‌های من
    private PeopleTab _activeTab = PeopleTab.Chats;

    private void SetTab(PeopleTab t) { _activeTab = t; StateHasChanged(); }

    // لیست فعال بر اساس تب
    private List<UserDto> GetActiveItems()
        => _activeTab == PeopleTab.Contacts
           ? GetAllUsersView().ToList()
           : GetMyChatsView().ToList();

    Guid? selectedUserId = null;
    [Parameter] public IEnumerable<UserDto> Users { get; set; } = Enumerable.Empty<UserDto>();
    public List<UserDto> AllUsers { get; set; } = new();
    [Parameter] public bool Loading { get; set; } = true;
    [Parameter] public EventCallback<UserDto> OnUserSelected { get; set; }
    [Parameter] public EventCallback<UserDto> OnOtherUserSelected { get; set; }
    [Parameter] public EventCallback<UserDto> NullIncommengMessage { get; set; }

    [Parameter] public List<ChatMessageDto> MissedMessageCount { get; set; } = new List<ChatMessageDto>();
    [Parameter] public EventCallback ReeadMissedMessage { get; set; }
    [Parameter] public ChatMessageDto? newIncomingMessage { get; set; }

    public bool HaveFilter { get; set; } = false;

    // سرچ مخاطبین (با دی‌بونس)
    private string search;
    private System.Threading.Timer? _searchTimer;
    private string Search
    {
        get => search;
        set { search = value; }
    }
    private void OnSearchInput(ChangeEventArgs e)
    {
        Search = e?.Value?.ToString() ?? string.Empty;
        _searchTimer?.Dispose();
        _searchTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);

        }, null, 300, System.Threading.Timeout.Infinite);
    }

    // سرچ «چت‌های من» (با دی‌بونس)
    private string chatsSearch;
    private System.Threading.Timer? _chatsTimer;
    private string ChatsSearch
    {
        get => chatsSearch;
        set { chatsSearch = value; }
    }
    private void OnChatsSearchInput(ChangeEventArgs e)
    {
        ChatsSearch = e?.Value?.ToString() ?? string.Empty;
        _chatsTimer?.Dispose();
        _chatsTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    public async Task HandleUserClick(UserDto user)
    {
        AllUsers.ToList().ForEach(x => x.IsSelected = false);
        user.messageUnreadedCount = 0;
        user.IsSelected = true;
        await OnUserSelected.InvokeAsync(user);
        await HandleAnotherUserClick(user);
    }
    public async Task HandleAnotherUserClick(UserDto user)
    {
        await OnOtherUserSelected.InvokeAsync(user);
    }
}

@code {
    public static string GetImageName(bool ischannel)
    {
        if (!ischannel) return "avatar.jpg";
        return "chanel.png";
    }
    [CascadingParameter(Name = "Theme")] public ThemeChanging themeChanging { get; set; }
    private bool IsUserInfoVisible = true;
    public string chooseColor() => themeChanging.ClockColor == "#270aff" ? "#fff3f3" : "rgb(21 49 76 / 86%)";
    private void ToggleUserInfo() => IsUserInfoVisible = !IsUserInfoVisible;

    private async Task SearchUsers()
    {
        if (!string.IsNullOrWhiteSpace(Search))
        {
            HaveFilter = true;
            AllUsers = Users.Where(x => x.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else
        {
            HaveFilter = false;
            AllUsers = Users.ToList();
        }
        StateHasChanged();
    }

    public string GetLastMessageStyle(UserDto user)
    {
        if (user.IsLastReceivedMessageForMe) return "font-size:10px;color:gray";
        else return $"font-size:10px;color:{themeChanging.ClockColor}";
    }

    protected override async Task OnParametersSetAsync()
    {
        // 1) مقداردهی اولیه AllUsers فقط وقتی لازم است + دِداپ بر اساس Id
        if (!HaveFilter && !AllUsers.Any())
        {
            AllUsers = Users
                .Where(u => u != null && u.Id != Guid.Empty)
                .GroupBy(u => u.Id)
                .Select(g => g.First()) // اگر تکراری بود، اولین مورد نگه داشته می‌شود
                .OrderByDescending(c => c.IsPin)
                .ThenByDescending(x => x.LastMessageDate)
                .ThenBy(c => c.IsChannel)

                .ThenByDescending(u => u.messageUnreadedCount > 0)
                .ToList();
        }

        // 2) اعمال MissedMessageCount (با نال‌چک و امن در برابر تکراری‌ها)
        if (MissedMessageCount != null && MissedMessageCount.Count > 0)
        {
            var groupedMissed = MissedMessageCount
                .GroupBy(m => m.UserId)
                .ToDictionary(
                    g => g.Key,
                    g => new
                    {
                        Count = g.Count(),
                        Last = g.OrderByDescending(x => x.SendAt).FirstOrDefault()
                    }
                );

            // دیکشنری امن: اگر تکراری باشد، آخرین آیتم روی قبلی overwrite می‌کند
            var usersDictionary = new Dictionary<Guid, UserDto>();
            foreach (var u in Users.Where(u => u != null && u.Id != Guid.Empty))
                usersDictionary[u.Id] = u;

            foreach (var (userId, info) in groupedMissed)
            {
                if (usersDictionary.TryGetValue(userId, out var targetUser) && info.Last != null)
                {
                    // فقط وقتی آی‌دی آخرین پیام عوض شده، شمارش را به‌روزرسانی کن
                    if (info.Last.Id != targetUser.LastReceivedMessageId)
                        targetUser.messageUnreadedCount = info.Count;

                    // متن و تاریخ آخرین پیام
                    if (!string.IsNullOrWhiteSpace(info.Last.Content))
                        targetUser.LastReceivedMessage = info.Last.Content;

                    targetUser.LastReceivedMessageSendDate = info.Last.SendAt.FormatPersianDate().ToPersianNumber();
                    targetUser.LastReceivedMessageId = info.Last.Id;
                }
            }

            await ReeadMissedMessage.InvokeAsync();
            StateHasChanged();
        }

        // 3) پیام تازه‌ی ورودی از هاب/سرور
        if (newIncomingMessage != null)
        {
            var user = Users.FirstOrDefault(x => x.Id == newIncomingMessage.UserId);
            if (user != null)
            {
                user.LastReceivedMessage = (newIncomingMessage.Content ?? string.Empty).TruncateMessage();
                user.LastReceivedMessageId = newIncomingMessage.Id;
                user.IsLastReceivedMessageForMe = newIncomingMessage.IsMine;
                user.LastReceivedMessageSendDate = newIncomingMessage.SendAt.FormatPersianDate().ToPersianNumber();
            }

            await NullIncommengMessage.InvokeAsync();
            StateHasChanged();
        }
        AllUsers = AllUsers.OrderByDescending(x => x.LastMessageDate).ToList();
        StateHasChanged();
    }


    // منبع «چت‌های من»: فیلتر + سرچ جدا (ChatsSearch) — بدون دست‌زدن به AllUsers
    private IEnumerable<UserDto> GetMyChatsView()
    {
        IEnumerable<UserDto> list = Users
            .Where(u => u.messageUnreadedCount > 0
                     || u.LastReceivedMessageId != null
                     || !string.IsNullOrWhiteSpace(u.LastReceivedMessage) ||
            u.IsChannel || u.IsGroup).OrderByDescending(x => x.LastMessageDate);
        var list2 = Users
       .Where(u => u.messageUnreadedCount > 0
                || u.LastReceivedMessageId != null
                || !string.IsNullOrWhiteSpace(u.LastReceivedMessage) ||
       u.IsChannel || u.IsGroup).OrderByDescending(x => x.LastMessageDate).ToList();

        if (!string.IsNullOrWhiteSpace(ChatsSearch))
        {
            var k = ChatsSearch.Trim();
            list = list.Where(x => x.Name.Contains(k, StringComparison.OrdinalIgnoreCase)
                                || (!string.IsNullOrWhiteSpace(x.LastReceivedMessage)
                                    && x.LastReceivedMessage.Contains(k, StringComparison.OrdinalIgnoreCase)));
        }

        list = list
            .OrderByDescending(c => c.IsPin)
            .ThenByDescending(c => c.messageUnreadedCount > 0)
            .ThenByDescending(c => c.LastMessageDate) // اگر تاریخ متن فارسیه، بهتره DateTime جدا داشته باشه
            .ToList();
        return list.GroupBy(x => x.Id).Select(x => x.First()).ToList();
    }
    private IEnumerable<UserDto> GetAllUsersView()
    {
        var list = Users.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var k = Search.Trim();
            list = list.Where(x =>
                (!string.IsNullOrWhiteSpace(x.Name) && x.Name.Contains(k, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.LastReceivedMessage) && x.LastReceivedMessage.Contains(k, StringComparison.OrdinalIgnoreCase))
            );
        }

        var mylist = list
            .OrderByDescending(c => c.IsPin)
            .ThenByDescending(c => c.messageUnreadedCount > 0)
            .ThenByDescending(c => c.LastMessageDate)   // اگر متن فارسیه، بهتره DateTime جدا داشته باشه
            .ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase)  // مرتب‌سازی پایانی با نام
           .GroupBy(x => x.Id)
           .Select(XAxisLabelPosition => XAxisLabelPosition.First())
            .ToList();
        return mylist.GroupBy(x => x.Id).Select(x => x.First()).ToList();
    }


    private string GetUnreadCap(int count) => count > 99 ? "99+" : count.ToString();


    private string RenderNameHighlighted(string text)
    {
        var q = _activeTab == PeopleTab.Contacts ? (Search ?? string.Empty) : (ChatsSearch ?? string.Empty);
        return Highlight(text, q);
    }

    private string RenderMessageHighlighted(string text)
    {
        var q = _activeTab == PeopleTab.Chats ? (ChatsSearch ?? string.Empty) : (Search ?? string.Empty);
        return Highlight(text ?? string.Empty, q);
    }


    private string Highlight(string source, string query)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(query))
            return System.Net.WebUtility.HtmlEncode(source);

        var src = source;
        var q = query.Trim();

        // جستجو بدون حساسیت به حروف
        var index = src.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (index < 0) return System.Net.WebUtility.HtmlEncode(src);

        // چندین occurrence را هایلایت کنیم
        var sb = new System.Text.StringBuilder();
        int last = 0;
        while (index >= 0)
        {
            sb.Append(System.Net.WebUtility.HtmlEncode(src.Substring(last, index - last)));
            sb.Append("<mark>");
            sb.Append(System.Net.WebUtility.HtmlEncode(src.Substring(index, q.Length)));
            sb.Append("</mark>");
            last = index + q.Length;
            index = src.IndexOf(q, last, StringComparison.OrdinalIgnoreCase);
        }
        if (last < src.Length)
            sb.Append(System.Net.WebUtility.HtmlEncode(src.Substring(last)));

        return sb.ToString();
    }

    private async Task PinUser(UserDto user)
    {
        var targetUser = AllUsers.FirstOrDefault(c => c.Id == user.Id);
        if (targetUser is null) return;

        var newPinStatus = !targetUser.IsPin;
        var pinnedUsers = AllUsers.Where(u => u.IsPin).Count();
        if (pinnedUsers >= 5 && newPinStatus == true)
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add("شما فقط امکان پین کردن سه کاربر را دارید", Severity.Error);
            return;
        }

        var result = await conversationService.PinConversation(newPinStatus, targetUser.ConversationId.Value);
        if (result.IsSuccess)
        {
            targetUser.IsPin = newPinStatus;
            AllUsers = AllUsers
                .OrderByDescending(c => c.IsPin)
                .ThenByDescending(x => x.LastMessageDate)
                .ThenByDescending(c => c.messageUnreadedCount > 0)
                .ToList();

            StateHasChanged();
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        }
        else
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add(result.Message, Severity.Error);
        }
    }
