@inject IUserChatService userService
@inject IConversationService conversationService;
@inject ISnackbar snackbar
<MudPaper Class="h-100 w-100 d-flex flex-column">

    <MudList T="string" Class="overflow-y-auto flex-grow-1" Style="max-height:100%;">
        @if (Loading)
        {
            <MudProgressCircular />
        }else{
            <MudListItem Class="py-3 px-2"
            Style="height:68px; margin-top: 10px;">

                <ChildContent>
                    <MudPaper Elevation="0" Class="pa-2 d-flex align-center" Style="border-radius: 12px;">
                        <MudTextField 
                        @bind-Value="Search"
                        Placeholder="جستجو کنید..."
                        Variant="Variant.Outlined"
                        Immediate="true"
                        Adornment="Adornment.End"
                        AdornmentIcon="@Icons.Material.Filled.Search"
                        AdornmentColor="Color.Primary"
                        Class="w-100"
                        @oninput="SearchUsers"
                        />
                    </MudPaper>
                </ChildContent>

            </MudListItem>
            <Virtualize  items="AllUsers.ToList()" Context="user"  OverscanCount="2" ItemSize="68">
                <ItemContent>
                    <MudListItem @ondblclick="()=>PinUser(user)"   @onclick="()=>HandleUserClick(user)"
                    Class=" py-3 px-2"
                    Style="@(user.IsSelected?$" height:73px;background-color:{chooseColor()};":"height:73px; ")">

                        <AvatarContent>
                            <MudBadge Dot="true" Color="@(user.IsOnline? Color.Success:Color.Default)" Class="mx-6 my-4">
                                <MudAvatar Size="Size.Medium">
                                    @if(user.avatar!=null){
                                        <MudImage Src="@($"data:image/png;base64,{user.avatar}")" Class="rounded-circle"
                                        Style="width:100%; height:100%; object-fit:inherit;" />
                                    }
                                    else{
                                        <MudImage Src="lib/assets/Images/avatar.jpg" Class="rounded-circle"
                                        Style="width:100%; height:100%; object-fit:inherit;" />
                                    }
                                </MudAvatar>
                            </MudBadge>
                        </AvatarContent>



                        <ChildContent>
                            <MudStack Row=false>
                                <MudStack Row="true">

                                    @if(user.messageUnreadedCount>0){
                                        <MudText Style="font-size:12px;">@user.Name</MudText>
                                        <MudBadge Content="user.messageUnreadedCount" Color="Color.Error" Overlap="true" Origin="Origin.TopRight" Class="mx-6 my-4">      </MudBadge>
                                    }
                                    else{
                                        <MudText Style="font-size:12px;">@user.Name</MudText>
                                    }
                                    @if (user.IsPin)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Color="Color.Error" Class="ms-1" Style="font-size:16px;" />
                                    }
                                </MudStack >
                                <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row="true">
                                    <p style="@GetLastMessageStyle(user)">@user.LastReceivedMessage</p>
                                    <p style="font-size:9px;color:silver" >@user.LastReceivedMessageSendDate</p>
                                </MudStack>
                            </MudStack>

                        </ChildContent>

                    </MudListItem> 
                </ItemContent>
                <Placeholder>
                    @for (int i = 0; i < 10; i++) 
                    {
                        <MudListItem Class="py-3 px-2" Style="height:73px;">
                            <AvatarContent>
                                <MudSkeleton Width="40px" Height="40px" Animation="Animation.Pulse" Class="mx-6 my-4 rounded-circle" />
                            </AvatarContent>
                            <ChildContent>
                                <MudStack Row="false" Class="w-full">
                                    <MudSkeleton Width="50%" Height="15px" Animation="Animation.Pulse" />
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="w-full">
                                        <MudSkeleton Width="30%" Height="10px" Animation="Animation.Pulse" />
                                        <MudSkeleton Width="20%" Height="10px" Animation="Animation.Pulse" />
                                    </MudStack>
                                </MudStack>
                            </ChildContent>
                        </MudListItem>
                    }
                </Placeholder>
                <EmptyContent>
                    <MudPaper Class="d-flex flex-column align-center justify-center p-6 my-4" Style="min-height:150px; background-color:#f9f9f9;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Color="Color.Dark" />
                        <MudText Typo="Typo.h6" Class="mt-2">هیچ کاربری برای نمایش وجود ندارد</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">لیست کاربران فعلاً خالی است</MudText>
                    </MudPaper>
                </EmptyContent>
            </Virtualize>


        }
    </MudList>


</MudPaper>

@code {
    Guid? selectedUserId = null;
    [Parameter]
    public IEnumerable<UserDto> Users { get; set; } = Enumerable.Empty<UserDto>();
    public List<UserDto> AllUsers { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; } = true;
    [Parameter]
    public EventCallback<UserDto> OnUserSelected { get; set; }
    [Parameter]
    public EventCallback<UserDto> OnOtherUserSelected { get; set; }
    [Parameter]
    public EventCallback<UserDto> NullIncommengMessage { get; set; }


    [Parameter]
    public List<ChatMessageDto> MissedMessageCount { get; set; } = new List<ChatMessageDto>();
    [Parameter]
    public EventCallback ReeadMissedMessage { get; set; }
    [Parameter]
    public ChatMessageDto? newIncomingMessage { get; set; }
    public bool HaveFilter { get; set; } = false;
    private string search;
    private string Search
    {
        get => search;
        set
        {
            search = value;
            SearchUsers(); 
        }
    }

    public async Task HandleUserClick(UserDto user)
    {

        AllUsers.ToList().ForEach(x => x.IsSelected = false);
        user.IsSelected = true;
        await OnUserSelected.InvokeAsync(user);
        await HandleAnotherUserClick(user);
    }
    public async Task HandleAnotherUserClick(UserDto user)
    {
        await OnOtherUserSelected.InvokeAsync(user);
    }


}

@code {
    [CascadingParameter(Name = "Theme")]
    public ThemeChanging themeChanging { get; set; }
    private bool IsUserInfoVisible = true;
    public string chooseColor() => themeChanging.ClockColor == "#270aff" ? "#fff3f3" : "rgb(21 49 76 / 86%)";

    private void ToggleUserInfo()
    {
        IsUserInfoVisible = !IsUserInfoVisible;
    }


    private async Task SearchUsers()
    {

        if (!string.IsNullOrWhiteSpace(Search))
        {
            HaveFilter = true;

            AllUsers = Users.Where(x => x.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else
        {

            HaveFilter = false;

            AllUsers = Users.ToList();
        }
        StateHasChanged();
    }
    public string GetLastMessageStyle(UserDto user)
    {
        if (user.IsLastReceivedMessageForMe)
        {
            return "font-size:10px;color:gray";
        }
        else
        {
            return $"font-size:10px;color:{themeChanging.ClockColor}";
        }

    }
    protected override async Task OnParametersSetAsync()
    {
        if (!HaveFilter&& AllUsers.Count()==0){
            AllUsers = Users
              .OrderByDescending(c => c.IsPin)
            .OrderByDescending(u => u.messageUnreadedCount > 0).ToList();
        }
        if (MissedMessageCount.Count > 0)
        {
            var groupedMissed = MissedMessageCount
                .GroupBy(m => m.UserId)
                .ToDictionary(g => g.Key, g => new 
                {
                    Count = g.Count(),
                    LastMessage = g.OrderByDescending(x => x.SendAt).FirstOrDefault()?.Content,
                    LastDate=g.OrderByDescending(x => x.SendAt).FirstOrDefault()?.SendAt,
                    LastId=g.OrderByDescending(x => x.SendAt).FirstOrDefault()?.Id,
                });

            var usersDictionary = Users.ToDictionary(u => u.Id);

            foreach (var (userId, info) in groupedMissed)
            {
                if (usersDictionary.TryGetValue(userId, out var targetUser))
                {
                    if(info.LastId!=targetUser.LastReceivedMessageId)
                        targetUser.messageUnreadedCount = info.Count;


                    if (!string.IsNullOrEmpty(info.LastMessage))
                    {
                        targetUser.LastReceivedMessage = info.LastMessage;
                        if (info.LastDate != null)
                            targetUser.LastReceivedMessageSendDate = info.LastDate.Value.FormatPersianDate().ToPersianNumber();
                    }
                }
            }

            await ReeadMissedMessage.InvokeAsync();
            StateHasChanged();
        }
        if (newIncomingMessage != null)
        {

            var user=   Users.Where(x => x.Id == newIncomingMessage.UserId).FirstOrDefault();
            if (user != null)
            {
                user.LastReceivedMessage = newIncomingMessage.Content.TruncateMessage();
                user.LastReceivedMessageId = newIncomingMessage.Id;
                user.IsLastReceivedMessageForMe = newIncomingMessage.IsMine;
                user.LastReceivedMessageSendDate = newIncomingMessage.SendAt.FormatPersianDate().ToPersianNumber();


                await  NullIncommengMessage.InvokeAsync();
                StateHasChanged();

            }
        }


    }
    private async Task PinUser(UserDto user)
    {
        var targetUser = AllUsers.FirstOrDefault(c => c.Id == user.Id);
        if (targetUser is null) return;

        var newPinStatus = !targetUser.IsPin;
        var pinnedUsers= AllUsers.Where(u => u.IsPin).Count();
        if (pinnedUsers >= 3 &&newPinStatus==true)
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add("شما فقط امکان پین کردن سه کاربر را دارید", Severity.Error);
            return;
        }

        var result = await conversationService.PinConversation(newPinStatus, targetUser.ConversationId.Value);
        if (result.IsSuccess)
        {
            targetUser.IsPin = newPinStatus;
            AllUsers = AllUsers
                .OrderByDescending(c => c.IsPin)
                .ThenByDescending(c =>c.messageUnreadedCount > 0) 
                .ToList();

            StateHasChanged();
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

        }
        else
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add(result.Message, Severity.Error);

    }
}

}

