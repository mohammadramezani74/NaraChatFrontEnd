@inject IJSRuntime js
<MudDialog>
    <DialogContent>
        <div style="display: flex; gap: 10px; justify-content: center; margin-top: 10px;">
            <MudButton OnClick="ZoomIn">🔍 زوم +</MudButton>
            <MudButton OnClick="ZoomOut">🔍 زوم -</MudButton>
            <MudButton OnClick="Rotate">↻ چرخش</MudButton>
            <MudButton OnClick="Flip">⇆ برگرداندن</MudButton>
            <MudIconButton  OnClick="Download">+ دانلود</MudIconButton>
        </div>
        <div style="max-width: 100%;height:auto; position: relative;">
          <img id="image" src="@ImageSrc" class="image" style="background-color: white;" />
        </div>

        <!-- دکمه‌ها -->

    </DialogContent>

</MudDialog>

@code {
    [Parameter]
    public string ImageData { get; set; } = string.Empty;
        /// <summary>
    /// آدرس تصویر. تصاویر با naraLoadImage به‌صورت object URL بارگذاری می‌شوند،
    /// پس اینجا هم همان آدرس می‌آید. قبلاً این پارامتر base64 می‌گرفت.
    /// </summary>
    [Parameter]
    public string ImageSrc { get; set; } = string.Empty;

    /// <summary>نام فایل برای ذخیره؛ اگر خالی باشد نام پیش‌فرض استفاده می‌شود.</summary>
    [Parameter]
    public string? FileName { get; set; }
    private async Task ZoomIn() => await js.InvokeVoidAsync("cropper.zoom", 0.1);
    private async Task ZoomOut() => await js.InvokeVoidAsync("cropper.zoom", -0.1);
    private async Task Rotate() => await js.InvokeVoidAsync("cropper.rotate", 90);
    private async Task Flip() => await js.InvokeVoidAsync("cropper.scaleX");
     private async Task Download()
    {
        if (string.IsNullOrEmpty(ImageSrc)) return;

 
        var name = string.IsNullOrWhiteSpace(FileName) ? "downloaded_file.jpg" : FileName;

        await js.InvokeVoidAsync("triggerDownload2", ImageSrc, name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("cropper.init");
        }
    }
}
