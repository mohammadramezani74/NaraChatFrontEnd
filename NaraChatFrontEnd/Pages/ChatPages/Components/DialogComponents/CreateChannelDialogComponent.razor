@using NaraChat.Contract.Models.Chat.Channels
<MudDialog>

    <DialogContent >
        <MudPaper style="min-width:350px;">
            <MudTextField @bind-Value="_title" Label="نام کانال" Required="true" />
            <MudTextField @bind-Value="_description" Label=" توضیحات" Placeholder="بیو یا توضیحات کانال خود را اینجا وارد کنید" Lines="3" />
            <MudTextField @bind-Value="_userName" Label="(آیدی کانال)نام کاربری" Placeholder="نام لاتین بدون ات ساین" Required="true" />
            <MudCheckBox T="bool" @onmouseover="VisibleSpan" @onmouseleave="UnVisibleSpan" @bind-Value="_isPublic" Label="عمومی باشد" />
            @if (isSpan)
            {
                <MudText Style="font-size:11px" Color="Color.Warning">توجه داشته باشید در صورت انتخاب چنل عمومی تمامی اعضای شرکت عضو چنل شما خواهند شد!</MudText>
            }
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">ایجاد</MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; }

    private string _title;
    private string _description;
    private string _userName;
    private bool _isPublic;
    public bool isSpan = false;

    private void Submit()
    {
        var command = new CreateChannelCommand(
            _title,
            _description,
            _userName,
           _isPublic
        );

        MudDialog.Close(DialogResult.Ok(command));
    }
    void VisibleSpan() => isSpan = true;
    void UnVisibleSpan() => isSpan = false;
    private void Cancel() => MudDialog.Cancel();
}