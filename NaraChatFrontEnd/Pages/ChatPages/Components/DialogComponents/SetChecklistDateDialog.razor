@using System.Globalization
@using MudBlazor
@using NaraChat.Contract.Models.Checklist

<CascadingValue Value="this">
    <MudDialog>
        <DialogContent >
            <MudText Typo="Typo.subtitle1" Class="mb-2">تاریخ موعد برای «@Item?.Text»</MudText>
            <MudDatePicker @bind-Date="_value" PickerVariant="PickerVariant.Static" Culture="CultureInfo.CurrentCulture" Label="تاریخ" CloseOnSelection="false" DisableToolbar="false" Orientation="Orientation.Portrait" />
        </DialogContent>
        <DialogActions >
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearDate" StartIcon="@Icons.Material.Filled.Delete">حذف تاریخ</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text" OnClick="Cancel">لغو</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" StartIcon="@Icons.Material.Filled.Check">تأیید</MudButton>
        </DialogActions>
    </MudDialog>
</CascadingValue>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ContactChecklistItem? Item { get; set; }
    [Parameter] public DateTime? CurrentValue { get; set; }

    private DateTime? _value;

    protected override void OnInitialized()
    {
        _value = CurrentValue?.Date ?? DateTime.Now.Date;
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok<DateTime?>(_value));
    }

    private void ClearDate()
    {
        _value = null;
        MudDialog.Close(DialogResult.Ok<DateTime?>(_value));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}