@using NaraChat.Application.Services.TokenProvider
@using NaraChat.Application.Services.Upload
@using NaraChat.Contract.Models.Chat.Channels
@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents
@inject IDialogService DialogService
@inject IMessageService _messageservice
@inject IConversationService _groupService
@inject ISnackbar snackbar
@inject IJSRuntime JS
@inject ITokenService tokenservice
<MudItem xs="12" Class="w-100">
    <div class="d-flex w-100 @(message.IsMine ? "justify-start" : "justify-end")">

        <MudChat ChatPosition="@(message.IsMine?ChatBubblePosition.Start:ChatBubblePosition.End)">



            <MudChatBubble
                Style="@($"{Style()};display: inline-block; max-width: 370px; word-wrap: break-word; border-radius: 12px; padding: 8px;")"
                           Variant="Variant.Text" OnClick="@(e => OnRightClick(e, message))"
            @onmouseenter="@((args) => HoverStart(args, message))"
            @onmouseleave="@(() => HoverStop("bubble"))">

                <p style="text-align: right; color:@(ThemeCascading.SeenColor );font-size: 14px;"><small> @(message.SenderName) </small></p>
                <!-- ریپلای نمایش -->
                @if (ParentMessage != null && message.ParentId != null)
                {
                    <MudPaper Class="reply-preview px-2 py-1 mb-1" style="@replyColor()">
                        @if (IsMine)
                        {
                            <a href="javascript:void(0)" @onclick="() => ScrollToMessage(message.ParentId!.Value)">
                                <MudText Class="text-truncate" Style="text-align: right; color:gray;font-size: 10px;    padding-bottom: 6px;">
                                    @OtherName
                                </MudText>
                            </a>
                        }
                        else
                        {
                            <MudText Class="text-truncate" Style="text-align: right; color:gray;font-size: 10px;    padding-bottom: 6px;">
                                @CurrentUser.Name
                            </MudText>
                        }
                        <MudText Class="text-truncate" Style="font-size: 12px;">
                            @ParentMessage
                        </MudText>
                    </MudPaper>
                }
                @if (message.Type==MessageType.Document)
                {



                    <div style="display: flex; align-items: center; gap: 10px; max-width: 300px; margin: auto; padding: 10px;">
                        @if (IsLoading)
                        {
                            @if (_downloadPercent == 0 && string.IsNullOrEmpty(_downloadSizeText))
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudProgressCircular Size="Size.Small" Indeterminate />
                                    <MudText Typo="Typo.caption">در حال آماده‌سازی فایل روی سرور…</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                    @if (_downloadPercent < 0)
                                    {
                                        <MudProgressLinear Color="Color.Primary" Indeterminate Style="width: 110px;" />
                                    }
                                    else
                                    {
                                        <MudProgressLinear Color="Color.Primary" Value="@_downloadPercent" Style="width: 110px;" />
                                        <MudText Typo="Typo.caption">@(_downloadPercent)٪</MudText>
                                    }
                                    <MudText Typo="Typo.caption">@_downloadSizeText</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelDownload" />
                                </MudStack>
                            }
                        }
                        else
                        {
                            <MudFab @onclick="async () => await LoadFile(message.FileContent!.FileId)" Color="ThemeCascading.SeenColor==Color.Secondary?Color.Primary:ThemeCascading.SeenColor" StartIcon="@Icons.Material.Filled.Download" />

                        }
                        <div style="display: flex; flex-direction: column;">
                            <MudText>@FormatMessage(message.FileContent.FileName)</MudText>
                            <MudText Style="font-size: 12px; color: gray;">@message.FileContent.FileSize کیلوبایت</MudText>
                        </div>
                    </div>



                }
                else if (message.Type == MessageType.Video){
                    <VideoMessageComponent message="message"></VideoMessageComponent>
                }
                else if (message.Type == MessageType.Image){
                    <PhotosMessageComponent_ message="message" ></PhotosMessageComponent_>
                }
                else{
                    <AudioMessageComponent message="message"></AudioMessageComponent>
                }

           
                <MudText id="@message.Id" Color="Color.Default" Style="margin-top: 10px; font-size: 14px; text-align: right; ">
                    @((MarkupString)message.Content.Replace("\n", "<br />"))
                </MudText>



                @if (IsMine)
                {
                    <MudStack Row="true">

                        @if (message.isEdited)
                        {
                            <MudIcon Size="Size.Small" Color="@(message.IsSeen? Color.Warning:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                            <MudText Class="mt-2 " Style="font-size:8px;">ویرایش شده</MudText>
                        }
                        else
                        {
                            <MudIcon Size="Size.Small" Color="@(message.IsSeen? ThemeCascading.SeenColor:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                        }
                    </MudStack>
                }
                else
                {
                    @if (message.isEdited)
                    {
                        <MudText Class="mt-2 " Style="font-size:8px; text-align: right;">ویرایش شده</MudText>
                    }
                }
                @if (IsMine)
                {
                    <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                    AnchorOrigin="Origin.TopLeft"
                    TransformOrigin="Origin.BottomLeft"
                    @onscroll="@(() => HoverStop("scroll"))"
                    @onmouseenter="@(() => _paperHovering = true)"
                    @onmouseleave="@(() => HoverStop("paper"))">
                        <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">

                            <MudTooltip Text="رونوشت">
                                <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                            </MudTooltip>
                            <MudTooltip Text="پاسخ">
                                <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                            </MudTooltip>
                            <MudTooltip Text="ویرایش">
                                <span class="emoji" @onclick="()=>EditMessage(message.Id,message.Content)">✏️</span>
                            </MudTooltip>
                            <MudTooltip Text="حذف">
                                <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                            </MudTooltip>
                            @if (CanPin)
                            {
                                <MudTooltip Text="@(message.IsPinned ? "برداشتن سنجاق" : "سنجاق کردن")">
                                    <span class="emoji" @onclick="()=>TogglePin(message)">📌</span>
                                </MudTooltip>
                            }
                        </div>
                    </MudPopover>
                }
                else
                {
                    <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                    AnchorOrigin="Origin.TopLeft"
                    TransformOrigin="Origin.BottomLeft"
                    @onscroll="@(() => HoverStop("scroll"))"
                    @onmouseenter="@(() => _paperHovering = true)"
                    @onmouseleave="@(() => HoverStop("paper"))">
                        <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">


                            <MudMenu Dense="true" @bind-Open="_menuOpen">

                                <ActivatorContent>
                                    <MudTooltip Text="ایموجی">
                                        <span class="emoji">➕</span>
                                    </MudTooltip>
                                </ActivatorContent>

                              

                                 


                            </MudMenu>
                            <MudTooltip Text="پاسخ ">
                                <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                            </MudTooltip>
                            <MudTooltip Text="رونوشت">
                                <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                            </MudTooltip>
                            @if (CanPin)
                            {
                                <MudTooltip Text="@(message.IsPinned ? "برداشتن سنجاق" : "سنجاق کردن")">
                                    <span class="emoji" @onclick="()=>TogglePin(message)">📌</span>
                                </MudTooltip>
                            }
                            @if (AmIAdmin() || AmICreator())
                            {
                                if (AmICreator())
                                {
                                    if (!message.IsMute)
                                    {
                                        <MudTooltip Text="سکوت">
                                            <span class="emoji" @onclick="@(() => MuteUser(message))">🔇</span>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="حذف سکوت">
                                            <span class="emoji" @onclick="@(() => UnMuteUser(message))">🔊</span>
                                        </MudTooltip>
                                    }
                                    <MudTooltip Text="حذف">
                                        <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                                    </MudTooltip>
                                }
                                else
                                {
                                    if (!isSenderCreator(message.UserId) && !isSenderAdmin(message.UserId))
                                    {
                                        if (!message.IsMute)
                                        {
                                            <MudTooltip Text="سکوت">
                                                <span class="emoji" @onclick="@(() => MuteUser(message))">🔇</span>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                              <MudTooltip Text="حذف سکوت">
                                                <span class="emoji" @onclick="@(() => UnMuteUser(message))">🔊</span>
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="حذف پیام">
                                            <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                                        </MudTooltip>
                                      
                                    }
                                }
                            }
                        </div>
                    </MudPopover>
                }


            </MudChatBubble>


            <MudChatFooter Style="@ClockColor()" Text="@message.SendAt.ToString(@"HH\:mm")" />




        </MudChat>


    </div>
</MudItem>

