@using NaraChat.Contract.Models.Chat.Channels
@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents
@using System.Net
@using System.Text.RegularExpressions
@inject IDialogService DialogService
@inject IMessageService _messageservice
@inject ISnackbar snackbar
@inject IJSRuntime JS
@inject IConversationService _groupService
@inject NavigationManager mn
<MudItem xs="12" Class="w-100">
    <div class="d-flex w-100 @(message.IsMine ? "justify-start mine-msg" : "justify-end other-msg")">


        <MudChat ChatPosition="@(message.IsMine?ChatBubblePosition.Start:ChatBubblePosition.End)" ArrowPosition="ChatArrowPosition.Top">
            <MudStack Row="false" Spacing="0">

                <MudChatBubble Style="@($"{Style()};display: inline-block; max-width: 370px; word-wrap: break-word; border-radius: 12px; padding: 8px;")"
                Variant="Variant.Text" OnClick="@(e => OnRightClick(e, message))"
                @onmouseenter="@((args) => HoverStart(args, message))"
                @onmouseleave="@(() => HoverStop("bubble"))">
                    <p style="text-align: right; color:@(ThemeCascading.SeenColor );font-size: 14px;"><small> @(message.SenderName) </small></p>

                    <!-- ریپلای نمایش -->
                    @if (ParentMessage != null)
                    {
                        <MudPaper Class="reply-preview px-2 py-1 mb-1"
                                  style="@($"{replyColor()}; max-width: 100%; box-sizing: border-box; cursor: pointer;")"
                                  @onclick="GoToParent">

                            <MudText Class="text-truncate"
                                     Style="text-align: right; color:gray; font-size: 10px; padding-bottom: 6px;">
                                @(ParentSenderName )
                            </MudText>

                            <MudText Class="text-truncate" Style="font-size: 12px;">
                                @ParentMessage.TruncateMessage()
                            </MudText>
                        </MudPaper>
                    }

                    <MudText id="@message.Id" Color="Color.Default">
                        @if (IsMention(message.Content))
                        {
                            <div @onclick="()=>Routingchannel(message.Content)" style="color:cornflowerblue"> @((MarkupString)message.Content.Replace("\n", "<br />"))</div>
                        }
                        else
                        {
                            @((MarkupString)message.Content.Replace("\n", "<br />"))
                        }

                        @if (message.Type == MessageType.Location)
                        {
                            <MudPaper Class="pa-2 mt-2" Style="border:1px solid #ccc;border-radius:12px;width:300px;margin:20px;">
                                <div id="map-@message.Id" style="height:350px;border-radius:12px;"></div>
                            </MudPaper>
                        }
                    </MudText>
                    @if (IsMine)
                    {
                        <MudStack Row="true">

                            @if (message.isEdited)
                            {
                                <MudIcon Size="Size.Small" Color="@(message.IsSeen? Color.Warning:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                                <MudText Class="mt-2 " Style="font-size:8px;">ویرایش شده</MudText>
                            }
                            else
                            {
                                <MudIcon Size="Size.Small" Color="@(message.IsSeen? ThemeCascading.SeenColor:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                            }
                        </MudStack>
                    }
                    else
                    {
                        @if (message.isEdited)
                        {
                            <MudText Class="mt-2 " Style="font-size:8px; text-align: right;">ویرایش شده</MudText>
                        }
                    }
                    @if (IsMine)
                    {
                        <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                        AnchorOrigin="Origin.TopLeft"
                        TransformOrigin="Origin.BottomLeft"
                        @onscroll="@(() => HoverStop("scroll"))"
                        @onmouseenter="@(() => _paperHovering = true)"
                        @onmouseleave="@(() => HoverStop("paper"))">
                            <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">

                                <MudTooltip Text="رونوشت">
                                    <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                                </MudTooltip>
                                <MudTooltip Text="پاسخ">
                                    <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                                </MudTooltip>
                                <MudTooltip Text="ویرایش">
                                    <span class="emoji" @onclick="()=>EditMessage(message.Id,message.Content)">✏️</span>
                                </MudTooltip>
                                <MudTooltip Text="حذف">
                                    <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                                </MudTooltip>
                                @if (CanPin)
                                {
                                    <MudTooltip Text="@(message.IsPinned ? "برداشتن سنجاق" : "سنجاق کردن")">
                                        <span class="emoji" @onclick="()=>TogglePin(message)">📌</span>
                                    </MudTooltip>
                                }

                            </div>
                        </MudPopover>
                        <p Style="@ClockColor() font-size:11px;text-align: right; margin-top: 17px;margin-bottom: 0px;">@message.SendAt.ToString(@"HH\:mm")</p>

                    }
                    else
                    {
                        <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                        AnchorOrigin="Origin.TopLeft"
                        TransformOrigin="Origin.BottomLeft"
                        @onscroll="@(() => HoverStop("scroll"))"
                        @onmouseenter="@(() => _paperHovering = true)"
                        @onmouseleave="@(() => HoverStop("paper"))">
                            <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">


                                <MudMenu Dense="true" @bind-Open="_menuOpen">

                                    <ActivatorContent>
                                        <MudTooltip Text="ایموجی">
                                            <span class="emoji">➕</span>
                                        </MudTooltip>
                                    </ActivatorContent>

                                    <ChildContent>

                                        <MudMenuItem OnClick="@(() => MessageAction("liked", message))">
                                            👍 لایک
                                        </MudMenuItem>

                                        <MudMenuItem OnClick="@(() => MessageAction("Merci", message))">
                                            🙏 تشکر
                                        </MudMenuItem>

                                        <MudMenuItem OnClick="@(() => MessageAction("Loved", message))">
                                            ❤️ علاقه
                                        </MudMenuItem>

                                        <MudMenuItem OnClick="@(() => MessageAction("Lough", message))">
                                            😂 خنده
                                        </MudMenuItem>

                                        <MudMenuItem OnClick="@(() => MessageAction("Flower", message))">
                                            🌹 گل
                                        </MudMenuItem>

                                    </ChildContent>

                                </MudMenu>
                                <MudTooltip Text="پاسخ ">
                                    <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                                </MudTooltip>
                                <MudTooltip Text="رونوشت">
                                    <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                                </MudTooltip>
                                @if (AmIAdmin() ||AmICreator())
                                {
                                    if (AmICreator())
                                    {
                                        if(!message.IsMute){
                                               <MudTooltip Text="سکوت">
                                            <span class="emoji" @onclick="@(() => MuteUser(message))">🔇</span>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="حذف سکوت">
                                                <span class="emoji" @onclick="@(() => UnMuteUser(message))">🔊</span>
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="حذف">
                                            <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        if (!isSenderCreator(message.UserId) && !isSenderAdmin(message.UserId))
                                        {
                                            if (!message.IsMute)
                                            {
                                                <MudTooltip Text="سکوت">
                                                    <span class="emoji" @onclick="@(() => MuteUser(message))">🔇</span>
                                                </MudTooltip>
                                            }
                                            else
                                            {  <MudTooltip Text="حذف سکوت">
                                                <span class="emoji" @onclick="@(() => UnMuteUser(message))">🔊</span>
                                                </MudTooltip>
                                            }
                                            <MudTooltip Text="حذف پیام">
                                                <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                                            </MudTooltip>
                                        }
                                    }
                                }
                                @if (CanPin)
                                {
                                    <MudTooltip Text="@(message.IsPinned ? "برداشتن سنجاق" : "سنجاق کردن")">
                                        <span class="emoji" @onclick="()=>TogglePin(message)">📌</span>
                                    </MudTooltip>
                                }
                            </div>
                        </MudPopover>
                        <p Style="@ClockColor() font-size:11px;text-align: left; margin-top: 17px;margin-bottom: 0px;">@message.SendAt.ToString(@"HH\:mm")</p>

                    }

                </MudChatBubble>

                <MudPaper Class="actionarea mt-0" Elevation="0" Style="margin-top: 0; padding-top: 0;">
                    <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                        @if (message.Reaction == "Liked")
                        {
                            <span class="myemoji">👍</span>

                        }
                        else if (message.Reaction == "cried")
                        {
                            <span class="myemoji">😭</span>

                        }
                        else if (message.Reaction == "Loved")
                        {
                            <div style="opacity: 1;">
                                <span class="myemoji">❤️</span>
                            </div>

                        }
                        else if (message.Reaction == "Merci")
                        {
                            <span class="myemoji">🙏</span>

                        }
                        else if (message.Reaction == "Lough")
                        {
                            <span class="myemoji">😂</span>

                        }
                        else if (message.Reaction == "cool")
                        {
                            <span class="myemoji">😎</span>
                        }
                        else if (message.Reaction == "Flower")
                        {
                            <span class="myemoji">🌹</span>

                        }
                        else if (message.Reaction == "ButterFly")
                        {
                            <span class="myemoji">🦋</span>
                        }

                    </div>
                </MudPaper>
            </MudStack>





        </MudChat>


    </div>
</MudItem>



<style>



