</style>
<script>
    window.showMiniMap = function (mapId, lat, lng) {
    var mapElement = document.getElementById(mapId);
    if (!mapElement) return;

    var map = L.map(mapId, {
    zoomControl: true,
    dragging: false,
    doubleClickZoom: false,
    scrollWheelZoom: false,
    attributionControl: false
    }).setView([lat, lng], 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
    L.marker([lat, lng]).addTo(map);
    map.on('click', function () {
    var url = `https://www.google.com/maps?q=${lat},${lng}`;
    window.open(url, '_blank');
    });
    };
</script>
@code {



    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeCascading { get; set; }
    [Parameter]
    [EditorRequired]
    public bool IsMine { get; set; }
    [Parameter]
    public ChatMessageDto message { get; set; } = null!;
    [Parameter]
    [EditorRequired]
    public UserDto CurrentUser { get; set; } = null!;
    [Parameter]
    [EditorRequired]
    public PrivateConversationDto Conversation { get; set; } = null!;
    [Parameter]
    public List<UserChannelDto> Adminlist { get; set; } = new();
    [Parameter]
    public EventCallback<EditedMessageDto> EditMessageEvent { get; set; }
    [Parameter]
    public EventCallback<ChatMessageDto> ReplyMessageEvent { get; set; }
    [Parameter]
    public EventCallback<MessageReaction> MessageReactionEvent { get; set; }
    [Parameter]
    public EventCallback<Guid> DeletedMessageevent { get; set; }
    [Parameter]
    public EventCallback<string> JoinChannel { get; set; }
    [Parameter]
    public string? ParentMessage { get; set; } = null;
    private bool showContextMenu = false;
    private Guid? showContextMenuForMessageId = null;
    private int contextMenuX;
    private int contextMenuY;
    public string? myAvatar { get; set; }
    [Parameter]
    public Guid CreateorId { get; set; }
    [Parameter]
    public bool CanPin { get; set; }

    [Parameter]
    public EventCallback<(Guid MessageId, bool Pin)> TogglePinEvent { get; set; }
    public string? myName { get; set; }
    private bool _menuOpen;

    // public string? GetAvatar()
    // {

    //     if (CurrentUser.Id == message.UserId)
    //         return myAvatar;

    // }
    public bool AmICreator() => CreateorId == CurrentUser.Id;
    public bool AmIAdmin()
    {
        return Adminlist.Any(x => x.Id == CurrentUser.Id);
    }
    public bool isSenderAdmin(Guid SenderId)
    {
        return Adminlist.Any(x => x.Id == SenderId);
    }
    public bool isSenderCreator(Guid SenderId)
    {
        return CreateorId == SenderId;
    }
    public async Task Routingchannel(string message)
    {
        await JoinChannel.InvokeAsync(message);

    }
    public string replyColor() { return message.IsMine ? $"background-color: {ThemeCascading.MyColorReply}" : $"background-color: {ThemeCascading.OtherColorReply}"; }
    public string ClockColor() => $"color: {ThemeCascading.ClockColor};";
    public string Style() { return message.IsMine ? $"min-width: 305px;background-color: {ThemeCascading.myColorChat}" : $"min-width: 50px;background-color: {ThemeCascading.OtherColorChat}"; }
    protected override async Task OnInitializedAsync()
    {
        var me = Conversation.users.Where(c => c.Id == CurrentUser.Id).FirstOrDefault();
        myAvatar = CurrentUser.avatar;

        myName = me?.Name;

    }
    private async Task TogglePin(ChatMessageDto message)
    {
        HoverStop("click");
        await TogglePinEvent.InvokeAsync((message.Id, !message.IsPinned));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            if (message.Type == MessageType.Location)
                await JS.InvokeVoidAsync("showMiniMap", $"map-{message.Id}", message.Latitude, message.Longitude);

    }
    public async Task copyMessage(ChatMessageDto message)
    {
        await JS.InvokeVoidAsync("copyToClipboard", message.Content);
    }
    private async Task OnRightClick(MouseEventArgs e, ChatMessageDto message)
    {
        if (IsMine)
        {
            showContextMenuForMessageId = message.Id;
            contextMenuX = (int)e.ClientX;
            contextMenuY = (int)e.ClientY;
            showContextMenu = true;
            StateHasChanged();
        }
    }
    private async Task EditMessage(Guid MessageId, string Message)
    {
        var message = new EditedMessageDto(MessageId, Message);
        await EditMessageEvent.InvokeAsync(message);
    }
    private async Task DeleteMessagePopUp(Guid MessageId)
    {
        var parameters = new DialogParameters<DialogTemplate>
    {
        { x => x.ContentText, "آیا از حذف این پیام اطمینان دارید؟" },
        { x => x.ButtonText, "بله" },
        { x => x.Color, Color.Error }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, };

        var dialog = await DialogService.ShowAsync<DialogTemplate>("حذف پیام", parameters, options);
        var res = await dialog.Result;
        if (!res.Canceled)
        {
            await PerformDeleteMessageAsync(MessageId);
        }
    }
    private static MarkupString RenderMentions(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return new MarkupString(string.Empty);




        var withLinks = Regex.IsMatch(
            content,
            @"@([A-Za-z0-9_]+)"
        );

        return new MarkupString($"<a href='{content}' data-mention-link>{content}</a>");
    }
    private bool IsMention(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return false;




        var withLinks = Regex.IsMatch(
            content,
            @"@([A-Za-z0-9_]+)"
        );
        return withLinks;
    }
    public async Task PerformDeleteMessageAsync(Guid MessageId)
    {
      //  var otherId = Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault()!.Id;
        var result = await _messageservice.DeleteMessageAsync(MessageId,Guid.Empty);
        if (result.Item1)
        {
            await DeletedMessageevent.InvokeAsync(MessageId);
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"حذف پیام با موفقیت انجام شد ", Severity.Success, x =>
            {

            });
        }
        else
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"حذف پیام با خطا مواجه شد ", Severity.Error, x =>
            {

            });
        }
    }

}
@code {
    private bool Hovering => _paperHovering || _bubbleHovering;
    private bool _bubbleHovering;
    private bool _paperHovering;
    private ChatMessageDto? _hoverMessage;
    private void HoverStart(MouseEventArgs args, ChatMessageDto message)
    {
        _bubbleHovering = true;
        _hoverMessage = message;
    }

    private void HoverStop(string typeOfStop)
    {
        try
        {
            if (_menuOpen && typeOfStop != "scroll")
                return;
            switch (typeOfStop)
            {
                case "paper":
                    _paperHovering = false;
                    break;
                case "bubble":
                    _bubbleHovering = false;
                    break;
                case "scroll":
                    _paperHovering = false;
                    _bubbleHovering = false;
                    StateHasChanged();
                    break;
                default:
                    break;
            }
        }
        catch { }
    }
}
@code {
    [Parameter]
    public Guid GroupId { get; set; }
    public async Task ReplyMessage(ChatMessageDto message)
    {
        await ReplyMessageEvent.InvokeAsync(message);
    }
    private async Task ScrollToMessage(Guid parentId)
    {
        await JS.InvokeVoidAsync("scrollToElement", parentId);
    }
    public async Task MuteUser(ChatMessageDto messsage)
    {
        var result = await _groupService.MuteOrUnMuteUser(GroupId, message.UserId, true);
        if (result.status)
        {
            snackbar.Add($"عملیات با موفقیت انجام شد!", Severity.Success, x =>
         {

         });
            message.IsMute = true;
            StateHasChanged();
        }
        else
        {
            snackbar.Add(result.message, Severity.Error, x =>
       {

       });
        }
    }
    public async Task UnMuteUser(ChatMessageDto messsage)
    {
        var result = await _groupService.MuteOrUnMuteUser(GroupId, message.UserId, false);
        if (result.status)
        {
            snackbar.Add($"عملیات با موفقیت انجام شد!", Severity.Success, x =>
         {

         });
            message.IsMute=false;
            StateHasChanged();
        }
        else
        {
            snackbar.Add(result.message, Severity.Error, x =>
       {

       });
       
        }
    }
    [Parameter]
    public string? ParentSenderName { get; set; }

    [Parameter]
    public EventCallback<Guid> OnParentClick { get; set; }

    // ---- ScrollToMessage قدیمی را حذف کن و به‌جایش این ----

    private Task GoToParent()
        => message.ParentId is null
            ? Task.CompletedTask
            : OnParentClick.InvokeAsync(message.ParentId.Value);
    private async Task MessageAction(string actionType, ChatMessageDto messsage)
    {
        if (!string.IsNullOrEmpty(message.Reaction))
        {

            message.Reaction = null;
        }
        else
        {


            switch (actionType)
            {
                case "liked":

                    message.Reaction = "Liked";
                    break;

                case "cried":
                    message.Reaction = "cried";
                    break;

                case "Flower":
                    message.Reaction = "Flower";
                    break;

                case "Loved":
                    message.Reaction = "Loved";
                    break;

                case "Lough":
                    message.Reaction = "Lough";
                    break;

                case "Merci":
                    message.Reaction = "Merci";
                    break;
                case "ButterFly":
                    message.Reaction = "ButterFly";
                    break;
                case "cool":
                    message.Reaction = "cool";
                    break;

                default:
                    break;
            }

            var Other = Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault()!.Id;
            var reactionInstance = new MessageReaction(message.Id, message.Reaction, Other);
            var result = await _messageservice.newReactionOnMessage(reactionInstance.Reaction, reactionInstance.MessageId);
            if (!result.issuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                snackbar.Add(result.Message, Severity.Error, x =>
                {

                });
                return;
            }
            await MessageReactionEvent.InvokeAsync(reactionInstance);
            StateHasChanged();


        }
    }
  
    bool _mapDialogVisible = false;
    double? _selectedLat;
    double? _selectedLng;

    public void OpenMap(double lat, double lng)
    {
        _selectedLat = lat;
        _selectedLng = lng;
        _mapDialogVisible = true;


        _ = Task.Delay(200).ContinueWith(async _ =>
        {
            await JS.InvokeVoidAsync("showMapWithMarker", lat, lng);
        });
    }
}
