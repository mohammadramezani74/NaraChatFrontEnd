    private async Task CloseToggle()
    {
        await OnClosepopover.InvokeAsync();
    }

    private async Task SelectEmoji(string emoji)
    {
        await OnEmojiSelected.InvokeAsync(emoji);
        FilterEmojis(_searchText);
    }
    private List<EmojiCategory> FilteredEmojiis => FilterEmojis(_searchText);

    private List<EmojiCategory> FilterEmojis(string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return EmojiCategories; // اگر جستجو خالی بود همه رو برگردون

        var filteredCategories = new List<EmojiCategory>();

        foreach (var category in EmojiCategories)
        {
            var filteredEmojis = category.Emojis
                .Where(e => e.Emoji.Contains(searchText) || e.Keywords.Contains(searchText))
                .ToList();

            if (filteredEmojis.Any())
            {
                filteredCategories.Add(new EmojiCategory(category.Name, category.Icon, filteredEmojis));
            }
        }

        return filteredCategories;
    }
    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e?.Value?.ToString() ?? string.Empty;
  EmojiCategories= FilterEmojis(_searchText);
    }


    private IEnumerable<EmojiItem> FilteredEmojis =>
        string.IsNullOrWhiteSpace(_searchText)
            ? EmojiCategories[_selectedTabIndex].Emojis
            : EmojiCategories
                .SelectMany(c => c.Emojis)
                .Where(e => e.Keywords.Contains(_searchText, StringComparison.OrdinalIgnoreCase) || e.Emoji.Contains(_searchText));


    public class EmojiCategory
    {
        public string Name { get; set; }    // نام دسته
        public string Icon { get; set; }    // ایموجی آیکون دسته
        public List<EmojiItem> Emojis { get; set; }

        public EmojiCategory(string name, string icon, List<EmojiItem> emojis)
        {
            Name = name;
            Icon = icon;
            Emojis = emojis;
        }
    }

    public class EmojiItem
    {
        public string Emoji { get; set; }
        public string Keywords { get; set; }

        public EmojiItem(string emoji, string keywords)
        {
            Emoji = emoji;
            Keywords = keywords;
        }
    }

