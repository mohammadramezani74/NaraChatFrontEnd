<MudItem xs="1">
    <MudPopover Open="ShowEmojiPicker"

    AnchorOrigin="Origin.TopRight"
    TransformOrigin="Origin.TopRight"
    Style="width:380px; border-radius:12px; box-shadow: 0 8px 20px rgba(0,0,0,0.2);">
        <MudPaper Class="pa-2" Style="border-radius:12px;">

            <!-- هدر -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <MudText Typo="Typo.subtitle2" Class="ml-2">ایموجی‌ها</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                OnClick="CloseToggle"
                Size="Size.Small"
                Color="Color.Error"
                Class="ml-1" />
            </div>

            <!-- سرچ -->
            <MudTextField @bind-Value="_searchText"
            OnInternalInputChanged="OnSearchChanged"
            Placeholder="جستجو ایموجی..."
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search"
            AdornmentAriaLabel="برای جستجو اینتر را فشار دهید"
            Dense="true"
            Class="mb-2"
            Style="width:100%;"/>

            <!-- تب دسته‌بندی‌ها -->
            <MudTabs @bind-ActivePanelIndex="_selectedTabIndex"
            Rounded="true"
            Centered="true"
            Class="emoji-tabs"
            Style="margin-bottom:8px;">
                @for (int i = 0; i < EmojiCategories.Count; i++)
                {
                    <MudTabPanel Text="@EmojiCategories[i].Icon" DisableRipple="true"></MudTabPanel>
                }
            </MudTabs>

            <!-- ایموجی ها -->
            <MudFadeIn TransitionDuration="250">
                <MudGrid Class="emoji-grid">
                    @foreach (var emoji in FilteredEmojis)
                    {
                        <MudItem xs="3" Class="d-flex justify-center my-1">
                            <MudButton OnClick="() => SelectEmoji(emoji.Emoji)"
                            Style="font-size: 24px; width: 42px; height: 42px; border-radius: 8px; transition: 0.2s;"
                            Variant="Variant.Filled"
                            Color="Color.Default"
                            Class="emoji-btn">
                                @emoji.Emoji
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            </MudFadeIn>

        </MudPaper>
    </MudPopover>
</MudItem>

<style>
    .emoji-btn:hover {
    background-color: rgba(0, 0, 0, 0.07) !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transform: scale(1.15);
    }

    .emoji-grid {
    max-height: 220px;
    overflow-y: auto;
    padding-right: 4px;
    transition: all 0.2s ease;
    }

    /* scrollbar قشنگ */
    .emoji-grid::-webkit-scrollbar {
    width: 6px;
    }

    .emoji-grid::-webkit-scrollbar-thumb {
    background-color: rgba(0,0,0,0.2);
    border-radius: 4px;
    }

    /* تب‌ها کوچک‌تر */
    .emoji-tabs .mud-tabs-toolbar {
    min-height: 32px;
    }

    .emoji-tabs .mud-tab {
    min-width: 40px !important;
    padding: 4px !important;
    font-size: 20px;
    }
</style>

