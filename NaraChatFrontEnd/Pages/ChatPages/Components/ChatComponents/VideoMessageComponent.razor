@using NaraChat.Application.Services.Auth
@using NaraChatFrontEnd.Pages.ChatPages.Components.ChatComponents.Media
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IAuthService Auth

@* پخش‌کننده‌ی ویدیو. تا کاربر پخش را نزند فایل دریافت نمی‌شود (ویدیو می‌تواند
   صدها مگ باشد). بعد از دریافت، کنترل‌ها را naraMedia.js اداره می‌کند و وضعیت را
   با data-playing و data-muted و data-idle روی .nvid می‌گذارد؛ Blazor به این
   ویژگی‌ها دست نمی‌زند. *@

@if (message.FileContent is not null)
{
    <div class="nvid-wrap" style="--nm-accent:@MediaKit.Accent(ThemeCascading)">
        <div class="nvid @(_loaded ? "is-ready" : "")" @ref="_el" tabindex="0" @onclick:stopPropagation="true">
            <video playsinline preload="metadata"></video>

            @if (!_loaded)
            {
                <div class="nvid-poster" @onclick="OnPosterClick" title="@(_loading ? "لغو دریافت" : "پخش ویدیو")">
                    <div class="nvid-big">
                        @if (_loading)
                        {
                            <svg class="nm-ring @(_percent < 0 ? "spin" : "")" viewBox="0 0 52 52" aria-hidden="true">
                                <circle class="bg" cx="26" cy="26" r="24" />
                                <circle class="fg" cx="26" cy="26" r="24" stroke-dasharray="150.8"
                                        stroke-dashoffset="@RingOffset" />
                            </svg>
                            <svg class="nm-svg" viewBox="0 0 24 24"><path d="@NaraIcons.Close" /></svg>
                        }
                        else if (_failed)
                        {
                            <svg class="nm-svg lg" viewBox="0 0 24 24"><path d="@NaraIcons.Refresh" /></svg>
                        }
                        else
                        {
                            <svg class="nm-svg lg" viewBox="0 0 24 24"><path d="@NaraIcons.Play" /></svg>
                        }
                    </div>

                    @if (_loading)
                    {
                        <div class="nvid-status">@(_progressText ?? "در حال آماده‌سازی…")</div>
                    }
                    else if (_failed)
                    {
                        <div class="nvid-status">دریافت ویدیو ناموفق بود؛ دوباره بزنید</div>
                    }

                    <div class="nvid-info">
                        <svg class="nm-svg sm" viewBox="0 0 24 24"><path d="@NaraIcons.Movie" /></svg>
                        <span>@SizeText</span>
                    </div>
                </div>
            }

            <div class="nvid-center" aria-hidden="true">
                <span><svg class="nm-svg lg" viewBox="0 0 24 24"><path d="@NaraIcons.Play" /></svg></span>
            </div>

            <div class="nvid-bar">
                <div class="nvid-seek" role="slider" aria-label="جابه‌جایی در ویدیو">
                    <div class="nvid-fill"></div>
                    <div class="nvid-thumb"></div>
                </div>
                <div class="nvid-row">
                    <button type="button" class="nm-icon" data-act="toggle" title="پخش / توقف">
                        <svg class="nm-svg when-paused" viewBox="0 0 24 24"><path d="@NaraIcons.Play" /></svg>
                        <svg class="nm-svg when-playing" viewBox="0 0 24 24"><path d="@NaraIcons.Pause" /></svg>
                    </button>
                    <span class="nvid-time"></span>
                    <span class="nvid-sp"></span>
                    <button type="button" class="nvid-rate" data-act="rate" title="سرعت پخش"></button>
                    <button type="button" class="nm-icon" data-act="mute" title="صدا">
                        <svg class="nm-svg sm when-unmuted" viewBox="0 0 24 24"><path d="@NaraIcons.VolumeUp" /></svg>
                        <svg class="nm-svg sm when-muted" viewBox="0 0 24 24"><path d="@NaraIcons.VolumeOff" /></svg>
                    </button>
                    <button type="button" class="nm-icon nvid-pip" data-act="pip" title="پخش شناور">
                        <svg class="nm-svg sm" viewBox="0 0 24 24"><path d="@NaraIcons.Pip" /></svg>
                    </button>
                    <button type="button" class="nm-icon" data-act="download" title="دانلود">
                        <svg class="nm-svg sm" viewBox="0 0 24 24"><path d="@NaraIcons.Download" /></svg>
                    </button>
                    <button type="button" class="nm-icon" data-act="full" title="تمام‌صفحه">
                        <svg class="nm-svg sm when-window" viewBox="0 0 24 24"><path d="@NaraIcons.Fullscreen" /></svg>
                        <svg class="nm-svg sm when-full" viewBox="0 0 24 24"><path d="@NaraIcons.FullscreenExit" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeCascading { get; set; } = default!;

    [Parameter]
    public ChatMessageDto message { get; set; } = null!;

    private ElementReference _el;
    private DotNetObjectReference<VideoMessageComponent>? _self;
    private bool _initialized, _loading, _loaded, _failed, _disposed;
    private int _percent;
    private string? _progressText;

    private string SizeText => MediaKit.ParseSize(message.FileContent?.FileSize) is long s
        ? "ویدیو · " + MediaKit.FormatBytes(s)
        : "ویدیو";

    private string RingOffset => (150.8 * (1 - Math.Clamp(_percent, 0, 100) / 100.0))
        .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialized || message.FileContent is null || _disposed) return;
        _initialized = true;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("naraVideo.init", _el, _self); }
        catch (JSException) { }
    }

    private async Task OnPosterClick()
    {
        if (_loading)
        {
            await JS.InvokeVoidAsync("naraVideo.abort", _el);
            return;
        }

        _loading = true;
        _failed = false;
        _percent = 0;
        _progressText = null;
        StateHasChanged();

        VideoLoadResult? result = null;
        try
        {
            var token = await Auth.GetFreshAccessTokenAsync();
            var url = SiteSettings.ApiUrl + $"api/v1/chatfiles/{message.FileContent!.FileId}/files";
            var name = "video-" + message.SendAt.ToString("yyyyMMdd-HHmmss", System.Globalization.CultureInfo.InvariantCulture);
            result = await JS.InvokeAsync<VideoLoadResult>("naraVideo.load", _el, url, token, name, true);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }

        if (_disposed) return;
        _loading = false;
        if (result is { Ok: true }) _loaded = true;
        else _failed = result?.Error != "aborted";
        StateHasChanged();

        if (_loaded)
        {
            try { await _el.FocusAsync(); } catch { }
        }
    }

    [JSInvokable]
    public Task OnVideoProgress(int percent, long loaded, long total)
    {
        _percent = percent;
        _progressText = percent < 0
            ? MediaKit.FormatBytes(loaded) + " دریافت شد"
            : MediaKit.FormatBytes(loaded) + " از " + MediaKit.FormatBytes(total);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_self is null) return;
        try { await JS.InvokeVoidAsync("naraVideo.dispose", _el); } catch { }
        _self.Dispose();
    }
}
