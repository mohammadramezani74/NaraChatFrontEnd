@using NaraChat.Application.Services.TokenProvider
@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents
@inject IJSRuntime JS
@inject ITokenService tokenservice
@implements IDisposable
@if (message.FileContent != null)
{
    <div style="display: flex; flex-direction: column; align-items: center; max-width: 300px; margin: auto; padding: 10px; border: 1px solid #ddd; border-radius: 10px; box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1); direction: rtl;">


        <!-- ویدیو -->
        <video poster="lib/assets/Images/blured.jpg"  @onplay="OnVideoPlay" @onended="OnVideoEnded" id="video-@message.FileContent!.FileId" controls style="width: 100%; height: 200px; border-radius: 10px; object-fit: cover;">

            مرورگر شما از ویدیو پشتیبانی نمی‌کند.
        </video>
        @if (!isVideoPlaying){
            <div id="@message.FileContent!.FileId" class="video-overlay" @onclick="()=>loadVideo(message.FileContent!.FileId)">
                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.PlayCircle" Color="ThemeCascading.SeenColor"></MudIcon>
            </div>
        }
        @if (Loading)
        {
            <div class="video-overlay" style="flex-direction: column; gap: 8px;">
                @if (_percent < 0)
                {
                    <MudProgressCircular Color="ThemeCascading.SeenColor" Indeterminate="true" />
                }
                else
                {
                    <MudProgressCircular Color="ThemeCascading.SeenColor"
                                         Value="@_percent"
                                         Size="Size.Large" />
                    <MudText Typo="Typo.caption" Style="color: white;">@(_percent)٪</MudText>
                }

                <MudText Typo="Typo.caption" Style="color: white;">@_sizeText</MudText>

                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Style="color: white;"
                               OnClick="CancelVideoLoad" />
            </div>
        }
    </div>
}


<style>

    /* برای ویدیو */
    video {
    position: relative; /* موقعیت‌دهی ویدیو */
    width: 300px;
    height: 250px;
    border-radius: 10px;
    object-fit: cover;
    }

    /* قرار دادن دکمه وسط ویدیو */
    .video-overlay {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10; /* دکمه روی ویدیو نمایش داده شود */
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0.8; /* مقداری محو بودن دکمه */
    cursor: pointer; /* نشانه کلیک */
    }


    /* طراحی دکمه */
    .play-button {
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    font-size: 16px;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    opacity: 1;
    transition: opacity 0.3s ease;
    }

    /* مخفی کردن دکمه وقتی ویدیو در حال پخش است */
    .video-overlay.hidden {
    display: none;
    }
</style>

@code {
    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeCascading { get; set; }

    [Parameter]
    public ChatMessageDto message { get; set; } = null!;
    public bool Loading { get; set; } = false;
}


@code {
    private bool isVideoPlaying = false;


    private int _percent;
    private string _sizeText = string.Empty;
    private Guid? _loadingFileId;
    private DotNetObjectReference<VideoMessageComponent>? _selfRef;

    public async Task loadVideo(Guid FileId)
    {
        Loading = true;
        _percent = 0;
        _sizeText = string.Empty;
        _loadingFileId = FileId;
        StateHasChanged();

        _selfRef ??= DotNetObjectReference.Create(this);

        var token = await tokenservice.GetAccessTokenAsync();
        var videoUrl = SiteSettings.ApiUrl + $"api/v1/chatfiles/{FileId}/files";

        await JS.InvokeVoidAsync("playVideoFromApi", $"{FileId}", videoUrl, token, _selfRef);

        Loading = false;
        _loadingFileId = null;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnVideoProgress(int percent, long loaded, long total)
    {
        // ۲- خطا، ۳- لغو شده
        if (percent == -2 || percent == -3)
        {
            Loading = false;
            _loadingFileId = null;
            return InvokeAsync(StateHasChanged);
        }

        _percent = percent;
        _sizeText = percent < 0
            ? $"{FormatBytes(loaded)} دریافت شد"
            : $"{FormatBytes(loaded)} از {FormatBytes(total)}";

        return InvokeAsync(StateHasChanged);
    }

    private async Task CancelVideoLoad()
    {
        if (_loadingFileId is not null)
            await JS.InvokeVoidAsync("abortVideoLoad", _loadingFileId.ToString());
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = { "بایت", "کیلوبایت", "مگابایت", "گیگابایت" };
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; }
        return $"{value:0.#} {units[unit]}";
    }
    private void OnVideoPlay()
    {
        isVideoPlaying = true;
        StateHasChanged();
    }

    private void OnVideoEnded()
    {
        isVideoPlaying = false;
        StateHasChanged();
    }
    public void Dispose() => _selfRef?.Dispose();
}
}
