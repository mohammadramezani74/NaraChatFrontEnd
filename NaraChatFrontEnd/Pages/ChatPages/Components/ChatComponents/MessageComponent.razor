@using NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents
@inject IDialogService DialogService
@inject IMessageService _messageservice
@inject ISnackbar snackbar
@inject IJSRuntime JS
<MudItem xs="12" Class="w-100">
    <div class="d-flex justify-@(IsMine ? "end" : "start") w-100">

        <MudChat ChatPosition="@(message.IsMine?ChatBubblePosition.Start:ChatBubblePosition.End)">


            <MudAvatar>
                @if(GetAvatar()!=null){
                    <MudImage Src="@($"data:image/png;base64,{GetAvatar()}")" />
                }
                else{
                    <MudImage Src="lib/assets/Images/avatar.jpg" />

                }

            </MudAvatar>
            <MudStack Row="false" Spacing="0">
            <MudChatBubble Style="@Style()" Variant="Variant.Text"  OnClick="@(e => OnRightClick(e, message))"
            @onmouseenter="@((args) => HoverStart(args, message))"
            @onmouseleave="@(() => HoverStop("bubble"))">
                <p style="text-align: right; color:gray;font-size: 10px;"><small> @(CurrentUser.Id == message.UserId ? myName : OtherName) </small></p>

                <!-- ریپلای نمایش -->
                @if (ParentMessage != null)
                {
                    <MudPaper Class="reply-preview px-2 py-1 mb-1" style="@replyColor()">
                        @if(IsMine){
                            <a href="javascript:void(0)" @onclick="() => ScrollToMessage(message.ParentId!.Value)">
                                <MudText Class="text-truncate" Style="text-align: right; color:gray;font-size: 10px;    padding-bottom: 6px;">
                                    @OtherName
                                </MudText>
                            </a>
                        }else{
                            <MudText Class="text-truncate" Style="text-align: right; color:gray;font-size: 10px;    padding-bottom: 6px;">
                                @CurrentUser.Name
                            </MudText>
                        }
                        <MudText Class="text-truncate" Style="font-size: 12px;">
                            @ParentMessage
                        </MudText>
                    </MudPaper>
                }

                <MudText id="@message.Id" Color="Color.Default">
                    @((MarkupString)message.Content.Replace("\n", "<br />"))
                </MudText>
                @if (IsMine)
                {
                    <MudStack Row="true">

                        @if (message.isEdited)
                        {
                            <MudIcon Size="Size.Small" Color="@(message.IsSeen? Color.Warning:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                            <MudText Class="mt-2 " Style="font-size:8px;">ویرایش شده</MudText>
                        }else{
                            <MudIcon Size="Size.Small" Color="@(message.IsSeen? ThemeCascading.SeenColor:Color.Dark)" Icon="@Icons.Material.Filled.CheckCircleOutline"></MudIcon>

                        }
                    </MudStack>
                }
                else
                {
                    @if (message.isEdited)
                    {
                        <MudText Class="mt-2 " Style="font-size:8px; text-align: right;">ویرایش شده</MudText>
                    }
                }
                @if (IsMine)
                {
                    <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                    AnchorOrigin="Origin.TopLeft"
                    TransformOrigin="Origin.BottomLeft"
                    @onscroll="@(() => HoverStop("scroll"))"
                    @onmouseenter="@(() => _paperHovering = true)"
                    @onmouseleave="@(() => HoverStop("paper"))">
                        <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">

                            <MudTooltip Text="رونوشت">
                                <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                            </MudTooltip>
                            <MudTooltip Text="پاسخ">
                                <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                            </MudTooltip>
                            <MudTooltip Text="ویرایش">
                                <span class="emoji" @onclick="()=>EditMessage(message.Id,message.Content)">✏️</span>
                            </MudTooltip>
                            <MudTooltip Text="حذف">
                                <span class="emoji" @onclick="()=>DeleteMessagePopUp(message.Id)">❌</span>
                            </MudTooltip>

                        </div>
                    </MudPopover>
                    <p  Style="@ClockColor() font-size:11px;text-align: right; margin-top: 17px;margin-bottom: 0px;">@message.SendAt.ToString(@"HH\:mm")</p> 

                }
                else
                {
                    <MudPopover Open="@(Hovering && message.Equals(_hoverMessage))" Class="hoverarea"
                    AnchorOrigin="Origin.TopLeft"
                    TransformOrigin="Origin.BottomLeft"
                    @onscroll="@(() => HoverStop("scroll"))"
                    @onmouseenter="@(() => _paperHovering = true)"
                    @onmouseleave="@(() => HoverStop("paper"))">
                        <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">

                            <MudTooltip Text="پاسخ ">
                                <span class="emoji" @onclick="()=>ReplyMessage(message)">↩️</span>
                            </MudTooltip>
                            <MudTooltip Text="رونوشت">
                                <span class="emoji" @onclick="()=>copyMessage(message)">📝</span>
                            </MudTooltip>
                            <span class="emoji" @onclick="@(() => MessageAction("liked",message))">👍</span>
                            <span class="emoji" @onclick="@(() => MessageAction("Merci",message))">🙏</span>
                            <span class="emoji" @onclick="@(() => MessageAction("Loved",message))">❤️</span>
                            <span class="emoji" @onclick="@(() => MessageAction("Lough",message))">😂</span>
                            <span class="emoji" @onclick="@(() => MessageAction("cried",message))">😭</span>
                            <span class="emoji" @onclick="@(() => MessageAction("Flower",message))">🌸</span>
                        </div>
                    </MudPopover>
                    <p  Style="@ClockColor() font-size:11px;text-align: left; margin-top: 17px;margin-bottom: 0px;">@message.SendAt.ToString(@"HH\:mm")</p> 

                }

            </MudChatBubble>
            <MudPaper Class="actionarea mt-0" Elevation="0" Style="margin-top: 0; padding-top: 0;">
                <div class="d-flex" style="width: 100%;" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    @if (message.Reaction=="Liked")
                    {
                        <span class="myemoji" >👍</span>

                    }
                    else if (message.Reaction =="cried")
                    {
                        <span class="myemoji">😭</span>

                    }
                    else if (message.Reaction =="Loved")
                    {
                        <div style="opacity: 1;">
                            <span class="myemoji">❤️</span>
                        </div>

                    }
                    else if (message.Reaction =="Merci")
                    {
                        <span class="myemoji" >🙏</span>

                    }
                    else if (message.Reaction =="Lough")
                    {
                        <span class="myemoji" >😂</span>

                    }
                    else if (message.Reaction =="Flower")
                    {
                        <span class="myemoji" >🌸</span>

                    }

                </div>
            </MudPaper>
</MudStack>





        </MudChat>


    </div>
</MudItem>

<style>
    .reply-preview {
    border-radius: 8px;
    }
    .hoverarea {
    cursor: pointer !important;
    background-color: var(--mud-palette-appbar-background);
    color: var(--mud-palette-appbar-text);
    transition: opacity 0.9s ease;
    opacity: 1;
    }

    .actionarea {
    background-color: transparent !important; 
    color: var(--mud-palette-appbar-text);
    }

    .actionarea:focus {
    opacity: 1 !important;
    }

    span.emoji {
    font-size: 12px;
    padding: 1px 1px;
    align-self: center;
    }
    .myemoji {
    all: unset;
    font-size: 15px;
    display: inline-block;
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", "EmojiOne Color", sans-serif !important;
    line-height: 1;
    }

</style>

@code {



    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeCascading { get; set; }
    [Parameter]
    [EditorRequired]
    public bool IsMine{ get; set; }
    [Parameter]
    public ChatMessageDto message { get; set; } = null!;
    [Parameter]
    [EditorRequired]
    public UserDto CurrentUser { get; set; } = null!;
    [Parameter]
    [EditorRequired]
    public PrivateConversationDto Conversation { get; set; } = null!;
    [Parameter]
    public EventCallback<EditedMessageDto> EditMessageEvent{ get; set; }
    [Parameter]
    public EventCallback<ChatMessageDto> ReplyMessageEvent { get; set; }
    [Parameter]
    public EventCallback<MessageReaction> MessageReactionEvent { get; set; }
    [Parameter]
    public EventCallback<Guid> DeletedMessageevent { get; set; }
    [Parameter]
    public string? ParentMessage { get; set; } = null;
    private bool showContextMenu = false;
    private Guid? showContextMenuForMessageId = null;
    private int contextMenuX;
    private int contextMenuY;
    public string? myAvatar { get; set; }
    [Parameter]
    public string? OtherAvatar { get; set; }
    public string? myName { get; set; }
    public string? OtherName { get; set; }

    public string? GetAvatar() {

        if (CurrentUser.Id == message.UserId)
            return myAvatar;
        return OtherAvatar;
    }
    public string replyColor() { return message.IsMine ? $"background-color: {ThemeCascading.MyColorReply}" : $"background-color: {ThemeCascading.OtherColorReply}"; }
    public string ClockColor () => $"color: {ThemeCascading.ClockColor};";
    public string Style() { return message.IsMine ? $"background-color: {ThemeCascading.myColorChat}" : $"background-color: {ThemeCascading.OtherColorChat}"; }
    protected override async Task OnInitializedAsync()
    {
        var me = Conversation.users.Where(c => c.Id == CurrentUser.Id).FirstOrDefault();
        var other = Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault();
        myAvatar = CurrentUser.avatar; 

        myName = me?.Name;
        OtherName = other?.Name;
    }
    public async Task copyMessage(ChatMessageDto message)
    {
        await JS.InvokeVoidAsync("copyToClipboard", message.Content);
    }
    private async Task OnRightClick(MouseEventArgs e, ChatMessageDto message)
    {
        if (IsMine)
        {
            showContextMenuForMessageId = message.Id;
            contextMenuX = (int)e.ClientX;
            contextMenuY = (int)e.ClientY;
            showContextMenu = true;
            StateHasChanged();
        }
    }
    private async Task EditMessage(Guid MessageId,string Message)
    {
        var message = new EditedMessageDto(MessageId, Message);
        message.OtherId = Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault()!.Id;
        await EditMessageEvent.InvokeAsync(message);
    }
    private async Task DeleteMessagePopUp(Guid MessageId){
        var parameters = new DialogParameters<DialogTemplate>
    {
        { x => x.ContentText, "آیا از حذف این پیام اطمینان دارید؟" },
        { x => x.ButtonText, "بله" },
        { x => x.Color, Color.Error }
    };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, };

        var dialog = await DialogService.ShowAsync<DialogTemplate>("حذف پیام", parameters, options);
        var res = await dialog.Result;
        if (!res.Canceled)
        {
            await PerformDeleteMessageAsync(MessageId);
        }
    }
    public async Task PerformDeleteMessageAsync(Guid MessageId){
        var otherId= Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault()!.Id;
        var result=  await _messageservice.DeleteMessageAsync(MessageId, otherId);
        if(result.Item1){
            await  DeletedMessageevent.InvokeAsync(MessageId);
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"حذف پیام با موفقیت انجام شد ", Severity.Success, x =>
            {

            });
        }
        else{
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"حذف پیام با خطا مواجه شد ", Severity.Error, x =>
            {

            });
        }
    }

}
@code{
    private bool Hovering => _paperHovering || _bubbleHovering;
    private bool _bubbleHovering;
    private bool _paperHovering;
    private ChatMessageDto? _hoverMessage;
    private void HoverStart(MouseEventArgs args, ChatMessageDto message)
    {
        _bubbleHovering = true;
        _hoverMessage = message;
    }

    private void HoverStop(string typeOfStop)
    {
        try
        {
            switch (typeOfStop)
            {
                case "paper":
                    _paperHovering = false;
                    break;
                case "bubble":
                    _bubbleHovering = false;
                    break;
                case "scroll":
                    _paperHovering = false;
                    _bubbleHovering = false;
                    StateHasChanged();
                    break;
                default:
                    break;
            }
        }
        catch { }
    }
}
@code{

    public async Task ReplyMessage(ChatMessageDto message){
        await  ReplyMessageEvent.InvokeAsync(message);
    }
    private async Task ScrollToMessage(Guid parentId)
    {
        await JS.InvokeVoidAsync("scrollToElement", parentId);
    }
    private async Task MessageAction(string actionType,ChatMessageDto messsage)
    {
        if(!string.IsNullOrEmpty(message.Reaction))
        {

            message.Reaction = null;
        }else{


            switch (actionType)
            {
                case "liked":

                    message.Reaction="Liked";
                    break;

                case "cried":
                    message.Reaction = "cried";
                    break;

                case "Flower":
                    message.Reaction = "Flower";
                    break;

                case "Loved":
                    message.Reaction = "Loved";
                    break;

                case "Lough":
                    message.Reaction = "Lough";
                    break;

                case "Merci":
                    message.Reaction = "Merci";
                    break;

                default:
                    break;
            }
            var Other=   Conversation.users.Where(c => c.Id != CurrentUser.Id).FirstOrDefault()!.Id;
            var reactionInstance = new MessageReaction(message.Id, message.Reaction, Other);
            var result= await _messageservice.newReactionOnMessage(reactionInstance.Reaction,reactionInstance.MessageId);
            if(!result.issuccess)
            {
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                snackbar.Add(result.Message, Severity.Error, x =>
                {

                });
                return;
            }
          await MessageReactionEvent.InvokeAsync(reactionInstance);
            StateHasChanged();
        }
    }
}
