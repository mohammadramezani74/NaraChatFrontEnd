@using NaraChat.Contract.Utilities.FilesExtensions
@using System.Text.Json
@using static NaraChatFrontEnd.Pages.ChatPages.Components.DialogComponents.UploadDialogComponent
@using NaraChat.Application.Services.ChatServices.Channels;
@inject IJSRuntime js
@inject IConversationService chatService
@inject IChannelService _channelservice
@inject AuthenticationStateProvider stateprovider
@inject ISnackbar snackbar
@inject IMessageService messageService
@inject IDialogService DialogService
@implements IAsyncDisposable 
@attribute [StreamRendering]

@if (SelectedChannel != null)
{
    <MudCard Class="d-flex flex-column h-100 w-100" >

        <MudCardHeader @onclick="()=>gotoDetailForMobile(SelectedChannel)" Class="border-bottom" Style="flex-shrink:0;">
            <div class="d-flex justify-content-between align-items-center w-100">

                <div class="d-flex align-items-center">
                    @if (SelectedChannel != null)
                    {
                        <MudAvatar Size="Size.Medium" Class="ml-2">

                            <MudImage Src="@($"{SiteSettings.ApiUrl}{SelectedChannel.avatar}")" Class="rounded-circle" Style="object-fit:cover;"> </MudImage>

                        </MudAvatar>

                        <MudStack Row="false">
                            <MudText Typo="Typo.h1" Class="mr-3">@(SelectedChannel?.Name ?? string.Empty)</MudText>

                            <MudText Style="font-size:10px; color:gray;" Class="mr-3"><b> تعداد اعضا @channelcount نفر</b></MudText>

                        </MudStack>
                    }
                </div>
            
                <div class="d-flex align-items-center flex-shrink-0" @onclick:stopPropagation="true">

                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   Color="@(_searchOpen ? Color.Primary : Color.Default)"
                                   OnClick="ToggleSearch" />

                    @if (ShowChatActions)
                    {
                        @ChatActionsMenu
                    }  
                    @if (IsMobile)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                    OnClick="BackToUserList" />
                }
                </div>
            </div>
        </MudCardHeader>

        @SearchPanel
        @PinnedBanner

        <MudCardContent Class="flex-grow-1 p-0" Style="overflow-y:auto; width:100%; scrollbar-width: none;" data-scroll-container="true">
            <div id="mainchat"  @ref="_channelContainer" style="@ThemeCascading.backGroundChatStyle">

                <MudStack Spacing="4" Class="w-100 px-2 d-flex flex-column">
                    @if (Loading)
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    }
                    else if(_messages.Count>0){
                        @if (_inJumpMode)
                        {
                            @foreach (var message in _messages)
                            {
                                @ChannelMessageRow(message)
                            }
                        }
                        else
                        {
                            <MudVirtualize Items="_messages" Context="message"   OverscanCount="5" >
                                <ItemContent>
                                    @ChannelMessageRow(message)
                                </ItemContent>
                            </MudVirtualize>
                        }
                    }
                    else{
                        <EmptyMessagesComponnent OtherId="@SelectedChannel"/>
                    }
                </MudStack>
            </div>
        </MudCardContent>
        @if(SelectedChannel.channel.CreatorId==CurrentUser.Id||
          SelectedChannel.channel.admins.Any(x => x.Id == CurrentUser.Id)){
            <MudCardActions Class="border-top pt-2" Style="flex-shrink:0">
                <MudStack Row="false" Class="w-100">

                    @if (ReplyMode)
                    {
                        <MudPaper Class="d-flex align-center px-2 py-1 reply-bar" Elevation="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                            OnClick="()=>ReplyMode = !ReplyMode"
                            Color="Color.Secondary"
                            Class="mr-2" />
                            <MudText Class="text-truncate" >
                                ریپلای به: @SelectedMessageToReply.Content
                            </MudText>
                        </MudPaper>
                    }
                    @if (IsUploading)
                    {
                        @UploadProgressBar
                    }

                    <MudGrid Class="align-center w-100" Spacing="2">

                        <MudItem xs="8">
                            @if (ShowEmojiPicker)
                            {
                                <EmojiComponent OnEmojiSelected="BindEmoji" ShowEmojiPicker="ShowEmojiPicker" OnClosepopover="CloseEmojies"></EmojiComponent>
                            }
                            <MudTextField T="string"
                            @ref="messageInput"
                            @bind-value="NewMessage"
                            Variant="Variant.Outlined"
                            Placeholder="پیام خود را بنویسید..."
                            Clearable="true"
                            AutoGrow
                            Lines="3"
                            Adornment="Adornment.End"
                            AdornmentIcon="@Icons.Material.Filled.InsertEmoticon"
                            OnAdornmentClick="()=>ShowEmojiPicker=!ShowEmojiPicker" />
                        </MudItem>

                        <MudItem xs="2" Class="d-flex justify-content-start">
                            <MudButton  Variant="Variant.Filled"
                            Color="@(EditMode ? Color.Warning : Color.Primary)"
                            EndIcon="@Icons.Custom.Brands.Telegram"
                            IconSize="Size.Small"
                            OnClick="@(()=>SendChannelMessage())"
                            Disabled="@(SelectedChannel==null)">
                                ارسال
                            </MudButton>
                            @if (EditMode)
                            {
                                <MudIconButton Color="Color.Error"
                                Variant="Variant.Filled"
                                Icon="@Icons.Material.Filled.Close"
                                OnClick="()=>EditMode = false" />
                            }
                        </MudItem>

                        <MudMenu Disabled="@(SelectedChannel==null)" Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                            @if (!isRecording)
                            {
                                <MudButton Disabled="@(SelectedChannel==null)" OnClick="RecordVoice">
                                    <MudIcon Color="Color.Tertiary" Icon="@Icons.Material.Filled.Mic" Title="میکروفون"></MudIcon>
                                </MudButton>
                            }
                            else
                            {
                                <MudButton OnClick="StopRecording">
                                    <MudIcon Color="Color.Secondary" Icon="@Icons.Material.Filled.Stop" Title="توقف ضبط صدا"></MudIcon>
                                </MudButton>
                            }
                            <MudButton @onclick="@uploadChannelDialog" Disabled="@(IsUploading==null)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                            </MudButton>

                        </MudMenu>

                    </MudGrid>
                </MudStack>
            </MudCardActions>
        }

    </MudCard>
}
