@* ==========================================================================
   قطعات مشترک
   ========================================================================== *@

@code {

    // ---------------------------------------------------------- نوار آپلود
    // قبلاً سه بار تکرار شده بود. ضمناً @UploadPercent٪ به @(UploadPercent)٪
    // تغییر کرد، چون «٪» فارسی کاراکتر معتبر شناسه نیست و پارسر Razor
    // گاهی سر آن گیج می‌شود.

    private RenderFragment UploadProgressBar =>
    @<MudPaper Class="pa-3 ma-2" Elevation="1">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2">در حال ارسال فایل…</MudText>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body2">@(UploadPercent)٪</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="cancelUpload" />
            </MudStack>
        </MudStack>

        <MudProgressLinear Color="Color.Primary"
                           Value="@UploadPercent"
                           Size="Size.Medium"
                           Class="mt-2" />

        <MudText Typo="Typo.caption" Class="mt-1">@UploadSizeText</MudText>
    </MudPaper>;


    // ------------------------------------------------------ پنل جستجو

    private RenderFragment SearchPanel =>
    @<div>
        @if (_searchOpen)
        {
            <div style="border-bottom: 1px solid var(--mud-palette-lines-default); padding: 8px; flex-shrink: 0;">

                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    <MudTextField T="string"
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchTermChanged"
                                  Immediate="true"
                                  Placeholder="جستجو در پیام‌ها…"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" />

                    @if (_searchResults.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Style="white-space: nowrap;">
                            @(_searchActiveIndex + 1) از @_searchResults.Count@(_searchHasMore ? "+" : "")
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Disabled="@(_searchActiveIndex >= _searchResults.Count - 1)"
                                       OnClick="NextResult" />

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Disabled="@(_searchActiveIndex <= 0)"
                                       OnClick="PreviousResult" />
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="ToggleSearch" />
                </MudStack>

                @if (_searchBusy)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mt-1" />
                }

                @if (_searchResults.Count > 0)
                {
                    <div style="max-height: 260px; overflow-y: auto; margin-top: 8px;">
                        <MudList T="string" Dense="true">
                            @for (var i = 0; i < _searchResults.Count; i++)
                            {
                                var index = i;
                                var hit = _searchResults[i];

                                <MudListItem T="string"
                                             OnClick="@(() => JumpToResult(index))"
                                             Style="@(index == _searchActiveIndex
                                                      ? "background-color: var(--mud-palette-action-default-hover);"
                                                      : "")">
                                    <MudStack Spacing="0">
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption" Color="Color.Primary">
                                                <b>@hit.SenderName</b>
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: gray;">
                                                @hit.SendAt.ToFarsi().ConvertPersianDate() @hit.SendAt.ToString(@"HH\:mm")
                                            </MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.body2">@Snippet(hit)</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>

                        @if (_searchHasMore)
                        {
                            <MudButton FullWidth
                                       Variant="Variant.Text"
                                       Size="Size.Small"
                                       Disabled="@_searchBusy"
                                       OnClick="LoadMoreResults">
                                نتایج بیشتر
                            </MudButton>
                        }
                    </div>
                }
                else if (!_searchBusy && (_searchTerm?.Trim().Length ?? 0) >= 2)
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="color: gray;">
                        نتیجه‌ای یافت نشد.
                    </MudText>
                }
            </div>
        }

        @if (_inJumpMode)
        {
            <MudButton FullWidth
                       Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ArrowDownward"
                       OnClick="BackToLatest">
                بازگشت به آخرین پیام‌ها
            </MudButton>
        }
    </div>;


    // -------------------------------------------------- ردیف پیام‌ها
    // هر ردیف id می‌گیرد تا scrollToElement بتواند پیدایش کند، و اگر هدف
    // پرش باشد هایلایت می‌شود.

    private string RowStyle(ChatMessageDto message) =>
        _highlightedMessageId == message.Id
            ? "background-color: rgba(25,118,210,0.18); border-radius: 8px; transition: background-color .4s;"
            : "transition: background-color .4s;";

    private RenderFragment DateDivider(ChatMessageDto message) =>
    @<div>
        @if (lastDate == null || message.SendAt.Date != lastDate.Value.Date)
        {
            if (message.SendAt.Date <= DateTime.Today.Date)
            {
                <div style="display: flex; align-items: center; gap: 10px; margin: 10px 0;">
                    <div style="flex-grow: 1; height: 1px; background-color: gray;"></div>
                    <MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection">
                        <MudChip Text="pink" Variant="Variant.Text" Color="ThemeCascading.SeenColor">@message.SendAt.ToFarsi().ConvertPersianDate()</MudChip>
                    </MudChipSet>
                    <div style="flex-grow: 1; height: 1px; background-color: gray;"></div>
                </div>
            }
            lastDate = message.SendAt.Date;
        }
    </div>;


    private RenderFragment PrivateMessageRow(ChatMessageDto message) =>
    @<div @key="message.Id" id="@($"msg-{message.Id}")" style="@RowStyle(message)">

        @DateDivider(message)

        @if (message.Type == MessageType.Text || message.Type == MessageType.Location)
        {
        <MessageComponent DeletedMessageevent="DeleteTargetMessage" IsMine="message.IsMine" CurrentUser="CurrentUser" message="message"
                          ReplyMessageEvent="HandleReplyMessage" Conversation="Conversation" EditMessageEvent="OnEditMessageHandler"
                          ParentMessage="@HandelParentMessage(message)"
                          ParentSenderName="@HandelParentSender(message)"
                          OnParentClick="JumpToMessage"
                          CanPin="@CanPin"
                          TogglePinEvent="OnTogglePinRequested"
                          OtherAvatar="@OtherUser.avatar"
                          MessageReactionEvent="SendReactions"
                          JoinChannel="JoinToChannelEvent"></MessageComponent>
        }
        else
        {
            <FileMessageComponent DeletedMessageevent="DeleteTargetMessage" IsMine="message.IsMine" CurrentUser="CurrentUser" message="message"
                                 
            ReplyMessageEvent="HandleReplyMessage" Conversation="Conversation" EditMessageEvent="OnEditMessageHandler"
                                  ParentMessage="@HandelParentMessage(message)"></FileMessageComponent>
        }
    </div>;


    private RenderFragment GroupMessageRow(ChatMessageDto message) =>
    @<div @key="message.Id" id="@($"msg-{message.Id}")" style="@RowStyle(message)">

        @DateDivider(message)

        @if (message.Type == MessageType.Text || message.Type == MessageType.Location)
        {
            <GroupMessageComponent DeletedMessageevent="DeleteTargetMessage" IsMine="message.IsMine" CurrentUser="CurrentUser" message="message"
                                   ReplyMessageEvent="HandleReplyMessage" Conversation="Conversation" EditMessageEvent="OnEditMessageHandler"
                               CanPin="@CanPin"
                               TogglePinEvent="OnTogglePinRequested"
                               ParentMessage="@HandelParentMessage(message)"
                               ParentSenderName="@HandelParentSender(message)"
                                   Adminlist="@SelectedGroup.channel.admins"
                                   CreateorId="@SelectedGroup.channel.CreatorId"
                                   GroupId="@SelectedGroup.Id"
                                   MessageReactionEvent="SendReactions"
                                   JoinChannel="JoinToChannelEvent"
                                   ></GroupMessageComponent>
        }
        else
        {
            <FileGroupMessageComponent DeletedMessageevent="DeleteTargetMessage" IsMine="message.IsMine" CurrentUser="CurrentUser" message="message"
                                       ReplyMessageEvent="HandleReplyMessage" Conversation="Conversation" EditMessageEvent="OnEditMessageHandler"
                                   CanPin="@CanPin"
                                   TogglePinEvent="OnTogglePinRequested"
                                       ParentMessage="@HandelParentMessage(message)"
                                       Adminlist="@SelectedGroup.channel.admins"
                                       CreateorId="@SelectedGroup.channel.CreatorId"
                                       GroupId="@SelectedGroup.Id"></FileGroupMessageComponent>
        }
    </div>;
    private bool ShowChatActions =>
           SelectedChannel is not null || SelectedGroup is not null || Conversation is not null;
    private RenderFragment ChatActionsMenu =>
    @<MudMenu Icon="@Icons.Material.Filled.MoreVert"
                  AnchorOrigin="Origin.BottomRight"
                  TransformOrigin="Origin.TopRight"
                  AriaLabel="مدیریت گفتگو">

        <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep"
                     OnClick="ClearHistoryDialog">
            پاک کردن تاریخچه
        </MudMenuItem>

        @if (CanManageCurrentChat)
    {
        <MudDivider Class="my-1" />

        <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever"
                     IconColor="Color.Error"
                     OnClick="DeleteChatDialog">
            <MudText Color="Color.Error">
                @(SelectedChannel is not null ? "حذف کانال" : "حذف گروه")
            </MudText>
        </MudMenuItem>
    }
    </MudMenu>;
    private RenderFragment ChannelMessageRow(ChatMessageDto message) =>
    @<div @key="message.Id" id="@($"msg-{message.Id}")" style="@RowStyle(message)">

        @DateDivider(message)

        @if (message.Type == MessageType.Text || message.Type == MessageType.Location)
        {
            <ChannelMessageComponent DeletedMessageevent="DeleteTargetMessage" CurrentUser="CurrentUser" message="message"
                                     ReplyMessageEvent="HandleReplyMessage" EditMessageEvent="OnEditMessageHandler"
                                 CanPin="@CanPin"
                                 TogglePinEvent="OnTogglePinRequested"
                                 ParentMessage="@HandelParentMessage(message)"
                                 ParentSenderName="@HandelParentSender(message)"
                                     SelectedChannel="SelectedChannel"></ChannelMessageComponent>
        }
        else
        {
            <ChannelFileMessageComponent DeletedMessageevent="DeleteTargetMessage" IsMine="message.IsMine" CurrentUser="CurrentUser" message="message"
                                         ReplyMessageEvent="HandleReplyMessage" Conversation="Conversation" EditMessageEvent="OnEditMessageHandler"
                                         ParentMessage="@HandelParentMessage(message)"></ChannelFileMessageComponent>
        }
    </div>;
    private RenderFragment PinnedBanner =>
    @<div>
        @if (ActivePin is not null)
    {
        <div style="display: flex; align-items: center; gap: 8px; padding: 6px 12px;
                        border-bottom: 1px solid var(--mud-palette-lines-default);
                        cursor: pointer; flex-shrink: 0;"
             @onclick="GoToPinned">

            <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Primary" />

            <div style="flex-grow: 1; min-width: 0;">
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    <b>پیام سنجاق‌شده</b>
                    @if (_pinned.Count > 1)
                {
                    <span> (@(_pinnedIndex + 1) از @_pinned.Count)</span>
                }
                </MudText>
                <MudText Typo="Typo.body2" Class="text-truncate">@PinPreview(ActivePin)</MudText>
            </div>

            @if (CanPin)
        {
            <span @onclick:stopPropagation="true">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="@(() => TogglePinMessage(ActivePin.Id, false))" />
            </span>
        }
        </div>
    }
    </div>;
}
