                                       OnClick="()=>EditMode = false" />
                    }
                </MudItem>

                <MudMenu Disabled="@(OtherUser==null)" Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                    <MudButton Disabled="@(OtherUser==null || isRecording)" OnClick="RecordVoice">
