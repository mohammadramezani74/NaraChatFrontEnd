@code {
    // تایمر
    private  System.Timers.Timer timer;
    private int remainingTime = 120; // 2 دقیقه به ثانیه
    private bool isResendDisabled = true;

    protected override void OnInitialized()
    {
        StartTimer();
    }

    private void StartTimer()
    {
        timer = new  System.Timers.Timer(1000); // هر ثانیه
        timer.Elapsed += async (sender, e) => await UpdateTimer();
        timer.AutoReset = true;
        timer.Enabled = true;
        isResendDisabled = true;
    }

    private async Task UpdateTimer()
    {
        remainingTime--;
        
        if (remainingTime <= 0)
        {
            timer.Stop();
            isResendDisabled = false;
            remainingTime = 120; // ریست تایمر
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResendCode()
    {
        // کد ارسال مجدد
        await _service.SendVerifyCode( Model.PhoneNumber);
        StartTimer();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

}
@code{

    [CascadingParameter(Name = "Theme")]
    public ThemeChanging ThemeChanging { get; set; }
    public LoginDTo LoginDTo { get; set; }
    public string VerifyCode { get; set; } = string.Empty;
    public bool IsLoadVrifyCodeComponent { get; set; } = false;

        private LoginModel Model = new();
    public bool DisableKey { get; set; }
        [Parameter]
    public string token { get; set; }


    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ButtonTestclick()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;

        }



    }
    protected async override Task OnInitializedAsync()
    {
        if (await ((CustomAuthenticationStateProvider)auth).IsAuthenticated())
        {
            var user = await ((CustomAuthenticationStateProvider)auth).GetUserInfoAsync();
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"{user.Name} عزیز خوش امدی ", Severity.Success, x =>
            {

            });
            navigation.NavigateTo("/chat");
            StateHasChanged();
        }
    }
    public async Task LoginAsync()
    {
        if(string.IsNullOrEmpty(Model.PhoneNumber)){
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"شماره همراه وارد شده نباید خالی باشد", Severity.Error, x =>
            {

            });

            Model.PhoneNumber = string.Empty;
        }
        var result = await _service.LoginOrRegisterAsync( Model.PhoneNumber,VerifyCode);
        if (result)
        {
            navigation.NavigateTo("/chat");
            IsLoadVrifyCodeComponent = false;
        }
        else
        {
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"شماره همراه مورد نظر یافت نشد لطفا با پشتیبانی تماس حاصل فرمایید", Severity.Error, x =>
            {

            });

             Model.PhoneNumber = string.Empty;
            IsLoadVrifyCodeComponent = false;
        }
    }

    public async Task SendVerifyCode(){
        if(string.IsNullOrEmpty( Model.PhoneNumber)){
            snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add($"شماره همراه وارد شده نباید خالی باشد", Severity.Error, x =>
            {

            });

             Model.PhoneNumber = string.Empty;
        }
        else{
            var result= await _service.SendVerifyCode( Model.PhoneNumber);
            if(result.result){
                snackbar.Clear();
                snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
                snackbar.Add(result.Message, Severity.Success, x =>
                {

                });
                IsLoadVrifyCodeComponent = true;
            }
           else{
          snackbar.Clear();
            snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            snackbar.Add(result.Message, Severity.Error, x =>
            {

            });
           }
        }
    }
public class LoginModel
{
    [Required(ErrorMessage = "شماره همراه نباید خالی باشد")]

    public string PhoneNumber { get; set; } = string.Empty;
}
}
